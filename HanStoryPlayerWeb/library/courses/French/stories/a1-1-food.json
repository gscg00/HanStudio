{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "french-a11-food-01",
      "title": "Hambre de medianoche",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, j’ai faim.",
          "translation": "Léa, tengo hambre."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Moi aussi. Et j’ai soif.",
          "translation": "Yo también. Y tengo sed."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Il y a quelque chose dans la cuisine ?",
          "translation": "¿Hay algo en la cocina?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Il y a du pain... et de l’eau.",
          "translation": "Hay pan… y agua."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Seulement du pain et de l’eau ?",
          "translation": "¿Solo pan y agua?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Et du fromage ! Une tartine ?",
          "translation": "¡Y queso! ¿Un pan con queso?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Parfait !",
          "translation": "¡Perfecto!"
        }
      ],
      "notes": [
        {
          "ko": "j’ai faim / j’ai soif",
          "es": "Igual que en español: el hambre y la sed se «tienen» (avoir)."
        },
        {
          "ko": "Moi aussi",
          "es": "«Yo también». moi es la forma tónica de je."
        },
        {
          "ko": "du pain / de l’eau",
          "es": "Partitivo: du (masc.), de la (fem.), de l' (delante de vocal) = «algo de». En español no se traduce."
        },
        {
          "ko": "tartine",
          "es": "Rebanada de pan con algo encima (mantequilla, mermelada, queso)."
        }
      ],
      "newItems": [
        "eau",
        "pain",
        "J’ai faim.",
        "J’ai soif."
      ]
    },
    {
      "lessonId": "french-a11-food-02",
      "title": "Ana invita",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Vous avez choisi ?",
          "translation": "¿Ya eligieron?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oui. Je veux ceci : le poulet avec du riz.",
          "translation": "Sí. Quiero esto: el pollo con arroz."
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Très bien. Et comme boisson ?",
          "translation": "Muy bien. ¿Y de tomar?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "De l’eau, s’il vous plaît.",
          "translation": "Agua, por favor."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Et un café, s’il vous plaît.",
          "translation": "Y un café, por favor."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Monsieur ! L’addition, s’il vous plaît.",
          "translation": "¡Señor! La cuenta, por favor."
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Tout de suite.",
          "translation": "Enseguida."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, c’est mon tour. Je t’invite !",
          "translation": "Léa, me toca a mí. ¡Yo invito!"
        }
      ],
      "notes": [
        {
          "ko": "Je veux ceci",
          "es": "Correcto pero muy directo. Más cortés: «Je voudrais ceci» o «Je vais prendre ceci»."
        },
        {
          "ko": "L’addition",
          "es": "l'addition = la cuenta en un restaurante. En un hotel se dice la note."
        },
        {
          "ko": "un café",
          "es": "En Francia, un café es un espresso. Para uno con leche: un café crème."
        },
        {
          "ko": "Je t’invite",
          "es": "«Yo invito» = yo pago."
        }
      ],
      "newItems": [
        "riz",
        "café",
        "Je veux ceci.",
        "L’addition, s’il vous plaît."
      ]
    },
    {
      "lessonId": "french-a11-food-03",
      "title": "Desayuno en casa de Léa",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Mme Martin",
          "speakerEs": "Mamá de Léa",
          "gender": "f",
          "text": "Thé ou café, Ana ?",
          "translation": "¿Té o café, Ana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Du thé, s’il vous plaît. Je bois du thé le matin maintenant !",
          "translation": "Té, por favor. ¡Ahora tomo té por la mañana!"
        },
        {
          "speaker": "Mme Martin",
          "speakerEs": "Mamá de Léa",
          "gender": "f",
          "text": "Très bien ! Avec une pomme ?",
          "translation": "¡Muy bien! ¿Con una manzana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oui, merci.",
          "translation": "Sí, gracias."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Maman, il reste du riz d’hier ?",
          "translation": "Mamá, ¿queda arroz de ayer?"
        },
        {
          "speaker": "Mme Martin",
          "speakerEs": "Mamá de Léa",
          "gender": "f",
          "text": "Du riz ? Au petit-déjeuner ?",
          "translation": "¿Arroz? ¿En el desayuno?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Oui ! Je voudrais du riz.",
          "translation": "¡Sí! Quiero arroz."
        },
        {
          "speaker": "Mme Martin",
          "speakerEs": "Mamá de Léa",
          "gender": "f",
          "text": "Ah, Léa...",
          "translation": "Ay, Léa…"
        }
      ],
      "notes": [
        {
          "ko": "le matin",
          "es": "Sin preposición, con artículo = por la mañana (cada mañana)."
        },
        {
          "ko": "Je voudrais du riz",
          "es": "du = partitivo: «algo de arroz». Con voudrais, la petición es amable."
        },
        {
          "ko": "il reste",
          "es": "«Queda, sobra». il reste du riz = queda arroz."
        },
        {
          "ko": "petit-déjeuner",
          "es": "El desayuno francés es dulce y ligero: pan, mantequilla, mermelada, café."
        }
      ],
      "newItems": [
        "thé",
        "pomme",
        "Je bois du thé le matin.",
        "Je voudrais du riz."
      ]
    },
    {
      "lessonId": "french-a11-food-04",
      "title": "Tacos sin carne",
      "scene": "market",
      "lines": [
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Légumes frais ! Goûtez une pomme !",
          "translation": "¡Verduras frescas! ¡Pruebe una manzana!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mmm... Cette pomme est délicieuse.",
          "translation": "Mmm… Esta manzana está deliciosa."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ana, steak-frites ce soir ?",
          "translation": "Ana, ¿bistec con papas esta noche?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Désolée, Léa, je ne mange pas de viande.",
          "translation": "Lo siento, Léa, no como carne."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ah bon ? Alors, des légumes !",
          "translation": "¿Ah, sí? ¡Entonces, verduras!"
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Carottes, poivrons, tomates...",
          "translation": "Zanahorias, pimientos, jitomates…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Des poivrons et des tomates, s’il vous plaît.",
          "translation": "Pimientos y jitomates, por favor."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ce soir, tacos aux légumes !",
          "translation": "¡Esta noche, tacos de verduras!"
        }
      ],
      "notes": [
        {
          "ko": "pas de viande",
          "es": "Tras una negación, du / de la / des se convierten en de: je mange de la viande → je ne mange pas de viande."
        },
        {
          "ko": "délicieuse",
          "es": "pomme es femenino, así que délicieux → délicieuse."
        },
        {
          "ko": "Désolée",
          "es": "Ana es mujer: désolée (con e). Un hombre diría désolé."
        },
        {
          "ko": "Ah bon ?",
          "es": "«¿Ah, sí? ¿En serio?». Muestra sorpresa."
        }
      ],
      "newItems": [
        "viande",
        "légumes",
        "Cette pomme est délicieuse.",
        "Je ne mange pas de viande."
      ]
    }
  ]
}
