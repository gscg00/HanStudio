{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "french-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "M. Bernard",
          "speakerEs": "Profesor Bernard",
          "gender": "m",
          "text": "Bonjour à tous !",
          "translation": "¡Buenos días a todos!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Bonjour, monsieur !",
          "translation": "¡Buenos días, profesor!"
        },
        {
          "speaker": "M. Bernard",
          "speakerEs": "Profesor Bernard",
          "gender": "m",
          "text": "Bonjour ! Vous êtes nouvelle ?",
          "translation": "¡Buenos días! ¿Es usted nueva?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oui. Je m’appelle Ana.",
          "translation": "Sí. Me llamo Ana."
        },
        {
          "speaker": "M. Bernard",
          "speakerEs": "Profesor Bernard",
          "gender": "m",
          "text": "Enchanté, Ana. Je suis monsieur Bernard.",
          "translation": "Mucho gusto, Ana. Soy el profesor Bernard."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Enchantée, monsieur.",
          "translation": "Mucho gusto."
        },
        {
          "speaker": "M. Bernard",
          "speakerEs": "Profesor Bernard",
          "gender": "m",
          "text": "Bienvenue dans la classe !",
          "translation": "¡Bienvenida a la clase!"
        }
      ],
      "notes": [
        {
          "ko": "Bonjour, monsieur",
          "es": "Saludar con monsieur o madame, sin el apellido, es la forma cortés en Francia."
        },
        {
          "ko": "Enchanté / Enchantée",
          "es": "Concuerda con quien habla: un hombre dice enchanté; una mujer, enchantée. Suenan igual."
        },
        {
          "ko": "Vous êtes nouvelle ?",
          "es": "El profesor habla de vous a una alumna adulta. nouveau → nouvelle en femenino."
        },
        {
          "ko": "Je m’appelle",
          "es": "Literalmente «me llamo», igual que en español: verbo s'appeler."
        }
      ],
      "newItems": [
        "bonjour",
        "Je m’appelle Ana.",
        "Enchanté."
      ]
    },
    {
      "lessonId": "french-a11-identity-02",
      "title": "Cena con Léa",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Bonsoir ! Une table pour deux ?",
          "translation": "¡Buenas noches! ¿Mesa para dos?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oui, s’il vous plaît.",
          "translation": "Sí, por favor."
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Voici la carte.",
          "translation": "Aquí tienen la carta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Merci.",
          "translation": "Gracias."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Merci, au revoir !",
          "translation": "¡Gracias, adiós!"
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Au revoir, mesdames. Bonne soirée !",
          "translation": "Adiós, señoritas. ¡Que pasen buena noche!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, « bonsoir », c’est « buenas noches » ?",
          "translation": "Léa, «bonsoir» es «buenas noches», ¿no?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Oui, pour dire bonjour le soir. Pour aller dormir, on dit « bonne nuit ».",
          "translation": "Sí, para saludar en la noche. Para ir a dormir se dice «bonne nuit»."
        }
      ],
      "notes": [
        {
          "ko": "Bonsoir",
          "es": "Saludo a partir de la tarde-noche. Para despedirse se dice bonne soirée, y antes de dormir, bonne nuit."
        },
        {
          "ko": "la carte",
          "es": "la carte = la carta del restaurante. le menu suele ser un menú fijo (entrada, plato, postre)."
        },
        {
          "ko": "s’il vous plaît",
          "es": "Con vous: s'il vous plaît. Entre amigos: s'il te plaît."
        },
        {
          "ko": "mesdames",
          "es": "Plural de madame. Fórmula cortés de los meseros."
        }
      ],
      "newItems": [
        "bonsoir",
        "au revoir",
        "Merci.",
        "S’il vous plaît."
      ]
    },
    {
      "lessonId": "french-a11-identity-03",
      "title": "Inscripción en la escuela",
      "scene": "office",
      "lines": [
        {
          "speaker": "La secrétaire",
          "speakerEs": "Secretaria",
          "gender": "f",
          "text": "Bonjour. Comment vous appelez-vous ?",
          "translation": "Buenos días. ¿Cómo se llama?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ana López.",
          "translation": "Ana López."
        },
        {
          "speaker": "La secrétaire",
          "speakerEs": "Secretaria",
          "gender": "f",
          "text": "Pouvez-vous épeler votre nom, s’il vous plaît ?",
          "translation": "¿Puede deletrear su apellido, por favor?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "L-O-P-E-Z.",
          "translation": "L-O-P-E-Z."
        },
        {
          "speaker": "La secrétaire",
          "speakerEs": "Secretaria",
          "gender": "f",
          "text": "Merci. Et votre pays ?",
          "translation": "Gracias. ¿Y su país?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Je viens du Mexique.",
          "translation": "Soy de México."
        },
        {
          "speaker": "La secrétaire",
          "speakerEs": "Secretaria",
          "gender": "f",
          "text": "Le Mexique ! Bienvenue à l’école !",
          "translation": "¡México! ¡Bienvenida a la escuela!"
        }
      ],
      "notes": [
        {
          "ko": "votre nom",
          "es": "En formularios, nom es el apellido y prénom, el nombre de pila. ¡Trampa clásica!"
        },
        {
          "ko": "épeler",
          "es": "épeler = deletrear. Repasa el alfabeto francés: la e se dice «ə», la i «i», la u «ü»."
        },
        {
          "ko": "pays",
          "es": "Se pronuncia «pe-í». Es igual en singular y plural."
        },
        {
          "ko": "Je viens du Mexique",
          "es": "venir de = ser de / venir de. du = de + le (le Mexique)."
        }
      ],
      "newItems": [
        "nom",
        "pays",
        "Comment vous appelez-vous ?",
        "Je viens du Mexique."
      ]
    },
    {
      "lessonId": "french-a11-identity-04",
      "title": "Una fiesta con mucho ruido",
      "scene": "party",
      "lines": [
        {
          "speaker": "Jules",
          "speakerEs": "Jules",
          "gender": "m",
          "text": "Salut ! Tu es l’amie de Léa ?",
          "translation": "¡Hola! ¿Tú eres la amiga de Léa?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oui, je suis Ana. Je parle un peu français.",
          "translation": "Sí, soy Ana. Hablo un poco de francés."
        },
        {
          "speaker": "Jules",
          "speakerEs": "Jules",
          "gender": "m",
          "text": "Tu parles très bien ! Tu parles combien de langues ?",
          "translation": "¡Hablas muy bien! ¿Cuántos idiomas hablas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Pardon, je ne comprends pas.",
          "translation": "Perdón, no entiendo."
        },
        {
          "speaker": "Jules",
          "speakerEs": "Jules",
          "gender": "m",
          "text": "Les langues : l’espagnol, le français...",
          "translation": "Los idiomas: el español, el francés…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah ! Deux langues : l’espagnol et un peu de français.",
          "translation": "¡Ah! Dos idiomas: español y un poco de francés."
        },
        {
          "speaker": "Jules",
          "speakerEs": "Jules",
          "gender": "m",
          "text": "Moi, je parle une seule langue. Léa dit que tu es une personne géniale.",
          "translation": "Yo solo hablo un idioma. Léa dice que eres una persona genial."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ha ha ! Léa aussi est une personne géniale.",
          "translation": "¡Ja, ja! Léa también es una persona genial."
        }
      ],
      "notes": [
        {
          "ko": "Je parle un peu français",
          "es": "Con parler, el idioma va sin artículo: parler français. Pero un peu de + idioma cuando no hay verbo: un peu de français."
        },
        {
          "ko": "langue",
          "es": "langue = idioma y también lengua (el órgano). Es femenino: une langue."
        },
        {
          "ko": "Salut !",
          "es": "Saludo informal entre jóvenes y amigos. En una fiesta se tutea desde el principio."
        },
        {
          "ko": "une personne géniale",
          "es": "personne es femenino, así que el adjetivo también: géniale."
        }
      ],
      "newItems": [
        "langue",
        "personne",
        "Je parle un peu français.",
        "Je ne comprends pas."
      ]
    }
  ]
}
