{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "french-survival-01",
      "title": "Llegada a París",
      "scene": "airport",
      "lines": [
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ana ! Bonjour !",
          "translation": "¡Ana! ¡Hola!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Bonjour, Léa !",
          "translation": "¡Hola, Léa!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, où sont les toilettes ?",
          "translation": "Léa, ¿dónde está el baño?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Là-bas, à côté du café.",
          "translation": "Allá, junto a la cafetería."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Bonjour ! La bouteille d'eau, c'est combien ?",
          "translation": "¡Buenos días! La botella de agua, ¿cuánto cuesta?"
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Deux euros cinquante.",
          "translation": "Dos euros cincuenta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Pardon, je ne comprends pas. Répétez, s'il vous plaît.",
          "translation": "Perdón, no entiendo. Repita, por favor."
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Deux euros cinquante, madame.",
          "translation": "Dos euros cincuenta, señorita."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah ! Merci !",
          "translation": "¡Ah! ¡Gracias!"
        }
      ],
      "notes": [
        {
          "ko": "Bonjour",
          "es": "En Francia se dice bonjour al entrar en cualquier tienda o antes de pedir algo. Omitirlo se considera muy descortés."
        },
        {
          "ko": "les toilettes",
          "es": "Siempre en plural: les toilettes. La s final no suena: «tual-ét»."
        },
        {
          "ko": "je ne comprends pas",
          "es": "La negación rodea al verbo: ne + verbo + pas. En la conversación el ne a menudo desaparece."
        },
        {
          "ko": "c'est combien ?",
          "es": "Forma coloquial y muy frecuente de preguntar el precio."
        }
      ],
      "newItems": [
        "Bonjour !",
        "Je ne comprends pas.",
        "Répétez, s'il vous plaît.",
        "Où sont les toilettes ?",
        "C'est combien ?"
      ]
    },
    {
      "lessonId": "french-survival-02",
      "title": "Ayuda en la terraza",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Pardon, madame... Pouvez-vous m'aider ?",
          "translation": "Disculpe, señora… ¿Puede ayudarme?"
        },
        {
          "speaker": "Monique",
          "speakerEs": "Monique",
          "gender": "f",
          "text": "Oui, bien sûr !",
          "translation": "¡Sí, claro!"
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Bonjour, qu'est-ce que je vous sers ?",
          "translation": "Buenos días, ¿qué le sirvo?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Euh... Parlez plus lentement, s'il vous plaît.",
          "translation": "Eh… Hable más despacio, por favor."
        },
        {
          "speaker": "Le serveur",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Qu'est-ce que... je vous sers ?",
          "translation": "¿Qué… le sirvo?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah ! Je voudrais de l'eau.",
          "translation": "¡Ah! Quisiera agua."
        },
        {
          "speaker": "Monique",
          "speakerEs": "Monique",
          "gender": "f",
          "text": "Bravo ! Comment vous appelez-vous ?",
          "translation": "¡Bravo! ¿Cómo se llama?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Je m'appelle Ana. Et vous ?",
          "translation": "Me llamo Ana. ¿Y usted?"
        },
        {
          "speaker": "Monique",
          "speakerEs": "Monique",
          "gender": "f",
          "text": "Moi, c'est Monique. Enchantée !",
          "translation": "Yo soy Monique. ¡Mucho gusto!"
        }
      ],
      "notes": [
        {
          "ko": "Pouvez-vous m'aider ?",
          "es": "Pregunta formal con inversión (verbo-sujeto). En la calle también se oye «Vous pouvez m'aider ?»."
        },
        {
          "ko": "Je voudrais de l'eau",
          "es": "je voudrais = quisiera, la forma cortés de pedir. de l' = «un poco de» (partitivo) delante de vocal."
        },
        {
          "ko": "Comment vous appelez-vous ?",
          "es": "Literalmente «¿Cómo se llama usted?». Con vous: forma de respeto con desconocidos."
        },
        {
          "ko": "Moi, c'est Monique",
          "es": "Forma muy natural de presentarse: «Yo soy Monique»."
        }
      ],
      "newItems": [
        "Parlez plus lentement.",
        "Pouvez-vous m'aider ?",
        "Je voudrais de l'eau.",
        "Je m'appelle Anna.",
        "Comment vous appelez-vous ?"
      ]
    },
    {
      "lessonId": "french-survival-03",
      "title": "La contraseña del wifi",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ana, tu viens d'où exactement ?",
          "translation": "Ana, ¿de dónde eres exactamente?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Je viens du Mexique. De Guadalajara.",
          "translation": "Soy de México. De Guadalajara."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Super ! Bienvenue à Paris !",
          "translation": "¡Genial! ¡Bienvenida a París!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Merci ! Léa, c'est quoi, le code wifi ?",
          "translation": "¡Gracias! Léa, ¿cuál es la contraseña del wifi?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "C'est « cafe », puis zéro, un, deux, trois.",
          "translation": "Es «cafe» y luego cero, uno, dos, tres."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Zéro, un, deux... trois ?",
          "translation": "Cero, uno, dos… ¿tres?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Oui, c'est ça !",
          "translation": "¡Sí, eso es!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Super, ça marche !",
          "translation": "¡Genial, ya funciona!"
        }
      ],
      "notes": [
        {
          "ko": "du Mexique",
          "es": "Con países masculinos de + le = du: je viens du Mexique. Con femeninos: de France."
        },
        {
          "ko": "tu viens d'où",
          "es": "Forma coloquial de «D'où viens-tu ?». Entre amigas, tu."
        },
        {
          "ko": "wifi",
          "es": "Los franceses dicen «uí-fi»."
        },
        {
          "ko": "ça marche",
          "es": "marcher = caminar, pero también «funcionar». ¡Ça marche! también significa «¡Va!»."
        }
      ],
      "newItems": [
        "Je viens du Mexique.",
        "zéro",
        "un",
        "deux",
        "trois"
      ]
    },
    {
      "lessonId": "french-survival-04",
      "title": "Naranjas en el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Bonjour ! C'est combien ?",
          "translation": "¡Buenos días! ¿Cuánto cuesta?"
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Cinq euros, madame.",
          "translation": "Cinco euros, señorita."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Pardon... quatre ?",
          "translation": "Perdón… ¿cuatro?"
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Non, cinq. Quatre, cinq. Cinq euros.",
          "translation": "No, cinco. Cuatro, cinco. Cinco euros."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah, cinq ! Pour combien d'oranges ?",
          "translation": "¡Ah, cinco! ¿Por cuántas naranjas?"
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Huit oranges. Six, sept, huit !",
          "translation": "Ocho naranjas. ¡Seis, siete, ocho!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Très bien. Voilà.",
          "translation": "Muy bien. Aquí tiene."
        },
        {
          "speaker": "Le vendeur",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Merci, bonne journée !",
          "translation": "¡Gracias, que tenga buen día!"
        }
      ],
      "notes": [
        {
          "ko": "sept",
          "es": "La p no se pronuncia: «set»."
        },
        {
          "ko": "Six, sept, huit",
          "es": "six y huit pierden la consonante final delante de consonante: «si livres», «ui jours»; contando, suenan «sis», «uit»."
        },
        {
          "ko": "combien d'oranges",
          "es": "combien de + sustantivo = cuántos/cuántas. de se vuelve d' delante de vocal."
        },
        {
          "ko": "bonne journée",
          "es": "Despedida cortés típica de los comercios: «que tenga buen día»."
        }
      ],
      "newItems": [
        "quatre",
        "cinq",
        "six",
        "sept",
        "huit"
      ]
    },
    {
      "lessonId": "french-survival-05",
      "title": "¿Trece o tres?",
      "scene": "station",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, le billet, c'est combien ?",
          "translation": "Léa, el boleto, ¿cuánto cuesta?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Treize euros.",
          "translation": "Trece euros."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Treize ? Ou trois ?",
          "translation": "¿Trece? ¿O tres?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Treize ! Dix, onze, douze, treize !",
          "translation": "¡Trece! ¡Diez, once, doce, trece!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "D'accord. Et le train, c'est quelle voie ?",
          "translation": "Bueno. ¿Y el tren, en qué andén está?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Voie neuf. Non, attends... voie dix !",
          "translation": "Andén nueve. No, espera… ¡andén diez!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Dix ? Pas neuf ?",
          "translation": "¿Diez? ¿No el nueve?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Dix. Regarde : neuf, dix, onze... Voilà !",
          "translation": "Diez. Mira: nueve, diez, once… ¡Ahí está!"
        }
      ],
      "notes": [
        {
          "ko": "Treize ? Ou trois ?",
          "es": "treize suena «trez» y trois suena «truá». Escucha bien la vocal."
        },
        {
          "ko": "voie",
          "es": "voie = vía o andén en las estaciones francesas."
        },
        {
          "ko": "dix",
          "es": "Contando suena «dis»; delante de vocal «diz» (dix euros); delante de consonante «di» (dix billets)."
        },
        {
          "ko": "D'accord",
          "es": "«De acuerdo», «va». Imprescindible en la conversación."
        }
      ],
      "newItems": [
        "neuf",
        "dix",
        "onze",
        "douze",
        "treize"
      ]
    },
    {
      "lessonId": "french-survival-06",
      "title": "¿Cuál es nuestro autobús?",
      "scene": "bus",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, c'est notre bus ? Le quatorze ?",
          "translation": "Léa, ¿este es nuestro camión? ¿El catorce?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Non, on prend le quinze.",
          "translation": "No, tomamos el quince."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Quatorze, quinze... et le seize ?",
          "translation": "Catorce, quince… ¿y el dieciséis?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Le seize va à la gare.",
          "translation": "El dieciséis va a la estación."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Il y a combien d'arrêts ?",
          "translation": "¿Cuántas paradas son?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Dix-sept... non, dix-huit arrêts.",
          "translation": "Diecisiete… no, dieciocho paradas."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Dix-huit arrêts ! C'est beaucoup.",
          "translation": "¡Dieciocho paradas! Son muchas."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Regarde, voilà le quinze. Allez, viens !",
          "translation": "Mira, ahí viene el quince. ¡Ándale, vamos!"
        }
      ],
      "notes": [
        {
          "ko": "on prend",
          "es": "on = «nosotros» en la lengua hablada (on prend = tomamos). El verbo va en tercera persona."
        },
        {
          "ko": "seize",
          "es": "¡Ojo! seize (16) suena «sez»; no lo confundas con six (6)."
        },
        {
          "ko": "dix-sept / dix-huit",
          "es": "Se pronuncian «di-set» y «di-zuit»."
        },
        {
          "ko": "Allez, viens !",
          "es": "«¡Vamos, ven!». Allez aquí no significa «id», sino que anima."
        }
      ],
      "newItems": [
        "quatorze",
        "quinze",
        "seize",
        "dix-sept",
        "dix-huit"
      ]
    },
    {
      "lessonId": "french-survival-07",
      "title": "¡Ya son las tres!",
      "scene": "home",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Léa, quelle heure est-il ?",
          "translation": "Léa, ¿qué hora es?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Il est trois heures.",
          "translation": "Son las tres."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oh non ! Mon cours de français est à trois heures !",
          "translation": "¡Ay, no! ¡Mi clase de francés es a las tres!"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Calme-toi. Ton cours, c'est lundi !",
          "translation": "Tranquila. ¡Tu clase es el lunes!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Lundi ? Ah oui ! Lundi à trois heures.",
          "translation": "¿El lunes? ¡Ah, sí! El lunes a las tres."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Vous êtes combien dans la classe ?",
          "translation": "¿Cuántos son en la clase?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Dix-neuf. Non, vingt avec moi !",
          "translation": "Diecinueve. ¡No, veinte conmigo!"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Vingt ! C'est une grande classe.",
          "translation": "¡Veinte! Es una clase grande."
        }
      ],
      "notes": [
        {
          "ko": "Il est trois heures",
          "es": "Para la hora se usa il est (singular) + heures. La palabra heures nunca se omite."
        },
        {
          "ko": "lundi",
          "es": "Los días van en minúscula y sin artículo para un día concreto: lundi = el lunes."
        },
        {
          "ko": "vingt",
          "es": "Se pronuncia «van» (nasal); la g y la t no suenan."
        },
        {
          "ko": "Dix-neuf",
          "es": "La f suena «v» delante de heures y ans: dix-neuf ans = «diz-nœ-vã»."
        }
      ],
      "newItems": [
        "dix-neuf",
        "vingt",
        "Quelle heure est-il ?",
        "Il est trois heures.",
        "lundi"
      ]
    },
    {
      "lessonId": "french-survival-08",
      "title": "Planes para la semana",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Ana, tu es libre cette semaine ?",
          "translation": "Ana, ¿estás libre esta semana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mardi et jeudi, non. J'ai cours.",
          "translation": "El martes y el jueves no. Tengo clase."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Et mercredi ?",
          "translation": "¿Y el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mercredi, ça va.",
          "translation": "El miércoles me queda bien."
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Super ! Un musée mercredi ?",
          "translation": "¡Genial! ¿Un museo el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Bonne idée ! Et vendredi ?",
          "translation": "¡Buena idea! ¿Y el viernes?"
        },
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "Vendredi, c'est l'anniversaire de ma mère. Et samedi... on fait la fête !",
          "translation": "El viernes es el cumpleaños de mi mamá. Y el sábado… ¡hay fiesta!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Une fête samedi ? Je viens aussi !",
          "translation": "¿Fiesta el sábado? ¡Yo también voy!"
        }
      ],
      "notes": [
        {
          "ko": "J'ai cours",
          "es": "Sin artículo: avoir cours = tener clase."
        },
        {
          "ko": "mercredi",
          "es": "Todos los días terminan en -di (del latín dies, «día»), salvo dimanche."
        },
        {
          "ko": "l'anniversaire",
          "es": "anniversaire = cumpleaños (y también aniversario)."
        },
        {
          "ko": "on fait la fête",
          "es": "faire la fête = salir de fiesta, celebrar."
        }
      ],
      "newItems": [
        "mardi",
        "mercredi",
        "jeudi",
        "vendredi",
        "samedi"
      ]
    },
    {
      "lessonId": "french-survival-09",
      "title": "El mercado del domingo",
      "scene": "market",
      "lines": [
        {
          "speaker": "Léa",
          "speakerEs": "Léa",
          "gender": "f",
          "text": "J'adore le marché du dimanche.",
          "translation": "Me encanta el mercado del domingo."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Moi aussi ! Regarde, des fromages !",
