{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "german-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Guten Morgen! Ich bin Frau Becker, Ihre Lehrerin.",
          "translation": "¡Buenos días! Soy la señora Becker, su profesora."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Guten Morgen! Ich heiße Ana.",
          "translation": "¡Buenos días! Me llamo Ana."
        },
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Freut mich, Ana.",
          "translation": "Mucho gusto, Ana."
        },
        {
          "speaker": "Kenji",
          "speakerEs": "Kenji",
          "gender": "m",
          "text": "Hallo! Ich heiße Kenji.",
          "translation": "¡Hola! Me llamo Kenji."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hallo, Kenji! Freut mich.",
          "translation": "¡Hola, Kenji! Mucho gusto."
        },
        {
          "speaker": "Kenji",
          "speakerEs": "Kenji",
          "gender": "m",
          "text": "Freut mich auch!",
          "translation": "¡Igualmente!"
        },
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Gut! Hallo und herzlich willkommen im Kurs!",
          "translation": "¡Bien! Hola a todos, y bienvenidos al curso."
        }
      ],
      "notes": [
        {
          "ko": "Guten Morgen",
          "es": "Se usa hasta media mañana (más o menos las 10 u 11). Después se dice Guten Tag."
        },
        {
          "ko": "Ich heiße Ana.",
          "es": "heißen = llamarse. También es muy común «Ich bin Ana» (soy Ana)."
        },
        {
          "ko": "Freut mich",
          "es": "Forma corta de «Es freut mich» (me alegra). Para responder: «Freut mich auch» = igualmente."
        },
        {
          "ko": "Frau Becker",
          "es": "A los profesores se les llama Frau o Herr + apellido, y de usted (Sie)."
        }
      ],
      "newItems": [
        "Hallo",
        "Guten Morgen",
        "Ich heiße Ana.",
        "Freut mich."
      ]
    },
    {
      "lessonId": "german-a11-identity-02",
      "title": "Cena en el restaurante",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Kellnerin",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Guten Abend!",
          "translation": "¡Buenas noches!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Guten Abend! Einen Tisch für zwei, bitte.",
          "translation": "¡Buenas noches! Una mesa para dos, por favor."
        },
        {
          "speaker": "Kellnerin",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Hier, bitte. Die Karte.",
          "translation": "Aquí tienen. La carta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Danke. Ein Wasser, bitte.",
          "translation": "Gracias. Un agua, por favor."
        },
        {
          "speaker": "Kellnerin",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Bitte schön.",
          "translation": "Aquí tiene."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Danke!",
          "translation": "¡Gracias!"
        },
        {
          "speaker": "Kellnerin",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Auf Wiedersehen und einen schönen Abend!",
          "translation": "¡Hasta luego y que pasen buena noche!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Auf Wiedersehen!",
          "translation": "¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "Guten Abend!",
          "es": "Guten Abend es un saludo para llegar por la noche. Para despedirse antes de dormir se dice Gute Nacht."
        },
        {
          "ko": "Bitte",
          "es": "bitte es una palabra comodín: «por favor», «aquí tiene» (bitte schön) y también «de nada»."
        },
        {
          "ko": "Auf Wiedersehen",
          "es": "Literalmente «hasta volver a vernos». Es la despedida formal; entre amigos se dice Tschüss."
        }
      ],
      "newItems": [
        "Guten Abend",
        "Auf Wiedersehen",
        "Danke.",
        "Bitte."
      ]
    },
    {
      "lessonId": "german-a11-identity-03",
      "title": "En la oficina de registro",
      "scene": "office",
      "lines": [
        {
          "speaker": "Beamter",
          "speakerEs": "Funcionario",
          "gender": "m",
          "text": "Guten Morgen. Wie heißen Sie?",
          "translation": "Buenos días. ¿Cómo se llama?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich heiße Ana López.",
          "translation": "Me llamo Ana López."
        },
        {
          "speaker": "Beamter",
          "speakerEs": "Funcionario",
          "gender": "m",
          "text": "Ihr Name ist Ana López. Gut. Und Ihr Land?",
          "translation": "Su nombre es Ana López. Bien. ¿Y su país?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich komme aus Mexiko.",
          "translation": "Soy de México."
        },
        {
          "speaker": "Beamter",
          "speakerEs": "Funcionario",
          "gender": "m",
          "text": "Aus Mexiko. Land: Mexiko.",
          "translation": "De México. País: México."
        },
        {
          "speaker": "Beamter",
          "speakerEs": "Funcionario",
          "gender": "m",
          "text": "Und Ihre Adresse in Berlin?",
          "translation": "¿Y su dirección en Berlín?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hier, bitte.",
          "translation": "Aquí tiene."
        },
        {
          "speaker": "Beamter",
          "speakerEs": "Funcionario",
          "gender": "m",
          "text": "Danke. Willkommen in Berlin, Frau López!",
          "translation": "Gracias. ¡Bienvenida a Berlín, señora López!"
        }
      ],
      "notes": [
        {
          "ko": "Wie heißen Sie?",
          "es": "Forma formal de «¿cómo te llamas?» (Wie heißt du?). Sie con mayúscula = usted."
        },
        {
          "ko": "Ihr Name",
          "es": "Ihr con mayúscula = su (de usted). Con minúscula, ihr significa «su (de ella)» o «ustedes»."
        },
        {
          "ko": "Land",
          "es": "das Land = país, pero también «el campo» (auf dem Land = en el campo)."
        },
        {
          "ko": "Frau López",
          "es": "En Alemania, al mudarte debes registrar tu domicilio en el Bürgeramt (la Anmeldung). Allí te tratarán siempre de Sie."
        }
      ],
      "newItems": [
        "Name",
        "Land",
        "Wie heißen Sie?",
        "Ich komme aus Mexiko."
      ]
    },
    {
      "lessonId": "german-a11-identity-04",
      "title": "En la fiesta de Jonas",
      "scene": "party",
      "lines": [
        {
          "speaker": "Lena",
          "speakerEs": "Lena",
          "gender": "f",
          "text": "Hallo! Bist du Ana aus Mexiko?",
          "translation": "¡Hola! ¿Tú eres Ana, la de México?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ja! Hallo!",
          "translation": "¡Sí! ¡Hola!"
        },
        {
          "speaker": "Lena",
          "speakerEs": "Lena",
          "gender": "f",
          "text": "Super! Sprichst du Deutsch?",
          "translation": "¡Genial! ¿Hablas alemán?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich spreche ein wenig Deutsch.",
          "translation": "Hablo un poco de alemán."
        },
        {
          "speaker": "Lena",
          "speakerEs": "Lena",
          "gender": "f",
          "text": "Ach, cool, ich war letztes Jahr in Mexiko-Stadt und fand es total toll!",
          "translation": "Ah, qué padre, el año pasado estuve en la Ciudad de México y me encantó."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sorry… ich verstehe nicht.",
          "translation": "Perdón… no entiendo."
        },
        {
          "speaker": "Lena",
          "speakerEs": "Lena",
          "gender": "f",
          "text": "Kein Problem! Welche Sprache sprichst du? Englisch?",
          "translation": "¡No pasa nada! ¿Qué idioma hablas? ¿Inglés?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Spanisch. Und ein wenig Deutsch!",
          "translation": "Español. ¡Y un poco de alemán!"
        },
        {
          "speaker": "Lena",
          "speakerEs": "Lena",
          "gender": "f",
          "text": "Toll! Du bist die erste Person aus Mexiko auf der Party!",
          "translation": "¡Genial! ¡Eres la primera persona de México en la fiesta!"
        }
      ],
      "notes": [
        {
          "ko": "ein wenig",
          "es": "ein wenig = un poco. En la conversación también se dice muchísimo ein bisschen: «Ich spreche ein bisschen Deutsch»."
        },
        {
          "ko": "Sorry",
          "es": "Muchos alemanes jóvenes usan el inglés sorry para disculparse de forma ligera. La forma alemana es Entschuldigung."
        },
        {
          "ko": "Sprache",
          "es": "die Sprache = idioma, lengua. Los idiomas se escriben con mayúscula: Deutsch, Spanisch, Englisch."
        },
        {
          "ko": "die erste Person",
          "es": "die Person es siempre femenino, sea hombre o mujer."
        }
      ],
      "newItems": [
        "Sprache",
        "Person",
        "Ich spreche ein wenig Deutsch.",
        "Ich verstehe nicht."
      ]
    }
  ]
}
