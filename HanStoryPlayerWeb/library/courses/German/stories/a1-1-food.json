{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "german-a11-food-01",
      "title": "Hambre y sed",
      "scene": "shop",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Jonas, ich habe Hunger!",
          "translation": "¡Jonas, tengo hambre!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Und ich habe Durst. Da ist eine Bäckerei.",
          "translation": "Y yo tengo sed. Ahí hay una panadería."
        },
        {
          "speaker": "Verkäuferin",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "Guten Tag! Was möchten Sie?",
          "translation": "¡Buenas tardes! ¿Qué desean?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ein Brot und zwei Wasser, bitte.",
          "translation": "Un pan y dos aguas, por favor."
        },
        {
          "speaker": "Verkäuferin",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "Ein ganzes Brot?",
          "translation": "¿Un pan entero?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Äh… nein! Zwei Brötchen, bitte.",
          "translation": "Eh… ¡no! Dos bolillos, por favor."
        },
        {
          "speaker": "Verkäuferin",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "Und das Wasser: mit oder ohne Kohlensäure?",
          "translation": "Y el agua: ¿con o sin gas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ohne, bitte!",
          "translation": "¡Sin gas, por favor!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Für mich mit!",
          "translation": "¡La mía con gas!"
        }
      ],
      "notes": [
        {
          "ko": "Ich habe Hunger",
          "es": "¡Igual que en español! Hambre y sed se «tienen»: ich habe Hunger, ich habe Durst."
        },
        {
          "ko": "ein Brot",
          "es": "das Brot es una pieza grande de pan (una hogaza entera). Un panecito individual es das Brötchen."
        },
        {
          "ko": "mit oder ohne Kohlensäure",
          "es": "En Alemania el agua con gas es muy popular. Si quieres agua natural, pide «stilles Wasser» o «ohne Kohlensäure»."
        }
      ],
      "newItems": [
        "Wasser",
        "Brot",
        "Ich habe Hunger.",
        "Ich habe Durst."
      ]
    },
    {
      "lessonId": "german-a11-food-02",
      "title": "Cena tailandesa",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Kellner",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Was möchten Sie?",
          "translation": "¿Qué desean?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich möchte das. Das Curry mit Reis.",
          "translation": "Quiero esto. El curry con arroz."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Für mich auch, bitte.",
          "translation": "Para mí también, por favor."
        },
        {
          "speaker": "Kellner",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Und zu trinken?",
          "translation": "¿Y de tomar?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Einen Kaffee, bitte.",
          "translation": "Un café, por favor."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Kaffee? Um neun Uhr abends?",
          "translation": "¿Café? ¿A las nueve de la noche?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Klar! Kaffee geht immer.",
          "translation": "¡Claro! El café siempre se antoja."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Die Rechnung, bitte!",
          "translation": "¡La cuenta, por favor!"
        },
        {
          "speaker": "Kellner",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Zusammen oder getrennt?",
          "translation": "¿Junto o por separado?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Getrennt, bitte.",
          "translation": "Por separado, por favor."
        }
      ],
      "notes": [
        {
          "ko": "Ich möchte das",
          "es": "möchte (me gustaría) es la forma educada de pedir. «Ich will» (quiero) suena brusco en un restaurante."
        },
        {
          "ko": "Kaffee",
          "es": "der Kaffee: en Alemania suele acentuarse al principio, «KÁ-fe»; en Austria, al final, «ka-FÉ»."
        },
        {
          "ko": "Die Rechnung, bitte!",
          "es": "die Rechnung = la cuenta. También se oye «Zahlen, bitte!» (¡a pagar, por favor!)."
        },
        {
          "ko": "Zusammen oder getrennt?",
          "es": "Es muy común que cada quien pague lo suyo: el mesero pregunta si se cobra junto o por separado."
        }
      ],
      "newItems": [
        "Reis",
        "Kaffee",
        "Ich möchte das.",
        "Die Rechnung, bitte."
      ]
    },
    {
      "lessonId": "german-a11-food-03",
      "title": "Desayuno en el depa",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Lisa",
          "speakerEs": "Lisa",
          "gender": "f",
          "text": "Kaffee, Ana?",
          "translation": "¿Café, Ana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nein, danke. Ich trinke morgens Tee.",
          "translation": "No, gracias. En las mañanas tomo té."
        },
        {
          "speaker": "Lisa",
          "speakerEs": "Lisa",
          "gender": "f",
          "text": "Tee? Und was isst du? Brot?",
          "translation": "¿Té? ¿Y qué comes? ¿Pan?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Einen Apfel. Und gibt es noch Reis? Ich möchte etwas Reis.",
          "translation": "Una manzana. ¿Y queda arroz? Quiero un poco de arroz."
        },
        {
          "speaker": "Lisa",
          "speakerEs": "Lisa",
          "gender": "f",
          "text": "Reis zum Frühstück?!",
          "translation": "¡¿Arroz en el desayuno?!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ja, mit Ei. In Mexiko ganz normal!",
          "translation": "Sí, con huevo. ¡En México es de lo más normal!"
        },
        {
          "speaker": "Lisa",
          "speakerEs": "Lisa",
          "gender": "f",
          "text": "Okay… Hier, der Reis und ein Apfel.",
          "translation": "Bueno… Aquí tienes el arroz y una manzana."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Danke! Und ein Tee für dich?",
          "translation": "¡Gracias! ¿Y un té para ti?"
        },
        {
          "speaker": "Lisa",
          "speakerEs": "Lisa",
          "gender": "f",
          "text": "Nein, danke. Ich trinke morgens Kaffee. Viel Kaffee!",
          "translation": "No, gracias. En las mañanas tomo café. ¡Mucho café!"
        }
      ],
      "notes": [
        {
          "ko": "morgens",
          "es": "morgens = por las mañanas (costumbre). am Morgen = en la mañana (una vez). morgen = mañana (el día siguiente)."
        },
        {
          "ko": "etwas Reis",
          "es": "etwas = algo, un poco de: etwas Reis, etwas Wasser. Sin artículo."
        },
        {
          "ko": "Apfel",
          "es": "La pf alemana se pronuncia junta, p + f: «ápfel»."
        },
        {
          "ko": "Frühstück",
          "es": "das Frühstück = el desayuno (literalmente «el pedazo temprano»)."
        }
      ],
      "newItems": [
        "Tee",
        "Apfel",
        "Ich trinke morgens Tee.",
        "Ich möchte etwas Reis."
      ]
    },
    {
      "lessonId": "german-a11-food-04",
      "title": "En el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Ana, hier gibt es gutes Fleisch.",
          "translation": "Ana, aquí venden buena carne."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich esse kein Fleisch, Jonas.",
          "translation": "Yo no como carne, Jonas."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Wirklich? Bist du Vegetarierin?",
          "translation": "¿De veras? ¿Eres vegetariana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ja, seit zwei Jahren. Ich esse viel Gemüse.",
          "translation": "Sí, desde hace dos años. Como muchas verduras."
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Probieren Sie mal! Ein Apfel aus Brandenburg.",
          "translation": "¡Pruébela! Una manzana de Brandeburgo."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mmm, dieser Apfel ist lecker!",
          "translation": "¡Mmm, esta manzana está riquísima!"
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Zwei Kilo für drei Euro!",
          "translation": "¡Dos kilos por tres euros!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Gut, zwei Kilo, bitte!",
          "translation": "¡Bueno, dos kilos, por favor!"
        }
      ],
      "notes": [
        {
          "ko": "kein Fleisch",
          "es": "Para negar un sustantivo sin artículo se usa kein, no nicht: «Ich esse kein Fleisch» = no como carne."
        },
        {
          "ko": "Gemüse",
          "es": "das Gemüse (verduras) es singular colectivo: viel Gemüse = muchas verduras."
        },
        {
          "ko": "dieser Apfel",
          "es": "der Apfel es masculino (en español «la manzana» es femenino), por eso dieser y no diese."
        },
        {
          "ko": "lecker",
          "es": "lecker = rico, delicioso. Es la palabra más común para decir que algo sabe bien."
        }
      ],
      "newItems": [
        "Fleisch",
        "Gemüse",
        "Dieser Apfel ist lecker.",
        "Ich esse kein Fleisch."
      ]
    }
  ]
}
