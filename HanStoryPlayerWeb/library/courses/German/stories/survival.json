    {
      "lessonId": "german-survival-10",
      "title": "Fotos viejas",
      "scene": "home",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Schau, alte Fotos!",
          "translation": "¡Mira, fotos viejas!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ist das deine Familie?",
          "translation": "¿Esa es tu familia?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Ja, das ist meine Familie.",
          "translation": "Sí, es mi familia."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und die Person hier?",
          "translation": "¿Y esta persona?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist Lukas, ein Freund aus der Schule.",
          "translation": "Es Lukas, un amigo de la escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und jenes Foto? Das große?",
          "translation": "¿Y aquella foto? ¿La grande?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist Berlin, natürlich! Mein Berlin.",
          "translation": "¡Es Berlín, claro! Mi Berlín."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Schön! Familie, Freunde, Berlin…",
          "translation": "¡Qué bonito! Familia, amigos, Berlín…"
        }
      ],
      "notes": [
        {
          "ko": "das ist",
          "es": "das es el comodín para señalar: «das ist meine Familie» = «esta/esa es mi familia», sin importar el género del sustantivo."
