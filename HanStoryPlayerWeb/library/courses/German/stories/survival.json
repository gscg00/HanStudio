{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "german-survival-01",
      "title": "Llegada a Berlín",
      "scene": "airport",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Hallo, Ana! Willkommen in Berlin!",
          "translation": "¡Hola, Ana! ¡Bienvenida a Berlín!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hallo, Jonas! Wo ist die Toilette?",
          "translation": "¡Hola, Jonas! ¿Dónde está el baño?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Die Toilette ist da hinten, neben dem Café.",
          "translation": "Está allá al fondo, junto a la cafetería."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich verstehe nicht. Bitte wiederholen!",
          "translation": "No entiendo. ¡Repítelo, por favor!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Da hinten! Neben dem Café.",
          "translation": "¡Allá al fondo! Junto a la cafetería."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah, danke! Und das Wasser hier… wie viel kostet das?",
          "translation": "¡Ah, gracias! Y esta agua… ¿cuánto cuesta?"
        },
        {
          "speaker": "Verkäuferin",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "Drei Euro.",
          "translation": "Tres euros."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Drei Euro? Am Flughafen ist alles teuer!",
          "translation": "¿Tres euros? ¡En el aeropuerto todo es caro!"
        }
      ],
      "notes": [
        {
          "ko": "Hallo!",
          "es": "El saludo más común en alemán. Sirve con amigos y, en general, con casi todo el mundo; es más neutro que el «hola» informal de otras lenguas."
        },
        {
          "ko": "Bitte wiederholen!",
          "es": "Frase telegráfica de estudiante: «¡repetir, por favor!». Un nativo diría más bien «Kannst du das bitte wiederholen?» (a un amigo) o «Können Sie das bitte wiederholen?» (de usted)."
        },
        {
          "ko": "Wo ist die Toilette?",
          "es": "En lugares públicos se dice die Toilette o das WC (pronunciado «ve-tse»). En una casa se dice das Bad o das Badezimmer."
        },
        {
          "ko": "wie viel kostet das?",
          "es": "Ojo con la pronunciación: la w alemana suena como una v (labio inferior con los dientes): «vi fil kóstet das»."
        }
      ],
      "newItems": [
        "Hallo!",
        "Ich verstehe nicht.",
        "Bitte wiederholen.",
        "Wo ist die Toilette?",
        "Wie viel kostet das?"
      ]
    },
    {
      "lessonId": "german-survival-02",
      "title": "Ana y Anna",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hallo! Können Sie mir helfen?",
          "translation": "¡Hola! ¿Me puede ayudar?"
        },
        {
          "speaker": "Kellner",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Ja, gern! Was möchten Sie? Kaffee, Tee, Saft, Wasser…",
          "translation": "¡Sí, con gusto! ¿Qué desea? Café, té, jugo, agua…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sprechen Sie langsam, bitte.",
          "translation": "Hable despacio, por favor."
        },
        {
          "speaker": "Kellner",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Was… möchten… Sie?",
          "translation": "¿Qué… desea… usted?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ach so! Ich hätte gern Wasser.",
          "translation": "¡Ah, ya! Quisiera agua."
        },
        {
          "speaker": "Anna",
          "speakerEs": "Anna",
          "gender": "f",
          "text": "Hallo! Ich heiße Anna. Wie heißt du?",
          "translation": "¡Hola! Me llamo Anna. ¿Cómo te llamas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich heiße auch Ana! Mit einem n.",
          "translation": "¡Yo también me llamo Ana! Con una sola n."
        },
        {
          "speaker": "Anna",
          "speakerEs": "Anna",
          "gender": "f",
          "text": "Ha! Ana und Anna!",
          "translation": "¡Ja! ¡Ana y Anna!"
        }
      ],
      "notes": [
        {
          "ko": "Können Sie mir helfen?",
          "es": "Sie (con mayúscula) es el «usted» alemán. Úsalo con meseros, vendedores y desconocidos adultos."
        },
        {
          "ko": "Ich hätte gern Wasser.",
          "es": "«Ich hätte gern…» (literalmente «yo tendría con gusto») es la forma más cortés y natural de pedir algo en una tienda o un café."
        },
        {
          "ko": "Wie heißt du?",
          "es": "Entre jóvenes se pasa al du (tú) muy rápido. heißen = llamarse; la ß suena como una s fuerte: «haist du»."
        },
        {
          "ko": "Ana und Anna",
          "es": "En alemán la doble consonante no se pronuncia doble: Ana y Anna suenan casi igual; la nn solo indica que la a anterior es breve."
        }
      ],
      "newItems": [
        "Sprechen Sie langsam.",
        "Können Sie mir helfen?",
        "Ich hätte gern Wasser.",
        "Ich heiße Anna.",
        "Wie heißt du?"
      ]
    },
    {
      "lessonId": "german-survival-03",
      "title": "Un número alemán",
      "scene": "shop",
      "lines": [
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Guten Tag! Woher kommen Sie?",
          "translation": "¡Buenas tardes! ¿De dónde es usted?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ich komme aus Mexiko.",
          "translation": "Soy de México."
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Aus Mexiko? Toll! Hier ist Ihre neue Handynummer.",
          "translation": "¿De México? ¡Genial! Aquí está su nuevo número de celular."
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Null, eins, drei, zwei…",
          "translation": "Cero, uno, tres, dos…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Null, eins, zwei, drei?",
          "translation": "¿Cero, uno, dos, tres?"
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Nein: null, eins, drei, zwo.",
          "translation": "No: cero, uno, tres, dos."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah! Null, eins, drei, zwei. Danke!",
          "translation": "¡Ah! Cero, uno, tres, dos. ¡Gracias!"
        },
        {
          "speaker": "Verkäufer",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Bitte schön!",
          "translation": "¡De nada!"
        }
      ],
      "notes": [
        {
          "ko": "Ich komme aus Mexiko.",
          "es": "Para decir de dónde eres se usa kommen aus («venir de»), no sein: literalmente «vengo de México»."
        },
        {
          "ko": "Handynummer",
          "es": "Falso amigo: das Handy no es «práctico», es el teléfono celular."
        },
        {
          "ko": "zwo",
          "es": "Por teléfono muchos alemanes dicen zwo en vez de zwei, para no confundirlo con drei. Significa lo mismo: dos."
        },
        {
          "ko": "null",
          "es": "null = cero. Ojo: no tiene nada que ver con «nulo»; en alemán es la palabra normal para el número 0."
        }
      ],
      "newItems": [
        "Ich komme aus Mexiko.",
        "null",
        "eins",
        "zwei",
        "drei"
      ]
    },
    {
      "lessonId": "german-survival-04",
      "title": "Esperando el ocho",
      "scene": "bus",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Jonas, welcher Bus? Die Vier?",
          "translation": "Jonas, ¿qué autobús? ¿El cuatro?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Nein, die Acht.",
          "translation": "No, el ocho."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Da kommt die Fünf… und die Sechs.",
          "translation": "Ahí viene el cinco… y el seis."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Und da: die Sieben!",
          "translation": "Y mira: ¡el siete!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und die Acht? Wo ist die Acht?",
          "translation": "¿Y el ocho? ¿Dónde está el ocho?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "In vier Minuten.",
          "translation": "En cuatro minutos."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Vier, fünf, sechs, sieben…",
          "translation": "Cuatro, cinco, seis, siete…"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "…acht! Da ist sie!",
          "translation": "…¡ocho! ¡Ahí está!"
        }
      ],
      "notes": [
        {
          "ko": "die Acht",
          "es": "Los números como sustantivo son femeninos: die Vier, die Acht. Por eso Jonas dice «da ist sie» (ahí está ella), pensando en die Linie (la línea)."
        },
        {
          "ko": "sieben",
          "es": "La s alemana antes de vocal suena sonora, como una z zumbada: «zíben»."
        },
        {
          "ko": "acht",
          "es": "La ch después de a suena gutural, como la j española suave: «ajt»."
        },
        {
          "ko": "fünf",
          "es": "La ü no existe en español: di «i» con los labios redondeados como para «u»."
        }
      ],
      "newItems": [
        "vier",
        "fünf",
        "sechs",
        "sieben",
        "acht"
      ]
    },
    {
      "lessonId": "german-survival-05",
      "title": "La habitación trece",
      "scene": "home",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Welches Zimmer hast du im Hostel?",
          "translation": "¿Qué cuarto tienes en el hostal?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Zimmer dreizehn.",
          "translation": "El cuarto trece."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Hier ist neun, zehn…",
          "translation": "Aquí está el nueve, el diez…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Elf, zwölf… und dreizehn!",
          "translation": "Once, doce… ¡y trece!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Dreizehn… Pech!",
          "translation": "Trece… ¡qué mala suerte!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nein! Dreizehn ist super.",
          "translation": "¡No! El trece es genial."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Und der Schlüssel?",
          "translation": "¿Y la llave?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hier! Nummer dreizehn.",
          "translation": "¡Aquí! Número trece."
        }
      ],
      "notes": [
        {
          "ko": "dreizehn",
          "es": "Del 13 al 19 se forma con el número + zehn (diez): drei + zehn = trece. La z suena «ts»: «dráitsen»."
        },
        {
          "ko": "Elf",
          "es": "Falso amigo: elf es el número once, no un elfo."
        },
        {
          "ko": "zwölf",
          "es": "La ö: pon la boca para «o» y di «e». Zwölf suena aproximadamente «tsvölf»."
        },
        {
          "ko": "Pech!",
          "es": "Pech = mala suerte. En Alemania el día de mala suerte es el viernes 13 (Freitag der Dreizehnte), no el martes 13 como en México."
        }
      ],
      "newItems": [
        "neun",
        "zehn",
        "elf",
        "zwölf",
        "dreizehn"
      ]
    },
    {
      "lessonId": "german-survival-06",
      "title": "Página catorce",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Guten Morgen! Seite vierzehn, bitte.",
          "translation": "¡Buenos días! Página catorce, por favor."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Vierzehn? Oder vierzig?",
          "translation": "¿Catorce? ¿O cuarenta?"
        },
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Vierzehn: eins, vier.",
          "translation": "Catorce: uno, cuatro."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Danke. Und die Übungen?",
          "translation": "Gracias. ¿Y los ejercicios?"
        },
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Übung fünfzehn und sechzehn.",
          "translation": "Los ejercicios quince y dieciséis."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und siebzehn?",
          "translation": "¿Y el diecisiete?"
        },
        {
          "speaker": "Frau Becker",
          "speakerEs": "Profesora Becker",
          "gender": "f",
          "text": "Siebzehn und achtzehn sind Hausaufgaben.",
          "translation": "El diecisiete y el dieciocho son de tarea."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oh nein!",
          "translation": "¡Oh, no!"
        }
      ],
      "notes": [
        {
          "ko": "vierzehn / vierzig",
          "es": "-zehn forma del 13 al 19; -zig forma las decenas (20, 30, 40…). Vierzehn = 14, vierzig = 40."
        },
        {
          "ko": "sechzehn",
          "es": "Atención: sechs pierde la s → sechzehn (16)."
        },
        {
          "ko": "siebzehn",
          "es": "Y sieben pierde -en → siebzehn (17). Son las dos irregularidades de la serie."
        },
        {
          "ko": "Hausaufgaben",
          "es": "Hausaufgaben = tarea (literalmente «tareas de casa»). Es plural: casi siempre se habla de die Hausaufgaben."
        }
      ],
      "newItems": [
        "vierzehn",
        "fünfzehn",
        "sechzehn",
        "siebzehn",
        "achtzehn"
      ]
    },
    {
      "lessonId": "german-survival-07",
      "title": "¡Ya son las tres!",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Jonas, wie spät ist es?",
          "translation": "Jonas, ¿qué hora es?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Es ist drei Uhr. Warum?",
          "translation": "Son las tres. ¿Por qué?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mein Deutschkurs! Er ist um drei Uhr!",
          "translation": "¡Mi clase de alemán! ¡Es a las tres!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Ana, dein Kurs ist am Montag. Heute ist nicht Montag.",
          "translation": "Ana, tu clase es el lunes. Hoy no es lunes."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ach so! Und welcher Bus fährt zur Schule?",
          "translation": "¡Ah, ya! ¿Y qué autobús va a la escuela?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Die Neunzehn oder die Zwanzig.",
          "translation": "El diecinueve o el veinte."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Neunzehn, zwanzig… Okay! Montag, drei Uhr.",
          "translation": "Diecinueve, veinte… ¡Va! Lunes, a las tres."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Genau!",
          "translation": "¡Exacto!"
        }
      ],
      "notes": [
        {
          "ko": "Wie spät ist es?",
          "es": "Literalmente «¿qué tan tarde es?». También se oye «Wie viel Uhr ist es?». Las dos significan «¿qué hora es?»."
        },
        {
          "ko": "Es ist drei Uhr.",
          "es": "Uhr no lleva plural en las horas: drei Uhr, zehn Uhr. Para «a las tres» se usa um: um drei Uhr."
        },
        {
          "ko": "am Montag",
          "es": "Con los días de la semana se usa am (an + dem): am Montag = el lunes. Los días son masculinos: der Montag."
        },
        {
          "ko": "zwanzig",
          "es": "La z alemana suena siempre «ts»: «tsvántsij»."
        }
      ],
      "newItems": [
        "neunzehn",
        "zwanzig",
        "Wie spät ist es?",
        "Es ist drei Uhr.",
        "Montag"
      ]
    },
    {
      "lessonId": "german-survival-08",
      "title": "Planes para la semana",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Ana, hast du am Dienstag Zeit?",
          "translation": "Ana, ¿tienes tiempo el martes?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Am Dienstag? Nein, da habe ich Kurs.",
          "translation": "¿El martes? No, ese día tengo clase."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Und am Mittwoch?",
          "translation": "¿Y el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mittwoch und Donnerstag auch.",
          "translation": "El miércoles y el jueves también."
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Hm… Freitag?",
          "translation": "Mmm… ¿el viernes?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Am Freitag habe ich Zeit!",
          "translation": "¡El viernes sí tengo tiempo!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Super! Freitag Kino und Samstag Flohmarkt.",
          "translation": "¡Súper! El viernes, cine, y el sábado, mercado de pulgas."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Kino und Flohmarkt? Perfekt!",
          "translation": "¿Cine y mercado de pulgas? ¡Perfecto!"
        }
      ],
      "notes": [
        {
          "ko": "Mittwoch",
          "es": "Mittwoch = «mitad de la semana». Es el único día que no termina en -tag."
        },
        {
          "ko": "Donnerstag",
          "es": "Donnerstag viene de Donar (Thor), el dios del trueno: Donner = trueno."
        },
        {
          "ko": "Samstag",
          "es": "En el norte y el este de Alemania (también en Berlín) se oye además Sonnabend para el sábado."
        },
        {
          "ko": "da habe ich Kurs",
          "es": "Cuando la frase empieza con otro elemento (da, am Freitag…), el verbo va en segundo lugar y el sujeto después: «Am Freitag habe ich Zeit»."
        }
      ],
      "newItems": [
        "Dienstag",
        "Mittwoch",
        "Donnerstag",
        "Freitag",
        "Samstag"
      ]
    },
    {
      "lessonId": "german-survival-09",
      "title": "Domingo en el Mauerpark",
      "scene": "market",
      "lines": [
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Heute ist Sonntag: Flohmarkt im Mauerpark!",
