    {
      "lessonId": "german-survival-11",
      "title": "Paseo por el barrio",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Jonas, was ist das?",
          "translation": "Jonas, ¿qué es eso?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist der Bahnhof. Der Hauptbahnhof.",
          "translation": "Es la estación. La estación central."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und das Haus da?",
          "translation": "¿Y esa casa de ahí?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist eine Schule.",
          "translation": "Es una escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und wer ist das? Der Mann mit dem Hund?",
          "translation": "¿Y ese quién es? ¿El señor del perro?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist Herr Wolf, mein Nachbar. Hallo, Herr Wolf!",
          "translation": "Es el señor Wolf, mi vecino. ¡Hola, señor Wolf!"
        },
        {
          "speaker": "Herr Wolf",
          "speakerEs": "Señor Wolf",
          "gender": "m",
          "text": "Hallo, Jonas! Und wer ist das?",
          "translation": "¡Hola, Jonas! ¿Y ella quién es?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Das ist Ana. Sie kommt aus Mexiko.",
          "translation": "Es Ana. Es de México."
        }
      ],
      "notes": [
        {
          "ko": "was",
          "es": "was = qué. La w suena como v: «vas»."
        },
        {
          "ko": "wer",
          "es": "¡Trampa! wer significa «quién», no «dónde» (como el inglés where). «Dónde» es wo."
        },
        {
          "ko": "Bahnhof",
          "es": "Bahnhof = estación de tren; Hauptbahnhof (Haupt = principal) = estación central. La h después de vocal no se pronuncia: «bán-hof»."
        },
        {
          "ko": "das Haus",
          "es": "En alemán todos los sustantivos se escriben con mayúscula: das Haus, die Schule, der Bahnhof."
        }
      ],
      "newItems": [
        "Haus",
        "Schule",
        "Bahnhof",
        "was",
        "wer"
      ]
    },
    {
      "lessonId": "german-survival-12",
      "title": "Tren a Múnich",
      "scene": "station",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Jonas, wo ist der Zug nach München?",
          "translation": "Jonas, ¿dónde está el tren a Múnich?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Gleis fünf.",
          "translation": "Andén cinco."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Und wann fährt er?",
          "translation": "¿Y cuándo sale?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Um zwölf Uhr.",
          "translation": "A las doce."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "München, fünf, zwölf… das ü und das ö sind schwer!",
          "translation": "München, fünf, zwölf… ¡la ü y la ö son difíciles!"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Und das ä! Sag mal: „Mädchen“.",
          "translation": "¡Y la ä! A ver, di: «Mädchen»."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mädchen. Schön, oder?",
          "translation": "Mädchen. Bonito, ¿no?"
        },
        {
          "speaker": "Jonas",
          "speakerEs": "Jonas",
          "gender": "m",
          "text": "Sehr schön! Gute Reise!",
          "translation": "¡Muy bien! ¡Buen viaje!"
        }
      ],
      "notes": [
        {
          "ko": "wo / wann",
          "es": "wo = dónde, wann = cuándo. No confundas wann (cuándo, en preguntas) con wenn (cuando, si)."
        },
        {
          "ko": "ä",
          "es": "La ä se pronuncia como una e abierta: Mädchen (niña, muchacha) suena «médjen»."
        },
        {
          "ko": "ö",
          "es": "La ö: labios redondeados como para «o», lengua como para «e»: schön, zwölf."
        },
        {
          "ko": "ü",
          "es": "La ü: labios redondeados como para «u», lengua como para «i»: München, fünf."
        }
      ],
      "newItems": [
