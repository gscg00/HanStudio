{
  "unitId": "a1-1-places",
  "stories": [
    {
      "lessonId": "russian-a11-places-01",
      "title": "El banco y la estación",
      "scene": "street",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, где вокзал?",
          "translation": "Misha, ¿dónde está la estación?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Это рядом.",
          "translation": "Está cerca.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А банк? Мне нужны деньги.",
          "translation": "¿Y el banco? Necesito dinero.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Банк тоже рядом, вон там.",
          "translation": "El banco también está cerca, allí.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Отлично! Сначала банк, потом вокзал.",
          "translation": "¡Perfecto! Primero el banco, luego la estación.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Хорошо. Идём!",
          "translation": "Bien. ¡Vamos!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "вокзал",
          "es": "Estación de trenes de largo recorrido. Una estación de metro es «станция»."
        },
        {
          "ko": "Это рядом",
          "es": "Literalmente «esto (está) al lado»: «рядом» = cerca, al lado."
        },
        {
          "ko": "Мне нужны деньги",
          "es": "«Necesito dinero» = «a mí son necesarios dineros»: «деньги» siempre es plural."
        },
        {
          "ko": "банк",
          "es": "Ojo: un banco para sentarse es «скамейка»."
        }
      ],
      "newItems": [
        "вокзал",
        "банк",
        "Где вокзал?",
        "Это рядом."
      ]
    },
    {
      "lessonId": "russian-a11-places-02",
      "title": "Rumbo al hospital",
      "scene": "street",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Извините! Где больница?",
          "translation": "¡Disculpe! ¿Dónde está el hospital?",
          "gender": "f"
        },
        {
          "speaker": "Мужчина",
          "speakerEs": "Señor",
          "text": "Больница? Идите прямо.",
          "translation": "¿El hospital? Siga recto.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Прямо?",
          "translation": "¿Recto?",
          "gender": "f"
        },
        {
          "speaker": "Мужчина",
          "speakerEs": "Señor",
          "text": "Да, идите прямо. Больница — за магазином.",
          "translation": "Sí, siga recto. El hospital está detrás de la tienda.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо!",
          "translation": "¡Gracias!",
          "gender": "f"
        },
        {
          "speaker": "Мужчина",
          "speakerEs": "Señor",
          "text": "Пожалуйста. Вам плохо?",
          "translation": "De nada. ¿Se encuentra mal?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Нет, моя подруга работает в больнице.",
          "translation": "No, mi amiga trabaja en el hospital.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "магазин",
          "es": "Falso amigo: «магазин» es tienda, no revista ni almacén."
        },
        {
          "ko": "больница",
          "es": "Viene de «больной» (enfermo): «больница» = el lugar de los enfermos."
        },
        {
          "ko": "Идите прямо",
          "es": "Imperativo de cortesía de «идти» (ir a pie). «Прямо» = recto."
        },
        {
          "ko": "Извините",
          "es": "Para llamar la atención o pedir perdón con desconocidos. A un amigo: «извини»."
        }
      ],
      "newItems": [
        "магазин",
        "больница",
        "Идите прямо.",
        "Извините."
      ]
    },
    {
      "lessonId": "russian-a11-places-03",
      "title": "Camino a la escuela",
      "scene": "park",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, куда ты идёшь?",
          "translation": "Ana, ¿adónde vas?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я иду в школу. Урок в девять.",
          "translation": "Voy a la escuela. La clase es a las nueve.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А я иду на вокзал. Идём вместе?",
          "translation": "Y yo voy a la estación. ¿Vamos juntos?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да! Школа рядом с парком.",
          "translation": "¡Sí! La escuela está junto al parque.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Смотри, вот парк. Вокзал слева.",
          "translation": "Mira, ahí está el parque. La estación está a la izquierda.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Тогда идём через парк!",
          "translation": "¡Entonces vamos por el parque!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Хорошая идея!",
          "translation": "¡Buena idea!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "в школу / на вокзал",
          "es": "Dirección = preposición + acusativo: в школу (школа → школу). Con algunos lugares se usa «на»: на вокзал."
        },
        {
          "ko": "иду",
          "es": "«Идти» = ir a pie, ahora, en una dirección: я иду, ты идёшь."
        },
        {
          "ko": "слева",
          "es": "«Слева» = a la izquierda (dónde está algo). «Налево» = hacia la izquierda (adónde girar)."
        },
        {
          "ko": "рядом с парком",
          "es": "«Рядом с» + instrumental: парк → с парком."
        }
      ],
      "newItems": [
        "школа",
        "парк",
        "Вокзал слева.",
        "Я иду в школу."
      ]
    },
    {
      "lessonId": "russian-a11-places-04",
      "title": "¿Cómo llego al parque?",
      "scene": "street",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Извините, как пройти в парк?",
          "translation": "Disculpe, ¿cómo llego al parque?",
          "gender": "f"
        },
        {
          "speaker": "Женщина",
          "speakerEs": "Señora",
          "text": "Идите прямо, потом направо.",
          "translation": "Siga recto, luego a la derecha.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Направо?",
          "translation": "¿A la derecha?",
          "gender": "f"
        },
        {
          "speaker": "Женщина",
          "speakerEs": "Señora",
          "text": "Да, направо. Парк рядом с банком.",
          "translation": "Sí, a la derecha. El parque está junto al banco.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А банк далеко?",
          "translation": "¿Y el banco está lejos?",
          "gender": "f"
        },
        {
          "speaker": "Женщина",
          "speakerEs": "Señora",
          "text": "Нет, банк находится рядом. Две минуты.",
          "translation": "No, el banco está cerca. Dos minutos.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо! Направо, не налево.",
          "translation": "¡Gracias! A la derecha, no a la izquierda.",
          "gender": "f"
        },
        {
          "speaker": "Женщина",
          "speakerEs": "Señora",
          "text": "Да-да, направо. Всего доброго!",
          "translation": "Eso, a la derecha. ¡Que le vaya bien!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Как пройти в…?",
          "es": "Fórmula fija para preguntar el camino a pie: «¿cómo pasar a…?»."
        },
        {
          "ko": "направо / налево",
          "es": "Indican dirección (girar hacia). Para la ubicación se usa «справа / слева»."
        },
        {
          "ko": "находится",
          "es": "«Encontrarse, estar situado»: más formal que omitir el verbo («банк рядом»)."
        },
        {
          "ko": "Всего доброго!",
          "es": "Despedida cortés: «¡que le vaya bien!»."
        }
      ],
      "newItems": [
        "налево",
        "направо",
        "Банк находится рядом.",
        "Как пройти в парк?"
      ]
    }
  ]
}
