{
  "unitId": "a1-1-people",
  "stories": [
    {
      "lessonId": "russian-a11-people-01",
      "title": "Una foto de familia",
      "scene": "home",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, смотри. Это моя семья.",
          "translation": "Ana, mira. Esta es mi familia.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Кто это?",
          "translation": "¿Quién es?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Это мой отец, а это моя мать.",
          "translation": "Este es mi padre y esta es mi madre.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Твоя мать очень красивая!",
          "translation": "¡Tu madre es muy guapa!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Спасибо! А это Петя. Он мой друг.",
          "translation": "¡Gracias! Y este es Petia. Es mi amigo.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А где сейчас твой отец?",
          "translation": "¿Y dónde está ahora tu padre?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Дома. Мать тоже дома.",
          "translation": "En casa. Mi madre también está en casa.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "мать / отец",
          "es": "Formas neutras o formales de «madre» y «padre». En la conversación diaria se dice más «мама» y «папа»."
        },
        {
          "ko": "мой / моя",
          "es": "El posesivo concuerda con el sustantivo: мой отец, мой друг (masc.), моя мать, моя семья (fem.)."
        },
        {
          "ko": "Он мой друг",
          "es": "Sin verbo «ser» en presente: «él mi amigo»."
        },
        {
          "ko": "Дома",
          "es": "«Дома» = en casa (ubicación); «домой» = a casa (dirección)."
        }
      ],
      "newItems": [
        "мать",
        "отец",
        "Это моя семья.",
        "Он мой друг."
      ]
    },
    {
      "lessonId": "russian-a11-people-02",
      "title": "Los hermanos de Ana",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, смотри. Она моя сестра, София.",
          "translation": "Misha, mira. Ella es mi hermana, Sofía.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Красивая! А это кто?",
          "translation": "¡Guapa! ¿Y este quién es?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Это мой брат Диего. И это мой брат Луис.",
          "translation": "Es mi hermano Diego. Y este es mi hermano Luis.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "У тебя два брата и сестра?",
          "translation": "¿Tienes dos hermanos y una hermana?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, у меня два брата и одна сестра. А у тебя?",
          "translation": "Sí, tengo dos hermanos y una hermana. ¿Y tú?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "У меня одна сестра. Её зовут Катя.",
          "translation": "Yo tengo una hermana. Se llama Katia.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Катя? Красивое имя.",
          "translation": "¿Katia? Bonito nombre.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "У меня",
          "es": "El ruso casi no usa «tener»: dice «junto a mí hay». «У меня два брата» = tengo dos hermanos."
        },
        {
          "ko": "два брата",
          "es": "Tras 2, 3, 4 → genitivo singular: брат → два брата."
        },
        {
          "ko": "Её зовут Катя",
          "es": "Igual que «меня зовут»: «a ella la llaman Katia»."
        },
        {
          "ko": "сестра / брат",
          "es": "En ruso «hermanos» (mixto) se dice «брат и сестра» o «братья и сёстры»; «два брата» son solo varones."
        }
      ],
      "newItems": [
        "сестра",
        "брат",
        "Она моя сестра.",
        "У меня два брата."
      ]
    },
    {
      "lessonId": "russian-a11-people-03",
      "title": "Un niño en el parque",
      "scene": "park",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, кто это?",
          "translation": "Misha, ¿quién es?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Это Ваня, сын моего друга.",
          "translation": "Es Vania, el hijo de mi amigo.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Какой милый ребёнок!",
          "translation": "¡Qué niño tan lindo!",
          "gender": "f"
        },
        {
          "speaker": "Ваня",
          "speakerEs": "Vania",
          "text": "Здравствуйте! А вы кто?",
          "translation": "¡Hola! ¿Y usted quién es?",
          "gender": "m"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Это Анна. Она мой друг.",
          "translation": "Es Ana. Es mi amiga.",
          "gender": "m"
        },
        {
          "speaker": "Ваня",
          "speakerEs": "Vania",
          "text": "Анна, сколько вам лет?",
          "translation": "Ana, ¿cuántos años tiene usted?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Мне двадцать пять лет. А тебе?",
          "translation": "Tengo veinticinco años. ¿Y tú?",
          "gender": "f"
        },
        {
          "speaker": "Ваня",
          "speakerEs": "Vania",
          "text": "Мне пять!",
          "translation": "¡Yo tengo cinco!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Сколько вам лет?",
          "es": "La edad va en dativo: «¿cuántos años a usted?». Respuesta: «Мне … лет». El niño usa «вам» porque a los adultos se les habla de usted."
        },
        {
          "ko": "ребёнок",
          "es": "«Niño, criatura». Su plural es irregular: дети. La «ё» siempre lleva el acento."
        },
        {
          "ko": "Она мой друг",
          "es": "Para una mujer puede decirse «мой друг» (amigo en general) o «моя подруга» (amiga)."
        },
        {
          "ko": "А тебе?",
          "es": "Ana tutea al niño: a los niños se les habla de «ты»."
        }
      ],
      "newItems": [
        "друг",
        "ребёнок",
        "Кто это?",
        "Сколько вам лет?"
      ]
    },
    {
      "lessonId": "russian-a11-people-04",
      "title": "Donde trabaja mamá",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, моя мама работает здесь.",
          "translation": "Ana, mi madre trabaja aquí.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Здесь? В этом кафе?",
          "translation": "¿Aquí? ¿En este café?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да. Вон та женщина — моя мама.",
          "translation": "Sí. Aquella mujer es mi madre.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А тот мужчина?",
          "translation": "¿Y aquel hombre?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Это Иван Сергеевич. Он работает с мамой.",
          "translation": "Es Iván Serguéievich. Trabaja con mi madre.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ты живёшь с мамой?",
          "translation": "¿Vives con tu madre?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да, мы живём вместе. А ты?",
          "translation": "Sí, vivimos juntos. ¿Y tú?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я живу с подругой. Мы тоже живём вместе!",
          "translation": "Yo vivo con una amiga. ¡También vivimos juntas!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "мужчина",
          "es": "Termina en «-а» pero es masculino: «тот мужчина», «он»."
        },
        {
          "ko": "с мамой / с подругой",
          "es": "«С» (con) exige instrumental: мама → с мамой, подруга → с подругой."
        },
        {
          "ko": "живём",
          "es": "La «ё» siempre es tónica: [zhiviom]. Verbo «жить»: я живу, ты живёшь, мы живём."
        },
        {
          "ko": "вместе",
          "es": "«Вместе» no cambia de género: sirve para «juntos» y «juntas»."
        }
      ],
      "newItems": [
        "женщина",
        "мужчина",
        "Моя мама работает здесь.",
        "Мы живём вместе."
      ]
    }
  ]
}
