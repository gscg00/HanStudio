{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "russian-survival-01",
      "title": "Llegada a Moscú",
      "scene": "airport",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Здравствуйте!",
          "translation": "¡Hola!",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Здравствуйте!",
          "translation": "¡Hola!",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Где туалет?",
          "translation": "¿Dónde está el baño?",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Туалет? Прямо, потом направо, около выхода.",
          "translation": "¿El baño? Todo derecho, luego a la derecha, junto a la salida.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я не понимаю. Повторите, пожалуйста.",
          "translation": "No entiendo. Repita, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Туалет — вон там.",
          "translation": "El baño está allí.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А! Спасибо!",
          "translation": "¡Ah! ¡Gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Здравствуйте",
          "es": "Saludo formal. La primera «в» no se pronuncia: [zdrástvuytie]. Literalmente es «¡que tenga salud!»."
        },
        {
          "ko": "Где туалет?",
          "es": "En presente el ruso no usa el verbo «ser/estar»: literalmente «¿dónde baño?»."
        },
        {
          "ko": "Повторите, пожалуйста",
          "es": "«Повторите» es imperativo de cortesía (usted). «Пожалуйста» = por favor; la «й» casi no se oye: [pazhálsta]."
        },
        {
          "ko": "Спасибо",
          "es": "Gracias. Se pronuncia [spasíba]: la «о» sin acento suena como «a»."
        }
      ],
      "newItems": [
        "Здравствуйте!",
        "Спасибо.",
        "Я не понимаю.",
        "Повторите, пожалуйста.",
        "Где туалет?"
      ]
    },
    {
      "lessonId": "russian-survival-02",
      "title": "Perdida en la estación",
      "scene": "station",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Здравствуйте! Помогите, пожалуйста.",
          "translation": "¡Hola! Ayúdeme, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Игорь",
          "speakerEs": "Ígor",
          "text": "Здравствуйте. Да, конечно.",
          "translation": "Hola. Sí, claro.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Вы говорите по-английски?",
          "translation": "¿Habla inglés?",
          "gender": "f"
        },
        {
          "speaker": "Игорь",
          "speakerEs": "Ígor",
          "text": "Немного… Вам куда? На вокзал? Это прямо, потом налево и направо.",
          "translation": "Un poco… ¿Adónde va? ¿A la estación? Es todo recto, luego a la izquierda y a la derecha.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Говорите медленнее, пожалуйста.",
          "translation": "Hable más despacio, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Игорь",
          "speakerEs": "Ígor",
          "text": "Вок-зал — пря-мо. Как вас зовут?",
          "translation": "La es-ta-ción, to-do rec-to. ¿Cómo se llama?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Меня зовут Анна. А вас?",
          "translation": "Me llamo Ana. ¿Y usted?",
          "gender": "f"
        },
        {
          "speaker": "Игорь",
          "speakerEs": "Ígor",
          "text": "Меня зовут Игорь. Удачи, Анна!",
          "translation": "Me llamo Ígor. ¡Suerte, Ana!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Меня зовут Анна",
          "es": "Literalmente «a mí me llaman Ana»: «меня» es «me» (acusativo)."
        },
        {
          "ko": "Как вас зовут?",
          "es": "«¿Cómo le llaman a usted?». «Вас» es la forma de cortesía; a un amigo: «Как тебя зовут?»."
        },
        {
          "ko": "по-английски",
          "es": "Con «говорить» (hablar) el idioma va como adverbio: по-английски, по-русски, по-испански."
        },
        {
          "ko": "медленнее",
          "es": "Comparativo de «медленно» (despacio): «más despacio»."
        }
      ],
      "newItems": [
        "Говорите медленнее.",
        "Вы говорите по-английски?",
        "Помогите, пожалуйста.",
        "Меня зовут Анна.",
        "Как вас зовут?"
      ]
    },
    {
      "lessonId": "russian-survival-03",
      "title": "La contraseña del wifi",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Здравствуйте! Кофе, пожалуйста.",
          "translation": "¡Hola! Un café, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Бариста",
          "speakerEs": "Barista",
          "text": "Здравствуйте! Вы не русская?",
          "translation": "¡Hola! Usted no es rusa, ¿verdad?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Нет. Я из Мексики.",
          "translation": "No. Soy de México.",
          "gender": "f"
        },
        {
          "speaker": "Бариста",
          "speakerEs": "Barista",
          "text": "Из Мексики! Как интересно.",
          "translation": "¡De México! Qué interesante.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А какой пароль от вайфая?",
          "translation": "¿Y cuál es la contraseña del wifi?",
          "gender": "f"
        },
        {
          "speaker": "Бариста",
          "speakerEs": "Barista",
          "text": "Пароль: ноль, один, два, три.",
          "translation": "La contraseña: cero, uno, dos, tres.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ноль, один, два, три… Спасибо!",
          "translation": "Cero, uno, dos, tres… ¡Gracias!",
          "gender": "f"
        },
        {
          "speaker": "Бариста",
          "speakerEs": "Barista",
          "text": "Пожалуйста!",
          "translation": "¡De nada!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Я из Мексики",
          "es": "«Из» (de, desde) exige genitivo: Мексика → из Мексики."
        },
        {
          "ko": "один, два",
          "es": "Uno y dos cambian con el género: один/одна, два/две."
        },
        {
          "ko": "Пожалуйста!",
          "es": "Además de «por favor», «пожалуйста» es la respuesta a «спасибо»: «de nada»."
        }
      ],
      "newItems": [
        "Я из Мексики.",
        "ноль",
        "один",
        "два",
        "три"
      ]
    },
    {
      "lessonId": "russian-survival-04",
      "title": "El número de Misha",
      "scene": "street",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, какой у тебя номер телефона?",
          "translation": "Misha, ¿cuál es tu número de teléfono?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Восемь, четыре, пять, шесть…",
          "translation": "Ocho, cuatro, cinco, seis…",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Медленнее, пожалуйста!",
          "translation": "¡Más despacio, por favor!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Восемь… четыре… пять… шесть… семь…",
          "translation": "Ocho… cuatro… cinco… seis… siete…",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Восемь, четыре, пять, шесть, семь. Так?",
          "translation": "Ocho, cuatro, cinco, seis, siete. ¿Así?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да! И ещё: семь, семь, восемь.",
          "translation": "¡Sí! Y además: siete, siete, ocho.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо, Миша!",
          "translation": "¡Gracias, Misha!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Восемь",
          "es": "Los móviles rusos se marcan empezando por 8 (equivale al prefijo +7). La «ь» final suaviza la «м»: [vósiem']."
        },
        {
          "ko": "какой у тебя номер",
          "es": "Entre amigos se usa «ты»: «у тебя» = tú tienes."
        },
        {
          "ko": "четыре",
          "es": "El acento cae en la «ы»: [chetýrie]."
        },
        {
          "ko": "пять / шесть / семь",
          "es": "La «ь» final indica consonante blanda: suena una pequeña «i» al final."
        }
      ],
      "newItems": [
        "четыре",
        "пять",
        "шесть",
        "семь",
        "восемь"
      ]
    },
    {
      "lessonId": "russian-survival-05",
      "title": "¿Qué autobús?",
      "scene": "bus",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, какой автобус идёт в центр?",
          "translation": "Misha, ¿qué autobús va al centro?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Одиннадцать или двенадцать.",
          "translation": "El once o el doce.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Вот автобус номер девять.",
          "translation": "Ahí está el autobús número nueve.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Нет, девять не идёт в центр.",
          "translation": "No, el nueve no va al centro.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А тринадцать?",
          "translation": "¿Y el trece?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Тринадцать тоже нет.",
          "translation": "El trece tampoco.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Смотри! Десять… и одиннадцать!",
          "translation": "¡Mira! El diez… ¡y el once!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Отлично! Идём!",
          "translation": "¡Perfecto! ¡Vamos!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "-надцать",
          "es": "Del 11 al 19 se forman con «-надцать» = «sobre diez»: один-на-дцать (uno sobre diez)."
        },
        {
          "ko": "одиннадцать",
          "es": "Se escribe con doble «н»: оди-н + на-дцать."
        },
        {
          "ko": "девять / десять",
          "es": "No los confundas: девять = 9, десять = 10."
        }
      ],
      "newItems": [
        "девять",
        "десять",
        "одиннадцать",
        "двенадцать",
        "тринадцать"
      ]
    },
    {
      "lessonId": "russian-survival-06",
      "title": "Página catorce",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Учительница",
          "speakerEs": "Profesora",
          "text": "Здравствуйте! Откройте книгу. Страница четырнадцать.",
          "translation": "¡Buenos días! Abran el libro. Página catorce.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Извините, какая страница?",
          "translation": "Perdone, ¿qué página?",
          "gender": "f"
        },
        {
          "speaker": "Учительница",
          "speakerEs": "Profesora",
          "text": "Четырнадцать. Упражнение пятнадцать.",
          "translation": "Catorce. Ejercicio quince.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо.",
          "translation": "Gracias.",
          "gender": "f"
        },
        {
          "speaker": "Учительница",
          "speakerEs": "Profesora",
          "text": "Домашнее задание: упражнения шестнадцать, семнадцать и восемнадцать.",
          "translation": "Tarea: ejercicios dieciséis, diecisiete y dieciocho.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Шестнадцать, семнадцать, восемнадцать… Это много!",
          "translation": "Dieciséis, diecisiete, dieciocho… ¡Es mucho!",
          "gender": "f"
        },
        {
          "speaker": "Учительница",
          "speakerEs": "Profesora",
          "text": "Ничего, Анна. Вы можете!",
          "translation": "No pasa nada, Ana. ¡Usted puede!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "четырнадцать",
          "es": "Cuatro (четыре) pierde la «е» final: четыр-надцать."
        },
        {
          "ko": "пятнадцать / шестнадцать",
          "es": "De 5 a 9 se quita la «ь»: пять → пятнадцать, шесть → шестнадцать. En «шестнадцать» la «т» no se pronuncia."
        },
        {
          "ko": "Откройте",
          "es": "La profesora usa el imperativo plural/formal: «откройте» = abran."
        }
      ],
      "newItems": [
        "четырнадцать",
        "пятнадцать",
        "шестнадцать",
        "семнадцать",
        "восемнадцать"
      ]
    },
    {
      "lessonId": "russian-survival-07",
      "title": "El boleto de tren",
      "scene": "station",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, вот мой билет.",
          "translation": "Misha, aquí está mi boleto.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Так… Понедельник. Вагон девятнадцать, место двадцать.",
          "translation": "A ver… Lunes. Vagón diecinueve, asiento veinte.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Понедельник — это сегодня?",
          "translation": "¿El lunes es hoy?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да, сегодня понедельник!",
          "translation": "¡Sí, hoy es lunes!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Который час?",
          "translation": "¿Qué hora es?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Три часа. Поезд в четыре.",
          "translation": "Son las tres. El tren sale a las cuatro.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Отлично. Вагон девятнадцать… Где он?",
          "translation": "Perfecto. Vagón diecinueve… ¿Dónde está?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Вон там. Идём!",
          "translation": "Allí. ¡Vamos!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Который час?",
          "es": "Literalmente «¿cuál hora?». También se oye «Сколько времени?»."
        },
        {
          "ko": "Три часа",
          "es": "Tras 2, 3 y 4 el sustantivo va en genitivo singular: час → три часа."
        },
        {
          "ko": "понедельник",
          "es": "Los días de la semana se escriben con minúscula. «Понедельник» viene de «después de la semana (неделя)»."
        },
        {
          "ko": "двадцать",
          "es": "Se pronuncia [dvátsat']: la «д» antes de «ц» casi desaparece."
        }
      ],
      "newItems": [
        "девятнадцать",
        "двадцать",
        "Который час?",
        "Три часа.",
        "понедельник"
      ]
    },
    {
      "lessonId": "russian-survival-08",
      "title": "La semana de Ana",
      "scene": "street",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, когда у тебя уроки?",
          "translation": "Ana, ¿cuándo tienes clases?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Вторник, среда и четверг.",
          "translation": "Martes, miércoles y jueves.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А пятница?",
          "translation": "¿Y el viernes?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Пятница — свободный день!",
          "translation": "¡El viernes es día libre!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Отлично! В пятницу — кино?",
          "translation": "¡Genial! ¿El viernes, cine?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да! А суббота?",
          "translation": "¡Sí! ¿Y el sábado?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Суббота — футбол. Ты любишь футбол?",
          "translation": "El sábado, fútbol. ¿Te gusta el fútbol?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Конечно! Я из Мексики!",
          "translation": "¡Claro! ¡Soy de México!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "В пятницу",
          "es": "Para decir «el viernes» (cuándo) se usa «в» + acusativo: пятница → в пятницу, среда → в среду, суббота → в субботу."
        },
        {
          "ko": "четверг / пятница",
          "es": "Vienen de los números: четверг ← четыре (4.º día), пятница ← пять (5.º día)."
        },
        {
          "ko": "среда",
          "es": "«Среда» significa también «medio, ambiente»: es el día de en medio."
        },
        {
          "ko": "суббота",
          "es": "Como «sábado», viene de «sabbat»."
        }
      ],
      "newItems": [
        "вторник",
        "среда",
        "четверг",
        "пятница",
        "суббота"
      ]
    },
    {
      "lessonId": "russian-survival-09",
      "title": "Domingo en el parque",
      "scene": "park",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
