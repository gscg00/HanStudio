{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "russian-a11-identity-01",
      "title": "La mamá de Misha",
      "scene": "home",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Мама, доброе утро! Это Анна.",
          "translation": "¡Buenos días, mamá! Esta es Ana.",
          "gender": "m"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Доброе утро! Здравствуйте, Анна.",
          "translation": "¡Buenos días! Hola, Ana.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Здравствуйте! Меня зовут Анна. Я из Мексики.",
          "translation": "¡Hola! Me llamo Ana. Soy de México.",
          "gender": "f"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Очень приятно. Меня зовут Ольга Петровна.",
          "translation": "Mucho gusto. Me llamo Olga Petrovna.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Очень приятно, Ольга Петровна.",
          "translation": "Mucho gusto, Olga Petrovna.",
          "gender": "f"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Анна, хотите чай?",
          "translation": "Ana, ¿quiere un té?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, спасибо!",
          "translation": "¡Sí, gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Ольга Петровна",
          "es": "Nombre + patronímico (nombre del padre + -овна/-евна para mujeres). Es la forma respetuosa de dirigirse a un adulto, por ejemplo la madre de un amigo."
        },
        {
          "ko": "доброе утро",
          "es": "«Buenos días» (solo por la mañana). «Утро» es neutro, por eso el adjetivo termina en «-ое»."
        },
        {
          "ko": "Очень приятно",
          "es": "Literalmente «muy agradable». Se responde igual o con «Мне тоже» (a mí también)."
        },
        {
          "ko": "хотите",
          "es": "La madre de Misha trata a Ana de «вы» (usted) y Ana le responde igual."
        }
      ],
      "newItems": [
        "здравствуйте",
        "доброе утро",
        "Меня зовут Анна.",
        "Очень приятно."
      ]
    },
    {
      "lessonId": "russian-a11-identity-02",
      "title": "Té por la noche",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Добрый вечер!",
          "translation": "¡Buenas noches!",
          "gender": "m"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Добрый вечер. Два чая, пожалуйста.",
          "translation": "Buenas noches. Dos tés, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Пожалуйста, ваш чай.",
          "translation": "Aquí tienen su té.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо!",
          "translation": "¡Gracias!",
          "gender": "f"
        },
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Пожалуйста!",
          "translation": "¡De nada!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ну, Миша, я иду домой. До свидания!",
          "translation": "Bueno, Misha, me voy a casa. ¡Adiós!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, мы друзья! Можно просто «пока».",
          "translation": "¡Ana, somos amigos! Puedes decir simplemente «chao».",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Пока, Миша!",
          "translation": "¡Chao, Misha!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Пожалуйста",
          "es": "Tres usos: «por favor», «aquí tiene» (al dar algo) y «de nada»."
        },
        {
          "ko": "Добрый вечер",
          "es": "«Buenas noches» como saludo al llegar por la tarde-noche. Para despedirse antes de dormir: «Спокойной ночи»."
        },
        {
          "ko": "До свидания",
          "es": "Adiós formal («hasta volver a vernos»). Entre amigos se dice «пока»."
        },
        {
          "ko": "Два чая",
          "es": "Tras «два» el sustantivo va en genitivo singular: чай → два чая."
        }
      ],
      "newItems": [
        "добрый вечер",
        "до свидания",
        "Спасибо.",
        "Пожалуйста."
      ]
    },
    {
      "lessonId": "russian-a11-identity-03",
      "title": "En la oficina de registro",
      "scene": "office",
      "lines": [
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Здравствуйте. Как вас зовут?",
          "translation": "Buenos días. ¿Cómo se llama?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Меня зовут Анна Мартинес.",
          "translation": "Me llamo Ana Martínez.",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Анна — это имя, а Мартинес — фамилия?",
          "translation": "¿Ana es el nombre y Martínez el apellido?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да.",
          "translation": "Sí.",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Из какой вы страны?",
          "translation": "¿De qué país es usted?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я из Мексики.",
          "translation": "Soy de México.",
          "gender": "f"
        },
        {
          "speaker": "Сотрудница",
          "speakerEs": "Empleada",
          "text": "Мексика — красивая страна!",
          "translation": "¡México es un país bonito!",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо!",
          "translation": "¡Gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "имя",
          "es": "Aunque termina en «-я», «имя» es neutro (como «время», tiempo)."
        },
        {
          "ko": "фамилия",
          "es": "Falso amigo: «фамилия» es el apellido, no la familia (que es «семья»)."
        },
        {
          "ko": "Из какой вы страны?",
          "es": "«Из» + genitivo: страна → из страны. Literalmente «¿de qué país usted?»."
        },
        {
          "ko": "страна",
          "es": "«Страна» es femenino; por eso «красивая страна»."
        }
      ],
      "newItems": [
        "имя",
        "страна",
        "Как вас зовут?",
        "Я из Мексики."
      ]
    },
    {
      "lessonId": "russian-a11-identity-04",
      "title": "Demasiado rápido",
      "scene": "street",
      "lines": [
        {
          "speaker": "Мужчина",
          "speakerEs": "Señor",
          "text": "Девушка, вы говорите по-русски?",
          "translation": "Señorita, ¿habla ruso?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я немного говорю по-русски.",
          "translation": "Hablo un poco de ruso.",
          "gender": "f"
        },
        {
          "speaker": "Мужчина",
          "speakerEs": "Señor",
          "text": "Отлично! Скажите, пожалуйста, как пройти к Красной площади? Я тут не местный…",
          "translation": "¡Estupendo! Dígame, por favor, ¿cómo se llega a la Plaza Roja? No soy de aquí…",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Извините, я не понимаю.",
          "translation": "Perdone, no entiendo.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, он хороший человек, но говорит очень быстро!",
          "translation": "Ana, es buena persona, ¡pero habla muy rápido!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Русский язык — трудный язык!",
          "translation": "¡El ruso es un idioma difícil!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да. Но ты говоришь хорошо!",
          "translation": "Sí. ¡Pero tú hablas bien!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Девушка",
          "es": "Forma habitual de llamar a una mujer joven desconocida («señorita, chica»)."
        },
        {
          "ko": "по-русски / русский язык",
          "es": "«Говорить по-русски» = hablar ruso (adverbio); «русский язык» = la lengua rusa (sustantivo)."
        },
        {
          "ko": "язык",
          "es": "Como en español, «язык» es el idioma y también la lengua (órgano)."
        },
        {
          "ko": "Я не понимаю",
          "es": "«Не» va justo antes del verbo que niega."
        }
      ],
      "newItems": [
        "язык",
        "человек",
        "Я немного говорю по-русски.",
        "Я не понимаю."
      ]
    }
  ]
}
