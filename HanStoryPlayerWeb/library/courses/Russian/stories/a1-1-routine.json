{
  "unitId": "a1-1-routine",
  "stories": [
    {
      "lessonId": "russian-a11-routine-01",
      "title": "Madrugadores",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, когда ты просыпаешься?",
          "translation": "Ana, ¿cuándo te despiertas?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я просыпаюсь в семь часов. Каждый день.",
          "translation": "Me despierto a las siete. Todos los días.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "В семь? Я просыпаюсь в шесть.",
          "translation": "¿A las siete? Yo me despierto a las seis.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "В шесть? Почему?",
          "translation": "¿A las seis? ¿Por qué?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Я работаю в кафе. Работаю каждый день.",
          "translation": "Trabajo en un café. Trabajo todos los días.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Каждый день? Это много!",
          "translation": "¿Todos los días? ¡Es mucho!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да, но я люблю работать.",
          "translation": "Sí, pero me gusta trabajar.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "просыпаться",
          "es": "La partícula «-ся» marca el verbo reflexivo: я просыпаюсь (me despierto)."
        },
        {
          "ko": "в семь часов",
          "es": "«В» + hora. Tras 5 o más, «час» va en genitivo plural: семь часов."
        },
        {
          "ko": "каждый день",
          "es": "Sin preposición: «каждый день» = cada día, todos los días."
        },
        {
          "ko": "я люблю работать",
          "es": "«Любить» + infinitivo = gustar hacer algo (literalmente «amo trabajar»)."
        }
      ],
      "newItems": [
        "просыпаться",
        "работать",
        "каждый день",
        "в семь часов"
      ]
    },
    {
      "lessonId": "russian-a11-routine-02",
      "title": "Después del trabajo",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, что ты делаешь после работы?",
          "translation": "Misha, ¿qué haces después del trabajo?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "После работы я ем дома с мамой.",
          "translation": "Después del trabajo como en casa con mi madre.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "А я учусь. Я учусь каждый день.",
          "translation": "Pues yo estudio. Estudio todos los días.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Ты много учишься?",
          "translation": "¿Estudias mucho?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да. Я учусь даже перед сном.",
          "translation": "Sí. Estudio incluso antes de dormir.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Перед сном? А я перед сном ем!",
          "translation": "¿Antes de dormir? ¡Yo antes de dormir como!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ты всё время ешь, Миша!",
          "translation": "¡Siempre estás comiendo, Misha!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "есть",
          "es": "Verbo irregular: я ем, ты ешь, он ест. Ojo: «есть» también significa «hay»."
        },
        {
          "ko": "после работы",
          "es": "«После» (después de) exige genitivo: работа → после работы."
        },
        {
          "ko": "перед сном",
          "es": "Literalmente «antes del sueño»: «перед» + instrumental (сон → сном)."
        },
        {
          "ko": "учиться",
          "es": "«Учиться» = estudiar, ser estudiante; es reflexivo: я учусь, ты учишься."
        }
      ],
      "newItems": [
        "учиться",
        "есть",
        "после работы",
        "перед сном"
      ]
    },
    {
      "lessonId": "russian-a11-routine-03",
      "title": "Demasiado café",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, когда ты встаёшь?",
          "translation": "Ana, ¿a qué hora te levantas?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я встаю в семь часов.",
          "translation": "Me levanto a las siete.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "И пьёшь кофе?",
          "translation": "¿Y tomas café?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, я пью много кофе. Я учусь днём.",
          "translation": "Sí, tomo mucho café. Estudio durante el día.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А ты хорошо спишь?",
          "translation": "¿Y duermes bien?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Нет, я сплю мало. Шесть часов.",
          "translation": "No, duermo poco. Seis horas.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Пей меньше кофе!",
          "translation": "¡Toma menos café!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "встаю",
          "es": "«Вставать» (levantarse) pierde «-ва-» en presente: я встаю, ты встаёшь. Distinto de «просыпаться» (despertarse)."
        },
        {
          "ko": "пить",
          "es": "Presente irregular: я пью, ты пьёшь. Imperativo: пей!"
        },
        {
          "ko": "спать",
          "es": "En la 1.ª persona aparece una «л»: я сплю, ты спишь."
        },
        {
          "ko": "днём",
          "es": "«Днём» = de día, durante el día (sobre todo las horas centrales). «Утром» = por la mañana, «вечером» = por la tarde-noche."
        }
      ],
      "newItems": [
        "пить",
        "спать",
        "Я встаю в семь часов.",
        "Я учусь днём."
      ]
    },
    {
      "lessonId": "russian-a11-routine-04",
      "title": "Invitación para el domingo",
      "scene": "home",
      "lines": [
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Анна, завтра воскресенье. В воскресенье мы едим вместе. Приходите!",
          "translation": "Ana, mañana es domingo. Los domingos comemos juntos. ¡Venga!",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо! А вы не работаете?",
          "translation": "¡Gracias! ¿Y usted no trabaja?",
          "gender": "f"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Нет, я не работаю в воскресенье.",
          "translation": "No, no trabajo el domingo.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А я работаю. Каждое утро — работа! Но вечером я дома.",
          "translation": "Yo sí trabajo. ¡Cada mañana, a trabajar! Pero por la tarde estoy en casa.",
          "gender": "m"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Хорошо, тогда вечером. Все вместе!",
          "translation": "Bien, entonces por la tarde. ¡Todos juntos!",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Отлично! Спокойной ночи!",
          "translation": "¡Perfecto! ¡Buenas noches!",
          "gender": "f"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Уже ночь… Спокойной ночи, Анна.",
          "translation": "Ya es de noche… Buenas noches, Ana.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "в воскресенье",
          "es": "«В» + acusativo para decir qué día: в воскресенье = el domingo."
        },
        {
          "ko": "утро / утром",
          "es": "«Утро» es la mañana (sustantivo); «утром» = por la mañana (adverbio)."
        },
        {
          "ko": "Спокойной ночи",
          "es": "Despedida antes de dormir; «ночь» (noche) va en genitivo: ночи. Literalmente «(le deseo) una noche tranquila»."
        },
        {
          "ko": "Мы едим",
          "es": "«Есть» en plural: мы едим, вы едите, они едят."
        }
      ],
      "newItems": [
        "утро",
        "ночь",
        "Мы едим вместе.",
        "Я не работаю в воскресенье."
      ]
    }
  ]
}
