{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "russian-a11-food-01",
      "title": "Hambre y sed",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, я голоден!",
          "translation": "¡Ana, tengo hambre!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "На кухне есть хлеб.",
          "translation": "En la cocina hay pan.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Хлеб? Только хлеб?",
          "translation": "¿Pan? ¿Solo pan?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Хлеб и сыр.",
          "translation": "Pan y queso.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Отлично! А ты?",
          "translation": "¡Genial! ¿Y tú?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я не голодна. Я хочу пить.",
          "translation": "No tengo hambre. Tengo sed.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Вот вода.",
          "translation": "Aquí tienes agua.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Спасибо!",
          "translation": "¡Gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "я голоден / я голодна",
          "es": "«Tener hambre» es un adjetivo que cambia con el género: un hombre dice «я голоден», una mujer «я голодна»."
        },
        {
          "ko": "Я хочу пить",
          "es": "Literalmente «quiero beber»: así se dice «tengo sed»."
        },
        {
          "ko": "есть хлеб",
          "es": "Aquí «есть» significa «hay»: «на кухне есть хлеб»."
        },
        {
          "ko": "вода",
          "es": "Acento en la última sílaba: [vadá]."
        }
      ],
      "newItems": [
        "вода",
        "хлеб",
        "Я голоден.",
        "Я хочу пить."
      ]
    },
    {
      "lessonId": "russian-a11-food-02",
      "title": "En el restaurante",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Добрый вечер! Что вы хотите?",
          "translation": "¡Buenas noches! ¿Qué desean?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я хочу это, пожалуйста.",
          "translation": "Quiero esto, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Рис? Хорошо. А вы?",
          "translation": "¿El arroz? Bien. ¿Y usted?",
          "gender": "m"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Мне тоже рис. И два кофе, пожалуйста.",
          "translation": "Para mí también arroz. Y dos cafés, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, кофе — «он» или «оно»?",
          "translation": "Misha, ¿«café» es «él» o «ello»?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Правильно — «он». Но многие говорят «оно».",
          "translation": "Lo correcto es «él». Pero mucha gente dice «ello».",
          "gender": "m"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Счёт, пожалуйста.",
          "translation": "La cuenta, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Официант",
          "speakerEs": "Camarero",
          "text": "Вот ваш счёт.",
          "translation": "Aquí tiene su cuenta.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "кофе",
          "es": "Palabra extranjera que nunca cambia de forma (два кофе). Es masculina según la norma, aunque en el habla se acepta también neutro."
        },
        {
          "ko": "Я хочу это",
          "es": "Señalando algo en la carta: «quiero esto»."
        },
        {
          "ko": "Мне тоже рис",
          "es": "«Мне» (a mí) se usa mucho para pedir: «мне рис» = para mí, arroz."
        },
        {
          "ko": "Счёт",
          "es": "La «ё» se pronuncia [io] y lleva el acento: [shchiot]."
        }
      ],
      "newItems": [
        "рис",
        "кофе",
        "Я хочу это.",
        "Счёт, пожалуйста."
      ]
    },
    {
      "lessonId": "russian-a11-food-03",
      "title": "Comida en familia",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Анна, вы хотите рис?",
          "translation": "Ana, ¿quiere arroz?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, я хочу немного риса, пожалуйста.",
          "translation": "Sí, quiero un poco de arroz, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "И яблоко?",
          "translation": "¿Y una manzana?",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, спасибо. Я люблю яблоки.",
          "translation": "Sí, gracias. Me encantan las manzanas.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Мама, хочешь чай?",
          "translation": "Mamá, ¿quieres té?",
          "gender": "m"
        },
        {
          "speaker": "Ольга Петровна",
          "speakerEs": "Mamá de Misha",
          "text": "Нет, Миша. Утром я пью чай, а сейчас хочу кофе.",
          "translation": "No, Misha. Bebo té por la mañana; ahora quiero café.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Я тоже хочу кофе!",
          "translation": "¡Yo también quiero café!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "немного риса",
          "es": "Después de «немного» (un poco) el sustantivo va en genitivo: рис → риса."
        },
        {
          "ko": "яблоко",
          "es": "Neutro; plural: яблоки."
        },
        {
          "ko": "Утром я пью чай",
          "es": "«Утром» = por la mañana. El orden de palabras es libre: se pone primero lo que da el contexto."
        },
        {
          "ko": "Мама, хочешь",
          "es": "Misha tutea a su madre; Ana le habla de «вы»."
        }
      ],
      "newItems": [
        "чай",
        "яблоко",
        "Утром я пью чай.",
        "Я хочу немного риса."
      ]
    },
    {
      "lessonId": "russian-a11-food-04",
      "title": "En el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "Продавщица",
          "speakerEs": "Vendedora",
          "text": "Девушка, мясо хотите? Очень хорошее мясо.",
          "translation": "Señorita, ¿quiere carne? Carne muy buena.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Нет, спасибо. Я не ем мясо.",
          "translation": "No, gracias. No como carne.",
          "gender": "f"
        },
        {
          "speaker": "Продавщица",
          "speakerEs": "Vendedora",
          "text": "Тогда овощи? Вот хорошие овощи.",
          "translation": "¿Entonces verduras? Aquí tiene buenas verduras.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, овощи, пожалуйста. И яблоки.",
          "translation": "Sí, verduras, por favor. Y manzanas.",
          "gender": "f"
        },
        {
          "speaker": "Продавщица",
          "speakerEs": "Vendedora",
          "text": "Попробуйте это яблоко.",
          "translation": "Pruebe esta manzana.",
          "gender": "f"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "М-м-м! Это яблоко очень вкусное!",
          "translation": "¡Mmm! ¡Esta manzana está deliciosa!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, ты не ешь мясо?",
          "translation": "Ana, ¿no comes carne?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Нет. Я ем овощи, рис и фрукты.",
          "translation": "No. Como verduras, arroz y fruta.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Это яблоко очень вкусное",
          "es": "«Это» aquí es adjetivo demostrativo («esta manzana»), y «вкусное» concuerda con «яблоко», que es neutro."
        },
        {
          "ko": "мясо",
          "es": "Neutro. Tras «не ем» puede ir en acusativo (мясо) o, más formal, en genitivo (мяса)."
        },
        {
          "ko": "овощи",
          "es": "Casi siempre en plural: «las verduras»."
        },
        {
          "ko": "Попробуйте",
          "es": "Imperativo de cortesía de «попробовать» (probar)."
        }
      ],
      "newItems": [
        "мясо",
        "овощи",
        "Это яблоко очень вкусное.",
        "Я не ем мясо."
      ]
    }
  ]
}
