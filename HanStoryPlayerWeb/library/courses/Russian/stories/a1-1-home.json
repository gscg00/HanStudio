{
  "unitId": "a1-1-home",
  "stories": [
    {
      "lessonId": "russian-a11-home-01",
      "title": "¿Dónde está el teléfono?",
      "scene": "home",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, это твой дом?",
          "translation": "Ana, ¿esta es tu casa?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да. А это моя комната.",
          "translation": "Sí. Y esta es mi habitación.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Хорошая комната! Ой, а где мой телефон?",
          "translation": "¡Qué buena habitación! Uy, ¿y mi teléfono?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Твой телефон? Где он?",
          "translation": "¿Tu teléfono? ¿Dónde está?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Я не знаю…",
          "translation": "No sé…",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Вот он! У тебя в руке!",
          "translation": "¡Aquí está! ¡En tu mano!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Ой… Спасибо, Анна!",
          "translation": "Uy… ¡Gracias, Ana!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Где он?",
          "es": "No existe «ello»: los objetos masculinos son «он», los femeninos «она», los neutros «оно». «Телефон» es masculino, así que «где он?»."
        },
        {
          "ko": "Вот он!",
          "es": "«Вот» = he aquí, aquí está (señalando). Muy útil: «Вот мой дом», «Вот он!»."
        },
        {
          "ko": "комната",
          "es": "La habitación en general; el dormitorio es «спальня»."
        },
        {
          "ko": "дом",
          "es": "«Дом» es la casa y también el edificio. Un piso o apartamento es «квартира»."
        }
      ],
      "newItems": [
        "дом",
        "комната",
        "Вот он.",
        "Где он?"
      ]
    },
    {
      "lessonId": "russian-a11-home-02",
      "title": "Otra vez el teléfono",
      "scene": "home",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Это кухня.",
          "translation": "Esta es la cocina.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Большая кухня! А где ванная?",
          "translation": "¡Qué cocina tan grande! ¿Y el baño?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ванная — там.",
          "translation": "El baño está allí.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Анна, это твоё?",
          "translation": "Ana, ¿esto es tuyo?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, это моё. Спасибо!",
          "translation": "Sí, es mío. ¡Gracias!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А где мой телефон? Его здесь нет…",
          "translation": "¿Y mi teléfono? Aquí no está…",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Опять, Миша? Может быть, на кухне?",
          "translation": "¿Otra vez, Misha? ¿Quizá en la cocina?",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Да, вот он! Спасибо!",
          "translation": "¡Sí, aquí está! ¡Gracias!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "ванная",
          "es": "Es un adjetivo usado como sustantivo («ванная комната», el cuarto del baño): por eso termina en «-ая»."
        },
        {
          "ko": "Это моё",
          "es": "Forma neutra: se usa para «esto es mío» cuando no se nombra el objeto."
        },
        {
          "ko": "Его здесь нет",
          "es": "«Нет» (no hay) exige genitivo: «он» → «его». Literalmente «de él aquí no hay»."
        },
        {
          "ko": "на кухне",
          "es": "Con «кухня» se usa «на» (no «в»): на кухне = en la cocina."
        }
      ],
      "newItems": [
        "кухня",
        "ванная",
        "Это моё.",
        "Его здесь нет."
      ]
    },
    {
      "lessonId": "russian-a11-home-03",
      "title": "Una habitación pequeña",
      "scene": "bedroom",
      "lines": [
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Можно?",
          "translation": "¿Se puede?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да, конечно. Моя комната маленькая.",
          "translation": "Sí, claro. Mi habitación es pequeña.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Но здесь есть стол и стул. Это хорошо!",
          "translation": "Pero aquí hay una mesa y una silla. ¡Está bien!",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Садись на стул, Миша.",
          "translation": "Siéntate en la silla, Misha.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Спасибо. Анна, а где ключ от дома?",
          "translation": "Gracias. Ana, ¿y la llave de casa?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ключ лежит на столе.",
          "translation": "La llave está sobre la mesa.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "А, вот он.",
          "translation": "Ah, aquí está.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "лежит",
          "es": "El ruso precisa la posición: un objeto plano o tumbado «лежит» (yace), uno de pie «стоит». En español simplemente decimos «está»."
        },
        {
          "ko": "на столе",
          "es": "«На» + prepositivo: стол → на столе (sobre la mesa)."
        },
        {
          "ko": "маленькая",
          "es": "El adjetivo concuerda: комната (fem.) → маленькая."
        },
        {
          "ko": "ключ от дома",
          "es": "«Ключ от…» = la llave de…: ключ от дома, ключ от двери."
        }
      ],
      "newItems": [
        "стол",
        "стул",
        "Ключ лежит на столе.",
        "Моя комната маленькая."
      ]
    },
    {
      "lessonId": "russian-a11-home-04",
      "title": "¡La puerta está abierta!",
      "scene": "home",
      "lines": [
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Миша, дверь открыта!",
          "translation": "¡Misha, la puerta está abierta!",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Открыта? А где ключ?",
          "translation": "¿Abierta? ¿Y la llave?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Ключ? Его здесь нет…",
          "translation": "¿La llave? Aquí no está…",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Вот он! Ключ в двери.",
          "translation": "¡Aquí está! La llave está en la puerta.",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Уф! Заходи, Миша.",
          "translation": "¡Uf! Pasa, Misha.",
          "gender": "f"
        },
        {
          "speaker": "Миша",
          "speakerEs": "Misha",
          "text": "Здесь два стула. Садимся?",
          "translation": "Aquí hay dos sillas. ¿Nos sentamos?",
          "gender": "m"
        },
        {
          "speaker": "Анна",
          "speakerEs": "Ana",
          "text": "Да. А я закрываю дверь.",
          "translation": "Sí. Y yo cierro la puerta.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "дверь",
          "es": "Termina en «ь» y es femenina: дверь открыта (no «открыт»)."
        },
        {
          "ko": "Дверь открыта",
          "es": "Forma corta del participio («abierta»), típica para describir un estado."
        },
        {
          "ko": "два стула",
          "es": "Tras «два» → genitivo singular: стул → два стула."
        },
        {
          "ko": "Заходи",
          "es": "«Pasa, entra» en forma de «ты». A alguien de usted: «Заходите»."
        }
      ],
      "newItems": [
        "дверь",
        "ключ",
        "Здесь два стула.",
        "Дверь открыта."
      ]
    }
  ]
}
