{
  "unitId": "a1-1-places",
  "stories": [
    {
      "lessonId": "portuguese-a11-places-01",
      "title": "El banco y la estación",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "João, onde fica a estação?",
          "translation": "João, ¿dónde queda la estación?",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Fica perto, ali.",
          "translation": "Está cerca, ahí.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "E o banco? Quero dinheiro.",
          "translation": "¿Y el banco? Necesito dinero.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "O banco também fica perto, ao lado da estação.",
          "translation": "El banco también está cerca, al lado de la estación.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Ótimo! Primeiro o banco, depois a estação.",
          "translation": "¡Estupendo! Primero el banco, después la estación.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Olha, o banco é ali.",
          "translation": "Mira, el banco está ahí.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Onde fica",
          "es": "Para lugares fijos (edificios, ciudades) se usa mucho «ficar»: «onde fica a estação?» = ¿dónde queda/está la estación?"
        },
        {
          "ko": "perto",
          "es": "«Perto» = cerca; «longe» = lejos."
        },
        {
          "ko": "banco",
          "es": "Como en español, «banco» es la entidad y también el asiento."
        },
        {
          "ko": "estação",
          "es": "La terminación «-ção» equivale a «-ción»: estação, nação, informação."
        }
      ],
      "newItems": [
        "estação",
        "banco",
        "Onde fica a estação?",
        "Fica perto."
      ]
    },
    {
      "lessonId": "portuguese-a11-places-02",
      "title": "Rumbo al hospital",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Desculpe! Onde fica o hospital?",
          "translation": "¡Disculpe! ¿Dónde está el hospital?",
          "gender": "f"
        },
        {
          "speaker": "Senhor",
          "speakerEs": "Señor",
          "text": "O hospital? Siga em frente.",
          "translation": "¿El hospital? Siga recto.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Em frente?",
          "translation": "¿Recto?",
          "gender": "f"
        },
        {
          "speaker": "Senhor",
          "speakerEs": "Señor",
          "text": "Sim, siga em frente. Fica depois daquela loja.",
          "translation": "Sí, siga recto. Está pasando aquella tienda.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Obrigada!",
          "translation": "¡Gracias!",
          "gender": "f"
        },
        {
          "speaker": "Senhor",
          "speakerEs": "Señor",
          "text": "De nada. Está doente?",
          "translation": "De nada. ¿Está enferma?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Não, a minha amiga trabalha no hospital.",
          "translation": "No, mi amiga trabaja en el hospital.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Desculpe",
          "es": "Forma de usted para llamar la atención o pedir perdón; a un amigo se le dice «desculpa»."
        },
        {
          "ko": "Siga em frente",
          "es": "«Em frente» = recto, todo derecho. «Siga» es el imperativo de usted de «seguir»."
        },
        {
          "ko": "loja",
          "es": "«Loja» = tienda (no confundir con «logia»)."
        },
        {
          "ko": "hospital",
          "es": "La h no se pronuncia y la l final suena casi como una u: «osh-pi-tau»."
        }
      ],
      "newItems": [
        "loja",
        "hospital",
        "Siga em frente.",
        "Desculpe."
      ]
    },
    {
      "lessonId": "portuguese-a11-places-03",
      "title": "Camino a la escuela",
      "scene": "park",
      "lines": [
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Ana, aonde vais?",
          "translation": "Ana, ¿adónde vas?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Vou para a escola. Tenho aula às nove.",
          "translation": "Voy a la escuela. Tengo clase a las nueve.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Eu vou para a estação. Vamos juntos?",
          "translation": "Yo voy a la estación. ¿Vamos juntos?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Sim! A escola fica ao lado do parque.",
          "translation": "¡Sí! La escuela está al lado del parque.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Olha, ali é o parque. A estação fica à esquerda.",
          "translation": "Mira, ahí está el parque. La estación está a la izquierda.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Então vamos pelo parque!",
          "translation": "¡Entonces vamos por el parque!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Boa ideia!",
          "translation": "¡Buena idea!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Vou para a escola",
          "es": "Con «ir», «para» indica destino (sobre todo si uno se queda allí). «Ir à escola» también es correcto."
        },
        {
          "ko": "à esquerda",
          "es": "«À» = a + a. «À esquerda» = a la izquierda; «à direita» = a la derecha."
        },
        {
          "ko": "aula",
          "es": "Falso amigo: «aula» es la clase (la lección), no el salón. El salón es «sala de aula»."
        },
        {
          "ko": "pelo parque",
          "es": "«Pelo» = por + o (por el)."
        }
      ],
      "newItems": [
        "escola",
        "parque",
        "A estação fica à esquerda.",
        "Vou para a escola."
      ]
    },
    {
      "lessonId": "portuguese-a11-places-04",
      "title": "¿Cómo llego al parque?",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Desculpe, como chego ao parque?",
          "translation": "Disculpe, ¿cómo llego al parque?",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "Siga em frente e depois vire à direita.",
          "translation": "Siga recto y después gire a la derecha.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "À direita?",
          "translation": "¿A la derecha?",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "Sim, à direita. O parque fica ao lado do banco.",
          "translation": "Sí, a la derecha. El parque está al lado del banco.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "E o banco fica perto?",
          "translation": "¿Y el banco queda cerca?",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "O banco fica perto, sim. São dois minutos.",
          "translation": "Sí, el banco está cerca. Son dos minutos.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Obrigada! À direita, não à esquerda.",
          "translation": "¡Gracias! A la derecha, no a la izquierda.",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "Isso mesmo. Bom passeio!",
          "translation": "Eso es. ¡Buen paseo!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "chego",
          "es": "«Chegar» = llegar (otra vez ch ↔ ll). «Como chego ao…?» es la pregunta típica para pedir el camino."
        },
        {
          "ko": "ao parque",
          "es": "«Ao» = a + o (al)."
        },
        {
          "ko": "direita",
          "es": "«Direita» = derecha. Ojo: «direito» también significa «derecho» (ley); para «todo recto» se dice «em frente»."
        },
        {
          "ko": "vire",
          "es": "Imperativo de usted de «virar» (girar, doblar)."
        }
      ],
      "newItems": [
        "esquerda",
        "direita",
        "O banco fica perto.",
        "Como chego ao parque?"
      ]
    }
  ]
}
