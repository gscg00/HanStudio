{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "portuguese-survival-01",
      "title": "Un día en el café",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Bom dia, João!",
          "translation": "¡Buenos días, João!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Olá, Ana! Bom dia!",
          "translation": "¡Hola, Ana! ¡Buenos días!",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Até logo!",
          "translation": "¡Hasta luego!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Boa tarde, Ana!",
          "translation": "¡Buenas tardes, Ana!",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Olá! Boa tarde!",
          "translation": "¡Hola! ¡Buenas tardes!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Boa noite, Ana!",
          "translation": "¡Buenas noches, Ana!",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Boa noite! Adeus, João!",
          "translation": "¡Buenas noches! ¡Adiós, João!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Adeus, Ana!",
          "translation": "¡Adiós, Ana!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Boa tarde",
          "es": "«Dia» es masculino (bom dia), pero «tarde» y «noite» son femeninos (boa tarde, boa noite). «Boa tarde» se usa desde el mediodía hasta que oscurece."
        },
        {
          "ko": "Boa noite",
          "es": "Como en español, sirve tanto para saludar al llegar de noche como para despedirse."
        },
        {
          "ko": "Adeus",
          "es": "En Portugal «adeus» es una despedida cotidiana, al salir de una tienda o al terminar una llamada; no suena dramático."
        },
        {
          "ko": "Até logo",
          "es": "«Hasta luego»: Ana se va pero volverá más tarde ese mismo día."
        }
      ],
      "newItems": [
        "bom dia",
        "olá",
        "até logo",
        "boa tarde",
        "boa noite",
        "adeus"
      ]
    },
    {
      "lessonId": "portuguese-survival-02",
      "title": "La llave en el autobús",
      "scene": "bus",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Com licença.",
          "translation": "Con permiso.",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "Ah, desculpe!",
          "translation": "¡Ay, disculpe!",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Obrigada.",
          "translation": "Gracias.",
          "gender": "f"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "De nada.",
          "translation": "De nada.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Desculpe... a chave, por favor.",
          "translation": "Disculpe... la llave, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "A chave? Ah, sim!",
          "translation": "¿La llave? ¡Ah, sí!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Obrigado!",
          "translation": "¡Gracias!",
          "gender": "m"
        },
        {
          "speaker": "Senhora",
          "speakerEs": "Señora",
          "text": "De nada.",
          "translation": "De nada.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Obrigada",
          "es": "La forma depende de quién da las gracias, no de a quién: Ana (mujer) dice «obrigada»; João (hombre) dice «obrigado»."
        },
        {
          "ko": "Com licença",
          "es": "Se dice para pasar entre la gente o pedir permiso, igual que «con permiso» en México."
        },
        {
          "ko": "Desculpe",
          "es": "«Disculpe»: sirve para pedir perdón y también para llamar la atención de alguien antes de pedirle algo."
        },
        {
          "ko": "a chave",
          "es": "«La llave». En portugués «chave» es femenina, como en español."
        }
      ],
      "newItems": [
        "Com licença.",
        "Desculpe.",
        "Obrigada.",
        "De nada.",
        "Por favor.",
        "Obrigado."
      ]
    },
    {
      "lessonId": "portuguese-survival-03",
      "title": "Los papás de João",
      "scene": "home",
      "lines": [
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Olá, Ana! Como estás?",
          "translation": "¡Hola, Ana! ¿Cómo estás?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Estou bem, obrigada. E tu?",
          "translation": "Estoy bien, gracias. ¿Y tú?",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Estou bem, obrigado.",
          "translation": "Estoy bien, gracias.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Bom dia, Senhor Rui! Como está o senhor?",
          "translation": "¡Buenos días, señor Rui! ¿Cómo está usted?",
          "gender": "f"
        },
        {
          "speaker": "Senhor Rui",
          "speakerEs": "Papá de João",
          "text": "Estou bem, obrigado.",
          "translation": "Estoy bien, gracias.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "E a senhora, Dona Teresa? Como está?",
          "translation": "¿Y usted, doña Teresa? ¿Cómo está?",
          "gender": "f"
        },
        {
          "speaker": "Dona Teresa",
          "speakerEs": "Mamá de João",
          "text": "Bem, obrigada. E tu, Ana?",
          "translation": "Bien, gracias. ¿Y tú, Ana?",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Estou bem, obrigada!",
          "translation": "¡Estoy bien, gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "Como está?",
          "es": "«Como estás?» es de «tu»: para amigos como João. «Como está?» es de usted: Ana lo usa con los papás de João."
        },
        {
          "ko": "Como está o senhor?",
          "es": "En Portugal se trata de usted con «o senhor» (a un hombre) y «a senhora» (a una mujer), con el verbo en tercera persona. Es lo más cortés con adultos."
        },
        {
          "ko": "E tu?",
          "es": "Los papás de João tratan de «tu» a Ana porque es joven y amiga de su hijo; ella, en cambio, les habla de usted."
        },
        {
          "ko": "Estou bem, obrigado.",
          "es": "João y el señor Rui dicen «obrigado»; Ana y doña Teresa, «obrigada»."
        }
      ],
      "newItems": [
        "Como estás?",
        "tu",
        "Estou bem, obrigado.",
        "o senhor",
        "a senhora",
        "Como está?"
      ]
    },
    {
      "lessonId": "portuguese-survival-04",
      "title": "¿Dónde está el baño?",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "João, onde é a casa de banho?",
          "translation": "João, ¿dónde está el baño?",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Não sei.",
          "translation": "No sé.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Desculpe, onde é a casa de banho?",
          "translation": "Disculpe, ¿dónde está el baño?",
          "gender": "f"
        },
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "É ali ao fundo, à direita.",
          "translation": "Está allá al fondo, a la derecha.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Desculpe, não compreendo. Pode repetir, por favor?",
          "translation": "Disculpe, no entiendo. ¿Puede repetir, por favor?",
          "gender": "f"
        },
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "Ao fundo, à direita.",
          "translation": "Al fondo, a la derecha.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Fale mais devagar, por favor.",
          "translation": "Hable más despacio, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "Ao... fundo... à... direita.",
          "translation": "Al... fondo... a la... derecha.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Ah, sim! Obrigada.",
          "translation": "¡Ah, sí! Gracias.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "casa de banho",
          "es": "Así se dice «baño» en Portugal. En Brasil se dice «banheiro»."
        },
        {
          "ko": "onde é",
          "es": "Para preguntar dónde está un lugar fijo, en Portugal se usa mucho «onde é» (con el verbo «ser»), además de «onde fica»."
        },
        {
          "ko": "Pode repetir, por favor?",
          "es": "Fórmula de usted, sin pronombre: perfecta con desconocidos. «Fale mais devagar» también es de usted."
        },
        {
          "ko": "não compreendo",
          "es": "«No entiendo». En Portugal «compreender» es muy común; «não percebo» es otra forma muy portuguesa."
        }
      ],
      "newItems": [
        "Onde é a casa de banho?",
        "Não sei.",
        "Não compreendo.",
        "Pode repetir, por favor?",
        "Fale mais devagar, por favor.",
        "Sim."
      ]
    }
  ]
}
