{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "portuguese-a11-food-01",
      "title": "Hambre y sed",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "João, tenho fome!",
          "translation": "¡João, tengo hambre!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Há pão na cozinha.",
          "translation": "Hay pan en la cocina.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Pão? Só pão?",
          "translation": "¿Pan? ¿Solo pan?",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Pão com queijo!",
          "translation": "¡Pan con queso!",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Ótimo. E também tenho sede.",
          "translation": "Estupendo. Y también tengo sed.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Queres água?",
          "translation": "¿Quieres agua?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Sim, água, por favor.",
          "translation": "Sí, agua, por favor.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Aqui está: pão, queijo e água.",
          "translation": "Aquí tienes: pan, queso y agua.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Tenho fome / Tenho sede",
          "es": "Igual que en español: «tener» + sustantivo. «Fome» = hambre, «sede» = sed."
        },
        {
          "ko": "pão",
          "es": "La terminación «-ão» es nasal: se pronuncia como un diptongo «aum» por la nariz."
        },
        {
          "ko": "Queres água?",
          "es": "«Queres» es la forma de «tu» de «querer». «Água» es femenina: a água."
        }
      ],
      "newItems": [
        "água",
        "pão",
        "Tenho fome.",
        "Tenho sede."
      ]
    },
    {
      "lessonId": "portuguese-a11-food-02",
      "title": "En el restaurante",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "Boa tarde. O que desejam?",
          "translation": "Buenas tardes. ¿Qué desean?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Queria isto, por favor.",
          "translation": "Quisiera esto, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "O arroz? Muito bem. E o senhor?",
          "translation": "¿El arroz? Muy bien. ¿Y usted?",
          "gender": "m"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Também arroz. E dois cafés, por favor.",
          "translation": "También arroz. Y dos cafés, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "João, o café aqui é muito pequeno!",
          "translation": "¡João, el café aquí es muy pequeño!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Em Lisboa chama-se bica. É assim!",
          "translation": "En Lisboa se llama «bica». ¡Es así!",
          "gender": "m"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "A conta, por favor.",
          "translation": "La cuenta, por favor.",
          "gender": "m"
        },
        {
          "speaker": "Empregado",
          "speakerEs": "Mesero",
          "text": "Aqui está. São dez euros.",
          "translation": "Aquí tiene. Son diez euros.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "Quero isto",
          "es": "«Isto» = esto (cerca de mí), «isso» = eso (cerca de ti). Señalando el menú se dice «quero isto»."
        },
        {
          "ko": "o senhor",
          "es": "El camarero trata a João de «o senhor» (usted)."
        },
        {
          "ko": "bica",
          "es": "En Lisboa el expreso se llama «bica»; en Oporto, «cimbalino». Pedir «um café» también funciona en todo el país."
        },
        {
          "ko": "A conta, por favor",
          "es": "Así se pide la cuenta. Ojo: «conta» también es «cuenta» bancaria."
        }
      ],
      "newItems": [
        "arroz",
        "café",
        "Quero isto.",
        "A conta, por favor."
      ]
    },
    {
      "lessonId": "portuguese-a11-food-03",
      "title": "Comida en familia",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Dona Teresa",
          "speakerEs": "Mamá de João",
          "text": "Ana, queres arroz?",
          "translation": "Ana, ¿quieres arroz?",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Quero um pouco de arroz, por favor.",
          "translation": "Quiero un poco de arroz, por favor.",
          "gender": "f"
        },
        {
          "speaker": "Dona Teresa",
          "speakerEs": "Mamá de João",
          "text": "E uma maçã?",
          "translation": "¿Y una manzana?",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Sim, obrigada. Gosto muito de maçãs.",
          "translation": "Sí, gracias. Me gustan mucho las manzanas.",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Mãe, queres um chá?",
          "translation": "Mamá, ¿quieres un té?",
          "gender": "m"
        },
        {
          "speaker": "Dona Teresa",
          "speakerEs": "Mamá de João",
          "text": "Não, filho. Bebo chá de manhã. Agora quero um café.",
          "translation": "No, hijo. Bebo té por la mañana. Ahora quiero un café.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Eu também quero um café!",
          "translation": "¡Yo también quiero un café!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "um pouco de arroz",
          "es": "«Um pouco de» = un poco de, igual que en español."
        },
        {
          "ko": "Gosto muito de maçãs",
          "es": "«Gostar» funciona al revés que «gustar»: el sujeto es quien gusta y lleva «de»: «eu gosto de maçãs» = me gustan las manzanas."
        },
        {
          "ko": "maçã",
          "es": "Dos marcas: la ç suena como s, y la ã es nasal: ma-SÃ."
        },
        {
          "ko": "Mãe, queres",
          "es": "Entre familia se tutea: João habla de «tu» con su madre, mientras Ana le dice «a senhora»."
        }
      ],
      "newItems": [
        "chá",
        "maçã",
        "Bebo chá de manhã.",
        "Quero um pouco de arroz."
      ]
    },
    {
      "lessonId": "portuguese-a11-food-04",
      "title": "En el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "Vendedora",
          "speakerEs": "Vendedora",
          "text": "Bom dia! Quer carne? Tenho carne muito boa.",
          "translation": "¡Buenos días! ¿Quiere carne? Tengo carne muy buena.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Não, obrigada. Não como carne.",
          "translation": "No, gracias. No como carne.",
          "gender": "f"
        },
        {
          "speaker": "Vendedora",
          "speakerEs": "Vendedora",
          "text": "Então, legumes? Temos legumes frescos.",
          "translation": "¿Entonces verduras? Tenemos verduras frescas.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Sim, legumes, por favor. E maçãs.",
          "translation": "Sí, verduras, por favor. Y manzanas.",
          "gender": "f"
        },
        {
          "speaker": "Vendedora",
          "speakerEs": "Vendedora",
          "text": "Prove esta maçã.",
          "translation": "Pruebe esta manzana.",
          "gender": "f"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Hum! Esta maçã é deliciosa!",
          "translation": "¡Mmm! ¡Esta manzana está deliciosa!",
          "gender": "f"
        },
        {
          "speaker": "João",
          "speakerEs": "João",
          "text": "Ana, tu não comes carne?",
          "translation": "Ana, ¿tú no comes carne?",
          "gender": "m"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "text": "Não. Como legumes, arroz e fruta.",
          "translation": "No. Como verduras, arroz y fruta.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "legumes",
          "es": "Falso amigo: «legumes» son las verduras/hortalizas, no las legumbres (que en portugués se llaman «leguminosas»)."
        },
        {
          "ko": "Esta maçã é deliciosa",
          "es": "En portugués se usa «ser» para valorar la comida, donde en español decimos «está deliciosa»."
        },
        {
          "ko": "Quer carne?",
          "es": "La vendedora habla de usted: verbo en 3.ª persona sin pronombre."
        },
        {
          "ko": "Prove",
          "es": "«Provar» = probar (comida). «Prove» = pruebe (usted)."
        }
      ],
      "newItems": [
        "carne",
        "legumes",
        "Esta maçã é deliciosa.",
        "Não como carne."
      ]
    }
  ]
}
