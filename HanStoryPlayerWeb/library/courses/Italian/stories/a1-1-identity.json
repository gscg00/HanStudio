{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "italian-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Buongiorno! Sono la professoressa Rossi.",
          "translation": "¡Buenos días! Soy la profesora Rossi."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Buongiorno! Mi chiamo Ana.",
          "translation": "¡Buenos días! Me llamo Ana."
        },
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Piacere, Ana.",
          "translation": "Mucho gusto, Ana."
        },
        {
          "speaker": "Kenji",
          "speakerEs": "Kenji",
          "gender": "m",
          "text": "Ciao! Io mi chiamo Kenji.",
          "translation": "¡Hola! Yo me llamo Kenji."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ciao, Kenji! Piacere.",
          "translation": "¡Hola, Kenji! Mucho gusto."
        },
        {
          "speaker": "Kenji",
          "speakerEs": "Kenji",
          "gender": "m",
          "text": "Piacere mio!",
          "translation": "¡El gusto es mío!"
        },
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Bene! Ciao a tutti e benvenuti al corso!",
          "translation": "¡Bien! Hola a todos y bienvenidos al curso."
        }
      ],
      "notes": [
        {
          "ko": "Buongiorno",
          "es": "Se usa en la mañana y hasta media tarde. Es una sola palabra."
        },
        {
          "ko": "Piacere",
          "es": "«Mucho gusto». Para responder: «Piacere mio» (el gusto es mío)."
        },
        {
          "ko": "Ciao",
          "es": "Ana usa buongiorno con la profesora y ciao con Kenji, un compañero. La profesora puede decir «ciao a tutti» al grupo."
        }
      ],
      "newItems": [
        "ciao",
        "buongiorno",
        "Mi chiamo Ana.",
        "Piacere."
      ]
    },
    {
      "lessonId": "italian-a11-identity-02",
      "title": "Cena en la trattoria",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Cameriera",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Buonasera!",
          "translation": "¡Buenas noches!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Buonasera! Un tavolo per due, per favore.",
          "translation": "¡Buenas noches! Una mesa para dos, por favor."
        },
        {
          "speaker": "Cameriera",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Prego, da questa parte. Ecco il menù.",
          "translation": "Pasen, por aquí. Aquí tienen la carta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Grazie. Un'acqua naturale, per favore.",
          "translation": "Gracias. Un agua sin gas, por favor."
        },
        {
          "speaker": "Cameriera",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Ecco a lei.",
          "translation": "Aquí tiene."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Grazie!",
          "translation": "¡Gracias!"
        },
        {
          "speaker": "Cameriera",
          "speakerEs": "Mesera",
          "gender": "f",
          "text": "Arrivederci e buonasera!",
          "translation": "¡Hasta luego y que pasen buena noche!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Arrivederci!",
          "translation": "¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "Buonasera",
          "es": "Se dice desde media tarde (más o menos las 4 o 5) para saludar y despedirse. Buonanotte solo se usa al irse a dormir."
        },
        {
          "ko": "Arrivederci",
          "es": "Literalmente «hasta volver a vernos». Más formal: ArrivederLa; informal: ciao."
        },
        {
          "ko": "per favore",
          "es": "per favore = por favor. Para responder a grazie se dice prego."
        }
      ],
      "newItems": [
        "buonasera",
        "arrivederci",
        "Grazie.",
        "Per favore."
      ]
    },
    {
      "lessonId": "italian-a11-identity-03",
      "title": "Intercambio de idiomas",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Sofia",
          "speakerEs": "Sofía",
          "gender": "f",
          "text": "Ciao! Come ti chiami?",
          "translation": "¡Hola! ¿Cómo te llamas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mi chiamo Ana. E tu?",
          "translation": "Me llamo Ana. ¿Y tú?"
        },
        {
          "speaker": "Sofia",
          "speakerEs": "Sofía",
          "gender": "f",
          "text": "Sofia. Scrivi qui il tuo nome, per lo scambio linguistico.",
          "translation": "Sofía. Escribe aquí tu nombre, para el intercambio de idiomas."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ecco: nome, Ana López. E il paese?",
          "translation": "Listo: nombre, Ana López. ¿Y el país?"
        },
        {
          "speaker": "Sofia",
          "speakerEs": "Sofía",
          "gender": "f",
          "text": "Sì, il tuo paese. Di dove sei?",
          "translation": "Sí, tu país. ¿De dónde eres?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Vengo dal Messico.",
          "translation": "Vengo de México."
        },
        {
          "speaker": "Sofia",
          "speakerEs": "Sofía",
          "gender": "f",
          "text": "Dal Messico! Io studio spagnolo!",
          "translation": "¡De México! ¡Yo estudio español!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Perfetto! Tu parli spagnolo e io parlo italiano!",
          "translation": "¡Perfecto! ¡Tú hablas español y yo italiano!"
        }
      ],
      "notes": [
        {
          "ko": "Come ti chiami?",
          "es": "Forma de tú. De usted: «Come si chiama?»."
        },
        {
          "ko": "Vengo dal Messico.",
          "es": "venire da + artículo: dal = da + il. Es la forma más natural de decir de qué país eres."
        },
        {
          "ko": "paese",
          "es": "il paese = país, pero también pueblo («un paese in Toscana»)."
        },
        {
          "ko": "nome",
          "es": "il nome = el nombre de pila; el apellido es il cognome."
        }
      ],
      "newItems": [
        "nome",
        "paese",
        "Come ti chiami?",
        "Vengo dal Messico."
      ]
    },
    {
      "lessonId": "italian-a11-identity-04",
      "title": "En la fiesta",
      "scene": "party",
      "lines": [
        {
          "speaker": "Chiara",
          "speakerEs": "Chiara",
          "gender": "f",
          "text": "Ciao! Sei Ana, l'amica messicana di Marco?",
          "translation": "¡Hola! ¿Eres Ana, la amiga mexicana de Marco?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì! Ciao!",
          "translation": "¡Sí! ¡Hola!"
        },
        {
          "speaker": "Chiara",
          "speakerEs": "Chiara",
          "gender": "f",
          "text": "Che bello! Parli italiano?",
          "translation": "¡Qué bien! ¿Hablas italiano?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Parlo un po’ d’italiano.",
          "translation": "Hablo un poco de italiano."
        },
        {
          "speaker": "Chiara",
          "speakerEs": "Chiara",
          "gender": "f",
          "text": "Ah, fantastico, l'anno scorso sono stata a Città del Messico e mi è piaciuta da morire!",
          "translation": "Ah, fantástico, el año pasado estuve en la Ciudad de México y me encantó."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Scusa… non capisco.",
          "translation": "Perdón… no entiendo."
        },
        {
          "speaker": "Chiara",
          "speakerEs": "Chiara",
          "gender": "f",
          "text": "Tranquilla! Che lingua parli? Inglese?",
          "translation": "¡Tranquila! ¿Qué idioma hablas? ¿Inglés?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Spagnolo. E un po’ d’italiano!",
          "translation": "Español. ¡Y un poco de italiano!"
        },
        {
          "speaker": "Chiara",
          "speakerEs": "Chiara",
          "gender": "f",
          "text": "Brava! Sei la prima persona messicana alla festa!",
          "translation": "¡Bravo! ¡Eres la primera persona mexicana en la fiesta!"
        }
      ],
      "notes": [
        {
          "ko": "un po’",
          "es": "po’ es la forma cortada de poco; por eso lleva apóstrofo, no acento."
        },
        {
          "ko": "Scusa",
          "es": "scusa = perdón (a quien tratas de tú); scusi = perdone (de usted)."
        },
        {
          "ko": "lingua",
          "es": "la lingua = idioma y también lengua (el órgano). Los idiomas van con minúscula: italiano, spagnolo."
        },
        {
          "ko": "la prima persona",
          "es": "persona es siempre femenino, también si se habla de un hombre."
        }
      ],
      "newItems": [
        "lingua",
        "persona",
        "Parlo un po’ d’italiano.",
        "Non capisco."
      ]
    }
  ]
}
