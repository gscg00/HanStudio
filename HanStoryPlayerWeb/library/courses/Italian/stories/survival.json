{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "italian-survival-01",
      "title": "Llegada a Roma",
      "scene": "airport",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ciao, Ana! Benvenuta a Roma!",
          "translation": "¡Hola, Ana! ¡Bienvenida a Roma!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ciao, Marco! Un attimo… Buongiorno! Dov'è il bagno?",
          "translation": "¡Hola, Marco! Un segundo… ¡Buenos días! ¿Dónde está el baño?"
        },
        {
          "speaker": "Barista",
          "speakerEs": "Barista",
          "gender": "m",
          "text": "In fondo a destra, dopo le scale.",
          "translation": "Al fondo a la derecha, después de las escaleras."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Non capisco. Può ripetere?",
          "translation": "No entiendo. ¿Puede repetir?"
        },
        {
          "speaker": "Barista",
          "speakerEs": "Barista",
          "gender": "m",
          "text": "In fondo… a destra!",
          "translation": "Al fondo… ¡a la derecha!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah, grazie! E l'acqua? Quanto costa?",
          "translation": "¡Ah, gracias! ¿Y el agua? ¿Cuánto cuesta?"
        },
        {
          "speaker": "Barista",
          "speakerEs": "Barista",
          "gender": "m",
          "text": "Un euro.",
          "translation": "Un euro."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Perfetto! Marco, un'acqua per te?",
          "translation": "¡Perfecto! Marco, ¿un agua para ti?"
        }
      ],
      "notes": [
        {
          "ko": "Ciao",
          "es": "ciao sirve para saludar y para despedirse, pero solo en confianza (amigos, familia, gente joven)."
        },
        {
          "ko": "Può ripetere?",
          "es": "Può es la forma de Lei (usted). Ana la usa con el barista, un desconocido. A un amigo le diría «Puoi ripetere?»."
        },
        {
          "ko": "Dov'è",
          "es": "dov'è = dove + è (dónde + está). El apóstrofo marca la vocal que se cae."
        },
        {
          "ko": "Quanto costa?",
          "es": "Pregunta básica de precio. En plural: «Quanto costano?»."
        }
      ],
      "newItems": [
        "Ciao!",
        "Non capisco.",
        "Può ripetere?",
        "Dov'è il bagno?",
        "Quanto costa?"
      ]
    },
    {
      "lessonId": "italian-survival-02",
      "title": "Ana y Anna",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Buongiorno! Mi può aiutare?",
          "translation": "¡Buenos días! ¿Me puede ayudar?"
        },
        {
          "speaker": "Cameriere",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Certo! Cosa le porto? Abbiamo cornetti, tramezzini, spremute…",
          "translation": "¡Claro! ¿Qué le traigo? Tenemos cuernitos, sándwiches, jugos…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Parli più lentamente, per favore.",
          "translation": "Hable más despacio, por favor."
        },
        {
          "speaker": "Cameriere",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Cosa… desidera?",
          "translation": "¿Qué… desea?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah! Vorrei dell'acqua.",
          "translation": "¡Ah! Quisiera agua."
        },
        {
          "speaker": "Anna",
          "speakerEs": "Anna",
          "gender": "f",
          "text": "Ciao! Mi chiamo Anna. E tu, come ti chiami?",
          "translation": "¡Hola! Me llamo Anna. ¿Y tú, cómo te llamas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Anch'io mi chiamo Ana! Con una enne.",
          "translation": "¡Yo también me llamo Ana! Con una sola ene."
        },
        {
          "speaker": "Anna",
          "speakerEs": "Anna",
          "gender": "f",
          "text": "Ana e Anna! Che bello!",
          "translation": "¡Ana y Anna! ¡Qué padre!"
        }
      ],
      "notes": [
        {
          "ko": "Parli più lentamente",
          "es": "Parli es el imperativo de Lei (usted): «hable». Con un amigo sería «parla»."
        },
        {
          "ko": "Vorrei dell'acqua",
          "es": "vorrei (quisiera) es la forma cortés de pedir. dell' = di + l': «algo de agua» (partitivo)."
        },
        {
          "ko": "Ana e Anna",
          "es": "¡Atención! En italiano las dobles se pronuncian dobles, alargando la consonante: Ana y Anna (An-na) suenan distinto."
        },
        {
          "ko": "Come ti chiami?",
          "es": "Se usa chiamarsi, igual que «llamarse»: mi chiamo, ti chiami. La ch suena como k."
        }
      ],
      "newItems": [
        "Parli più lentamente.",
        "Mi può aiutare?",
        "Vorrei dell'acqua.",
        "Mi chiamo Anna.",
        "Come ti chiami?"
      ]
    },
    {
      "lessonId": "italian-survival-03",
      "title": "Un número italiano",
      "scene": "shop",
      "lines": [
        {
          "speaker": "Commesso",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Buongiorno! Di dov'è?",
          "translation": "¡Buenos días! ¿De dónde es usted?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sono del Messico.",
          "translation": "Soy de México."
        },
        {
          "speaker": "Commesso",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Dal Messico! Bello! Ecco il suo nuovo numero.",
          "translation": "¡De México! ¡Qué bien! Aquí está su nuevo número."
        },
        {
          "speaker": "Commesso",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Tre, tre, zero, uno, due…",
          "translation": "Tres, tres, cero, uno, dos…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Tre, tre, zero, due, uno?",
          "translation": "¿Tres, tres, cero, dos, uno?"
        },
        {
          "speaker": "Commesso",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "No: zero, uno, due.",
          "translation": "No: cero, uno, dos."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah! Tre, tre, zero, uno, due. Grazie!",
          "translation": "¡Ah! Tres, tres, cero, uno, dos. ¡Gracias!"
        },
        {
          "speaker": "Commesso",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Prego!",
          "translation": "¡De nada!"
        }
      ],
      "notes": [
        {
          "ko": "Sono del Messico.",
          "es": "Muchos italianos dirían «Sono messicana» o «Vengo dal Messico». del = di + il: México lleva artículo en italiano (il Messico)."
        },
        {
          "ko": "Di dov'è?",
          "es": "«¿De dónde es (usted)?». Con un amigo: «Di dove sei?»."
        },
        {
          "ko": "Tre, tre",
          "es": "En Italia los celulares empiezan por 3 (333, 347…). Los números se dictan cifra por cifra."
        },
        {
          "ko": "Prego!",
          "es": "prego = de nada. También significa «adelante», «pase» o «¿qué desea?»."
        }
      ],
      "newItems": [
        "Sono del Messico.",
        "zero",
        "uno",
        "due",
        "tre"
      ]
    },
    {
      "lessonId": "italian-survival-04",
      "title": "En el puesto de fruta",
      "scene": "market",
      "lines": [
        {
          "speaker": "Fruttivendolo",
          "speakerEs": "Frutero",
          "gender": "m",
          "text": "Buongiorno, signorina! Cosa le do?",
          "translation": "¡Buenos días, señorita! ¿Qué le doy?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Quattro pesche, per favore.",
          "translation": "Cuatro duraznos, por favor."
        },
        {
          "speaker": "Fruttivendolo",
          "speakerEs": "Frutero",
          "gender": "m",
          "text": "Quattro? Ne prenda cinque, sono buonissime!",
          "translation": "¿Cuatro? Llévese cinco, ¡están buenísimos!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Va bene, cinque. Quanto costa?",
          "translation": "Está bien, cinco. ¿Cuánto es?"
        },
        {
          "speaker": "Fruttivendolo",
          "speakerEs": "Frutero",
          "gender": "m",
          "text": "Sei euro.",
          "translation": "Seis euros."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ecco otto euro.",
          "translation": "Aquí tiene ocho euros."
        },
        {
          "speaker": "Fruttivendolo",
          "speakerEs": "Frutero",
          "gender": "m",
          "text": "Due di resto. Grazie! Siamo qui tutti i giorni, dalle sette.",
          "translation": "Dos de cambio. ¡Gracias! Estamos aquí todos los días, desde las siete."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Perfetto! Arrivederci!",
          "translation": "¡Perfecto! ¡Hasta luego!"
        }
      ],
      "notes": [
        {
          "ko": "pesche",
          "es": "la pesca = durazno (melocotón). Ojo: pesca también significa «pesca» (de pescar)."
        },
        {
          "ko": "cinque",
          "es": "Ci se pronuncia «chi»: cinque suena «chínkue»."
        },
        {
          "ko": "Sei",
          "es": "sei = seis, pero también «(tú) eres»: tu sei. El contexto lo aclara."
        },
        {
          "ko": "Cosa le do?",
          "es": "«¿Qué le doy?». El vendedor usa le, de Lei (usted). Es la frase típica de los puestos del mercado."
        }
      ],
      "newItems": [
        "quattro",
        "cinque",
        "sei",
        "sette",
        "otto"
      ]
    },
    {
      "lessonId": "italian-survival-05",
      "title": "La habitación trece",
      "scene": "home",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Che camera hai all'ostello?",
          "translation": "¿Qué cuarto tienes en el hostal?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "La tredici.",
          "translation": "El trece."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Qui c'è la nove, la dieci…",
          "translation": "Aquí está el nueve, el diez…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Undici, dodici… e tredici!",
          "translation": "Once, doce… ¡y trece!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Tredici? Che sfortuna!",
          "translation": "¿Trece? ¡Qué mala suerte!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "No, in Italia il tredici porta fortuna!",
          "translation": "¡No, en Italia el trece trae buena suerte!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Davvero? E il numero sfortunato?",
          "translation": "¿De veras? ¿Y el número de la mala suerte?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Il diciassette!",
          "translation": "¡El diecisiete!"
        }
      ],
      "notes": [
        {
          "ko": "La tredici",
          "es": "Se dice la tredici porque se sobreentiende la camera (el cuarto, femenino)."
        },
        {
          "ko": "dodici",
          "es": "Ci suena «chi»: dodici = «dódichi», undici = «úndichi»."
        },
        {
          "ko": "il tredici porta fortuna",
          "es": "En Italia el 13 es de buena suerte y el 17 de mala (en romano XVII se puede reordenar como VIXI, «he vivido», es decir, «estoy muerto»)."
        },
        {
          "ko": "Che sfortuna!",
          "es": "La s- delante de una palabra le da sentido contrario: fortuna → sfortuna (mala suerte)."
        }
      ],
      "newItems": [
        "nove",
        "dieci",
        "undici",
        "dodici",
        "tredici"
      ]
    },
    {
      "lessonId": "italian-survival-06",
      "title": "Página catorce",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Buongiorno a tutti! Pagina quattordici.",
          "translation": "¡Buenos días a todos! Página catorce."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Quattordici o quaranta?",
          "translation": "¿Catorce o cuarenta?"
        },
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Quattordici: uno, quattro.",
          "translation": "Catorce: uno, cuatro."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Grazie. E gli esercizi?",
          "translation": "Gracias. ¿Y los ejercicios?"
        },
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Esercizi quindici e sedici.",
          "translation": "Ejercicios quince y dieciséis."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E il diciassette e il diciotto?",
          "translation": "¿Y el diecisiete y el dieciocho?"
        },
        {
          "speaker": "Prof.ssa Rossi",
          "speakerEs": "Profesora Rossi",
          "gender": "f",
          "text": "Quelli sono compiti per casa!",
          "translation": "¡Esos son tarea!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oh no!",
          "translation": "¡Oh, no!"
        }
      ],
      "notes": [
        {
          "ko": "quattordici, quindici, sedici",
          "es": "Del 11 al 16 el número termina en -dici (diez): quattor-dici, quin-dici, se-dici."
        },
        {
          "ko": "diciassette, diciotto",
          "es": "Desde el 17 se invierte el orden: dici + sette, dici + otto, como en español «dieci-siete»."
        },
        {
          "ko": "compiti per casa",
          "es": "i compiti (per casa) = la tarea. En la escuela es muy común oír solo «i compiti»."
        }
      ],
      "newItems": [
        "quattordici",
        "quindici",
        "sedici",
        "diciassette",
        "diciotto"
      ]
    },
    {
      "lessonId": "italian-survival-07",
      "title": "¡Ya son las tres!",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Marco, che ore sono?",
          "translation": "Marco, ¿qué hora es?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Sono le tre. Perché?",
          "translation": "Son las tres. ¿Por qué?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Il corso d'italiano! È alle tre!",
          "translation": "¡La clase de italiano! ¡Es a las tres!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ana, il corso è lunedì. Oggi non è lunedì.",
          "translation": "Ana, la clase es el lunes. Hoy no es lunes."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah, meno male! E che autobus va a scuola?",
          "translation": "¡Ah, menos mal! ¿Y qué autobús va a la escuela?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Il diciannove o il venti.",
          "translation": "El diecinueve o el veinte."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Diciannove, venti… Va bene! Lunedì, alle tre.",
          "translation": "Diecinueve, veinte… ¡Va! Lunes, a las tres."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Esatto!",
          "translation": "¡Exacto!"
        }
      ],
      "notes": [
        {
          "ko": "Che ore sono?",
          "es": "Se pregunta en plural: «¿qué horas son?». También se oye «Che ora è?»."
        },
        {
          "ko": "Sono le tre.",
          "es": "Igual que en español: sono le tre = son las tres. Excepción: è l'una (es la una)."
        },
        {
          "ko": "lunedì",
          "es": "Sin artículo, lunedì = el próximo lunes. Il lunedì = los lunes (cada semana). Lleva acento en la ì final."
        },
        {
          "ko": "diciannove",
          "es": "Doble n, alarga la consonante: «di-chan-NÓ-ve»."
        }
      ],
      "newItems": [
        "diciannove",
        "venti",
        "Che ore sono?",
        "Sono le tre.",
        "lunedì"
      ]
    },
    {
      "lessonId": "italian-survival-08",
      "title": "Planes para la semana",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ana, sei libera martedì?",
          "translation": "Ana, ¿estás libre el martes?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Martedì? No, ho lezione.",
          "translation": "¿El martes? No, tengo clase."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "E mercoledì?",
          "translation": "¿Y el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mercoledì e giovedì anche.",
          "translation": "El miércoles y el jueves también."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Mmm… venerdì?",
          "translation": "Mmm… ¿el viernes?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Venerdì sono libera!",
          "translation": "¡El viernes estoy libre!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Perfetto! Venerdì cinema e sabato al mare!",
          "translation": "¡Perfecto! El viernes, cine, y el sábado, ¡a la playa!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Al mare? Che bello!",
          "translation": "¿A la playa? ¡Qué padre!"
        }
      ],
      "notes": [
        {
          "ko": "martedì, mercoledì, giovedì, venerdì",
          "es": "Los días de lunes a viernes terminan en -dì con acento: el golpe de voz cae al final."
        },
        {
          "ko": "sabato",
          "es": "sabato no lleva acento final: se acentúa en la primera sílaba, «SÁ-ba-to»."
        },
        {
          "ko": "sei libera",
          "es": "libera concuerda con Ana (femenino). A Marco le dirían «sei libero?»."
        },
        {
          "ko": "al mare",
          "es": "Andare al mare = ir a la playa. Desde Roma, la playa más cercana es Ostia."
        }
      ],
      "newItems": [
        "martedì",
        "mercoledì",
        "giovedì",
        "venerdì",
        "sabato"
      ]
    },
    {
      "lessonId": "italian-survival-09",
      "title": "Domingo en Porta Portese",
      "scene": "market",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Oggi è domenica: andiamo a Porta Portese!",
          "translation": "Hoy es domingo: ¡vamos a Porta Portese!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Marco, guarda! Questo!",
          "translation": "¡Marco, mira! ¡Esto!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "La lampada? Sì, carina!",
          "translation": "¿La lámpara? ¡Sí, bonita!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Quanto costa questo?",
          "translation": "¿Cuánto cuesta esto?"
        },
        {
          "speaker": "Venditore",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Venti euro.",
          "translation": "Veinte euros."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Dieci?",
          "translation": "¿Diez?"
        },
        {
          "speaker": "Venditore",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "No, no… forse quindici.",
          "translation": "No, no… quizá quince."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì! Quindici va bene.",
          "translation": "¡Sí! Quince está bien."
        }
      ],
      "notes": [
        {
          "ko": "Sì",
          "es": "sì (sí) lleva acento; si sin acento es «se» o «si»."
        },
        {
          "ko": "forse",
          "es": "forse = quizá, tal vez."
        },
        {
          "ko": "carina",
          "es": "carina = bonita, linda. Falso amigo: cara significa «querida» o «costosa», no «cara» (rostro, que es faccia o viso)."
        },
        {
          "ko": "Porta Portese",
          "es": "El mercado de pulgas más famoso de Roma; se pone los domingos por la mañana y regatear es parte del juego."
        }
      ],
      "newItems": [
        "domenica",
        "sì",
        "no",
        "forse",
        "questo"
      ]
    },
    {
      "lessonId": "italian-survival-10",
      "title": "Fotos viejas",
      "scene": "home",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Guarda, vecchie foto.",
          "translation": "Mira, fotos viejas."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "È la tua famiglia?",
          "translation": "¿Es tu familia?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Sì, questa è la mia famiglia, al mare.",
          "translation": "Sí, esta es mi familia, en la playa."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E quello con la chitarra?",
          "translation": "¿Y ese de la guitarra?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Quello è Luca, un amico di scuola.",
          "translation": "Ese es Luca, un amigo de la escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E quello laggiù, in fondo?",
          "translation": "¿Y aquel de allá, al fondo?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Boh! Una persona sulla spiaggia.",
          "translation": "¡Ni idea! Una persona en la playa."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Una persona famosa, forse!",
          "translation": "¡Una persona famosa, quizá!"
        }
      ],
      "notes": [
        {
          "ko": "questo / quello",
          "es": "questo = este (cerca); quello = ese, aquel (lejos). El italiano no distingue entre «ese» y «aquel»."
        },
        {
          "ko": "quello laggiù",
          "es": "Para señalar algo muy lejos se añade laggiù (allá abajo, allá lejos)."
        },
        {
          "ko": "amico",
          "es": "Plural: amici, y la c cambia de sonido: amico = «amíko», amici = «amíchi»."
        },
        {
          "ko": "Boh!",
          "es": "Interjección romana (y de toda Italia) para decir «¡ni idea!», casi siempre con un encogimiento de hombros."
        }
      ],
      "newItems": [
        "quello",
        "quello laggiù",
        "persona",
        "amico",
        "famiglia"
      ]
    },
    {
      "lessonId": "italian-survival-11",
      "title": "Paseo por el barrio",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Marco, che cosa c'è là?",
          "translation": "Marco, ¿qué hay allá?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "È la stazione Termini.",
          "translation": "Es la estación Termini."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E quella casa gialla?",
          "translation": "¿Y esa casa amarilla?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Non è una casa, è una scuola.",
          "translation": "No es una casa, es una escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E chi è quel signore?",
          "translation": "¿Y quién es ese señor?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "È il signor Conti, il mio vicino. Buongiorno, signor Conti!",
          "translation": "Es el señor Conti, mi vecino. ¡Buenos días, señor Conti!"
        },
        {
          "speaker": "Sig. Conti",
          "speakerEs": "Señor Conti",
          "gender": "m",
          "text": "Ciao, Marco! E chi è questa ragazza?",
          "translation": "¡Hola, Marco! ¿Y quién es esta muchacha?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "È Ana. Viene dal Messico.",
          "translation": "Es Ana. Viene de México."
        }
      ],
      "notes": [
        {
          "ko": "che cosa",
          "es": "«¿qué?» se dice che cosa, cosa o che: las tres son correctas. Che cosa es la más completa."
        },
        {
          "ko": "chi",
          "es": "¡Trampa! chi se pronuncia «ki» y significa «quién». La h mantiene el sonido duro de la c."
        },
        {
          "ko": "scuola",
          "es": "sc + u suena «sk»: «skuóla»."
        },
        {
          "ko": "signor Conti",
          "es": "signore pierde la -e delante de un apellido: il signor Conti. Para saludarlo directamente no se usa artículo: «Buongiorno, signor Conti!»."
        }
      ],
      "newItems": [
        "casa",
        "scuola",
        "stazione",
        "che cosa",
        "chi"
      ]
    },
    {
      "lessonId": "italian-survival-12",
      "title": "Tren a Génova",
      "scene": "station",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Marco, da dove parte il treno per Genova?",
          "translation": "Marco, ¿de dónde sale el tren a Génova?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Dal binario cinque.",
          "translation": "Del andén cinco."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E quando parte?",
          "translation": "¿Y cuándo sale?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Alle dodici. Hai il biglietto?",
          "translation": "A las doce. ¿Tienes el boleto?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì! Genova, cinque, dodici… che difficile!",
          "translation": "¡Sí! Génova, cinque, dodici… ¡qué difícil!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Dai, ripeti: ciao, chi, gelato!",
          "translation": "¡Ándale, repite: ciao, chi, gelato!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ciao, chi, gelato! Va bene?",
          "translation": "¡Ciao, chi, gelato! ¿Así está bien?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Perfetto! Buon viaggio!",
          "translation": "¡Perfecto! ¡Buen viaje!"
        }
      ],
      "notes": [
        {
          "ko": "dove / quando",
          "es": "dove = dónde, quando = cuándo. Da dove = de dónde."
        },
        {
          "ko": "ce / ci",
          "es": "C ante e/i suena «ch»: cinque, dodici, ciao."
        },
        {
          "ko": "che / chi",
          "es": "La h entre c y e/i mantiene el sonido «k»: che = «ke», chi = «ki»."
        },
        {
          "ko": "ge / gi",
          "es": "G ante e/i suena como una y fuerte (como la j inglesa de «jeans»): Genova, gelato, giorno. Para el sonido duro se escribe gh: spaghetti."
        }
      ],
      "newItems": [
        "dove",
        "quando",
        "ce / ci",
        "che / chi",
        "ge / gi"
      ]
    }
  ]
