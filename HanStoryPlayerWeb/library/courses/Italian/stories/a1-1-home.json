{
  "unitId": "a1-1-home",
  "stories": [
    {
      "lessonId": "italian-a11-home-01",
      "title": "La casa amarilla",
      "scene": "street",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ana, dov’è? La tua nuova casa?",
          "translation": "Ana, ¿dónde está? ¿Tu nueva casa?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Eccola qui! Quella casa gialla.",
          "translation": "¡Aquí está! Esa casa amarilla."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Bella! E la tua camera?",
          "translation": "¡Bonita! ¿Y tu cuarto?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "È al terzo piano.",
          "translation": "Está en el tercer piso."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "E l'ascensore?",
          "translation": "¿Y el elevador?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ascensore? No, niente ascensore!",
          "translation": "¿Elevador? ¡No, no hay!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Mamma mia! Palazzo antico!",
          "translation": "¡No manches! ¡Edificio antiguo!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì, ma la camera è bellissima. Vieni!",
          "translation": "Sí, pero el cuarto está precioso. ¡Ven!"
        }
      ],
      "notes": [
        {
          "ko": "Eccola qui!",
          "es": "ecco = aquí está / he aquí. Con pronombre: eccola (la casa, femenino), eccolo (masculino)."
        },
        {
          "ko": "camera",
          "es": "Falso amigo: la camera es el cuarto o la habitación (camera da letto = recámara). La cámara de fotos es la macchina fotografica."
        },
        {
          "ko": "terzo piano",
          "es": "il piano = el piso. La planta baja es il piano terra, así que el terzo piano es el tercero por encima de ella."
        },
        {
          "ko": "dov’è",
          "es": "dove + è: «¿dónde está?»."
        }
      ],
      "newItems": [
        "casa",
        "camera",
        "Eccola qui.",
        "Dov’è?"
      ]
    },
    {
      "lessonId": "italian-a11-home-02",
      "title": "¿Dónde está mi celular?",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Marco, questa è la cucina.",
          "translation": "Marco, esta es la cocina."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Che grande! E il bagno?",
          "translation": "¡Qué grande! ¿Y el baño?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "In fondo. … Un momento! Dov'è il mio telefono?",
          "translation": "Al fondo. … ¡Un momento! ¿Dónde está mi celular?"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "In cucina?",
          "translation": "¿En la cocina?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "No, non è qui.",
          "translation": "No, no está aquí."
        },
        {
          "speaker": "Sara",
          "speakerEs": "Sara",
          "gender": "f",
          "text": "Ana! C'è un telefono in bagno. È tuo?",
          "translation": "¡Ana! Hay un celular en el baño. ¿Es tuyo?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì, è mio! Grazie, Sara!",
          "translation": "¡Sí, es mío! ¡Gracias, Sara!"
        },
        {
          "speaker": "Sara",
          "speakerEs": "Sara",
          "gender": "f",
          "text": "Prego!",
          "translation": "¡De nada!"
        }
      ],
      "notes": [
        {
          "ko": "cucina",
          "es": "la cucina = la cocina (el cuarto) y también la estufa y el arte de cocinar: la cucina italiana."
        },
        {
          "ko": "È mio",
          "es": "Tras essere el posesivo va sin artículo: è mio, è tuo = es mío, es tuyo."
        },
        {
          "ko": "in bagno / in cucina",
          "es": "Con cuartos de la casa se usa in sin artículo: in bagno, in cucina, in camera."
        }
      ],
      "newItems": [
        "cucina",
        "bagno",
        "È mio.",
        "Non è qui."
      ]
    },
    {
      "lessonId": "italian-a11-home-03",
      "title": "El cuarto de Ana",
      "scene": "bedroom",
      "lines": [
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "E questa è la tua camera?",
          "translation": "¿Y este es tu cuarto?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sì. La mia camera è piccola, ma accogliente.",
          "translation": "Sí. Mi cuarto es pequeño, pero acogedor."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Un letto, un tavolo, una sedia… perfetto!",
          "translation": "Una cama, una mesa, una silla… ¡perfecto!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Siediti sulla sedia!",
          "translation": "¡Siéntate en la silla!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Grazie. Ana, devo andare. Dov'è la chiave di casa?",
          "translation": "Gracias. Ana, ya me tengo que ir. ¿Dónde está la llave de la casa?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "La chiave è sul tavolo.",
          "translation": "La llave está sobre la mesa."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ah, sì! Grazie. Ciao!",
          "translation": "¡Ah, sí! Gracias. ¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "tavolo",
          "es": "il tavolo = la mesa (mueble). En la expresión «a tavola!» (¡a la mesa!) se usa la tavola."
        },
        {
          "ko": "sul tavolo",
          "es": "sul = su + il (sobre el). Igual: sulla = su + la (sulla sedia)."
        },
        {
          "ko": "accogliente",
          "es": "accogliente = acogedor. gli suena como la «ll» de algunas regiones: «akolliénte»."
        }
      ],
      "newItems": [
        "tavolo",
        "sedia",
        "La chiave è sul tavolo.",
        "La mia camera è piccola."
      ]
    },
    {
      "lessonId": "italian-a11-home-04",
      "title": "Faltan sillas",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Sara",
          "speakerEs": "Sara",
          "gender": "f",
          "text": "Ana, stasera vengono Marco e Giulia.",
          "translation": "Ana, hoy en la noche vienen Marco y Giulia."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Siamo in quattro, e ci sono due sedie.",
          "translation": "Somos cuatro y hay dos sillas."
        },
        {
          "speaker": "Sara",
          "speakerEs": "Sara",
          "gender": "f",
          "text": "In camera di Luca ce ne sono altre due.",
          "translation": "En el cuarto de Luca hay otras dos."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "E Luca? Non c'è. La porta è chiusa.",
          "translation": "¿Y Luca? No está. La puerta está cerrada."
        },
        {
          "speaker": "Sara",
          "speakerEs": "Sara",
          "gender": "f",
          "text": "Ecco la chiave.",
          "translation": "Aquí está la llave."
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Permesso? La porta è aperta!",
          "translation": "¿Se puede? ¡La puerta está abierta!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Entra, Marco!",
          "translation": "¡Pásale, Marco!"
        },
        {
          "speaker": "Marco",
          "speakerEs": "Marco",
          "gender": "m",
          "text": "Ciao! Ah, quattro sedie. Perfetto!",
          "translation": "¡Hola! Ah, cuatro sillas. ¡Perfecto!"
        }
      ],
      "notes": [
        {
          "ko": "ci sono",
          "es": "c'è = hay (singular); ci sono = hay (plural): ci sono due sedie."
        },
        {
          "ko": "Permesso?",
          "es": "Al entrar en casa ajena los italianos dicen «Permesso?» (¿con permiso?, ¿se puede?)."
        },
        {
          "ko": "aperta / chiusa",
          "es": "aperta = abierta, chiusa = cerrada. Concuerdan con la porta (femenino)."
        },
        {
          "ko": "Siamo in quattro",
          "es": "Para decir cuántos son en un grupo: siamo in quattro = somos cuatro."
        }
      ],
      "newItems": [
        "porta",
        "chiave",
        "Ci sono due sedie.",
        "La porta è aperta."
      ]
    }
  ]
}
