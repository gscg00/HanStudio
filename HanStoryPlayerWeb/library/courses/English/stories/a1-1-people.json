{
  "unitId": "a1-1-people",
  "stories": [
    {
      "lessonId": "english-a11-people-01",
      "title": "Fotos de México",
      "scene": "home",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Look, Ben. This is my family.",
          "translation": "Mira, Ben. Esta es mi familia."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Nice! Who's this?",
          "translation": "¡Qué bonito! ¿Quién es esta?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "This is my mother, Rosa. And this is my father, Luis.",
          "translation": "Esta es mi madre, Rosa. Y este es mi padre, Luis."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "And the boy?",
          "translation": "¿Y el chico?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "That's Diego. He is my friend from school.",
          "translation": "Es Diego. Es mi amigo de la escuela."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "You look like your mother!",
          "translation": "¡Te pareces a tu madre!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes, everybody says that.",
          "translation": "Sí, todo el mundo me lo dice."
        }
      ],
      "notes": [
        {
          "ko": "This is my family",
          "es": "This is… es la forma natural de presentar a alguien o enseñar una foto."
        },
        {
          "ko": "He is my friend",
          "es": "En inglés el sujeto es obligatorio: «He is», nunca solo «is»."
        },
        {
          "ko": "my mother",
          "es": "mother y father son neutros; en familia se dice mum y dad (en EE. UU., mom y dad)."
        },
        {
          "ko": "You look like",
          "es": "look like = parecerse (físicamente)."
        }
      ],
      "newItems": [
        "mother",
        "father",
        "This is my family.",
        "He is my friend."
      ]
    },
    {
      "lessonId": "english-a11-people-02",
      "title": "La hermana de Ben",
      "scene": "home",
      "lines": [
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ana, this is Lucy. She is my sister.",
          "translation": "Ana, esta es Lucy. Es mi hermana."
        },
        {
          "speaker": "Lucy",
          "speakerEs": "Lucy",
          "gender": "f",
          "text": "Hi, Ana! Nice to meet you.",
          "translation": "¡Hola, Ana! Mucho gusto."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nice to meet you, Lucy.",
          "translation": "Mucho gusto, Lucy."
        },
        {
          "speaker": "Lucy",
          "speakerEs": "Lucy",
          "gender": "f",
          "text": "Do you have a sister?",
          "translation": "¿Tú tienes hermana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "No, I don't. But I have two brothers.",
          "translation": "No. Pero tengo dos hermanos."
        },
        {
          "speaker": "Lucy",
          "speakerEs": "Lucy",
          "gender": "f",
          "text": "Two brothers! Lucky you.",
          "translation": "¡Dos hermanos! Qué suerte."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Lucky? My brothers are very noisy!",
          "translation": "¿Suerte? ¡Mis hermanos son muy ruidosos!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ha! My sister is noisy too.",
          "translation": "¡Ja! Mi hermana también es ruidosa."
        },
        {
          "speaker": "Lucy",
          "speakerEs": "Lucy",
          "gender": "f",
          "text": "Ben!",
          "translation": "¡Ben!"
        }
      ],
      "notes": [
        {
          "ko": "brothers",
          "es": "brothers son solo hermanos varones. «Hermanos» en general (chicos y chicas) = brothers and sisters, o siblings."
        },
        {
          "ko": "She is my sister",
          "es": "she = ella; he = él. Aquí no se puede omitir."
        },
        {
          "ko": "No, I don't",
          "es": "Respuesta corta a «Do you have…?»: se repite el auxiliar do."
        },
        {
          "ko": "Lucky you",
          "es": "«¡Qué suerte tienes!». Expresión fija."
        }
      ],
      "newItems": [
        "sister",
        "brother",
        "She is my sister.",
        "I have two brothers."
      ]
    },
    {
      "lessonId": "english-a11-people-03",
      "title": "El hijo de Sam",
      "scene": "park",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, who is that?",
          "translation": "Ben, ¿quién es?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "That's my friend Sam. And that's his child, Max.",
          "translation": "Es mi amigo Sam. Y ese es su hijo, Max."
        },
        {
          "speaker": "Sam",
          "speakerEs": "Sam",
          "gender": "m",
          "text": "Hi, Ben! Hello!",
          "translation": "¡Hola, Ben! ¡Hola!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello! Hi, Max. How old are you?",
          "translation": "¡Hola! Hola, Max. ¿Cuántos años tienes?"
        },
        {
          "speaker": "Max",
          "speakerEs": "Max",
          "gender": "m",
          "text": "I'm five!",
          "translation": "¡Tengo cinco!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Five! You're a big boy.",
          "translation": "¡Cinco! Ya eres un niño grande."
        },
        {
          "speaker": "Max",
          "speakerEs": "Max",
          "gender": "m",
          "text": "How old are you?",
          "translation": "¿Y tú cuántos años tienes?"
        },
        {
          "speaker": "Sam",
          "speakerEs": "Sam",
          "gender": "m",
          "text": "Max! We don't ask that!",
          "translation": "¡Max! ¡Eso no se pregunta!"
        }
      ],
      "notes": [
        {
          "ko": "How old are you?",
          "es": "Literalmente «¿qué tan viejo eres?». La edad se expresa con to be, no con «tener»."
        },
        {
          "ko": "I'm five",
          "es": "Se responde con I am (+ years old, opcional): «I'm five». Nunca «I have five years»."
        },
        {
          "ko": "child",
          "es": "child = niño/niña, o hijo/hija. Plural irregular: children."
        },
        {
          "ko": "We don't ask that",
          "es": "Preguntar la edad a un adulto se considera poco educado en la cultura británica."
        }
      ],
      "newItems": [
        "friend",
        "child",
        "Who is that?",
        "How old are you?"
      ]
    },
    {
      "lessonId": "english-a11-people-04",
      "title": "La tienda de la familia",
      "scene": "shop",
      "lines": [
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Come in, Ana. My mother works here.",
          "translation": "Pasa, Ana. Mi madre trabaja aquí."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "In this shop?",
          "translation": "¿En esta tienda?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes. The woman at the till is my mum, and the man with the boxes is my dad.",
          "translation": "Sí. La mujer de la caja es mi mamá, y el hombre de las cajas es mi papá."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Your parents work together?",
          "translation": "¿Tus papás trabajan juntos?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes. And we live together, upstairs.",
          "translation": "Sí. Y vivimos juntos, en el piso de arriba."
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Ben! Is this Ana?",
          "translation": "¡Ben! ¿Ella es Ana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes! Hello, nice to meet you.",
          "translation": "¡Sí! Hola, mucho gusto."
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Nice to meet you, love!",
          "translation": "¡Mucho gusto, cariño!"
        }
      ],
      "notes": [
        {
          "ko": "My mother works here",
          "es": "Con he/she/it el verbo lleva -s en presente: I work, she works."
        },
        {
          "ko": "woman / man",
          "es": "Plurales irregulares: women («uí-min») y men."
        },
        {
          "ko": "till",
          "es": "till = caja registradora, en inglés británico."
        },
        {
          "ko": "upstairs",
          "es": "«Arriba, en el piso de arriba». Lo contrario: downstairs."
        }
      ],
      "newItems": [
        "woman",
        "man",
        "My mother works here.",
        "We live together."
      ]
    }
  ]
}
