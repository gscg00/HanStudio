{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "english-a11-food-01",
      "title": "Hambre de medianoche",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, I am hungry.",
          "translation": "Ben, tengo hambre."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Me too. And I am thirsty.",
          "translation": "Yo también. Y tengo sed."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Is there any food in the kitchen?",
          "translation": "¿Hay algo de comida en la cocina?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "There's bread... and water.",
          "translation": "Hay pan… y agua."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Only bread and water?",
          "translation": "¿Solo pan y agua?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "And cheese! Cheese sandwiches?",
          "translation": "¡Y queso! ¿Sándwiches de queso?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Perfect!",
          "translation": "¡Perfecto!"
        }
      ],
      "notes": [
        {
          "ko": "I am hungry",
          "es": "Trampa: en inglés el hambre y la sed se «son», no se «tienen»: I am hungry, I am thirsty."
        },
        {
          "ko": "Me too",
          "es": "«Yo también», respuesta rápida y natural."
        },
        {
          "ko": "any food",
          "es": "any se usa en preguntas: «Is there any…?» = ¿hay algo de…?"
        },
        {
          "ko": "bread",
          "es": "bread y water no se cuentan: no llevan a ni plural. Se dice «some bread»."
        }
      ],
      "newItems": [
        "water",
        "bread",
        "I am hungry.",
        "I am thirsty."
      ]
    },
    {
      "lessonId": "english-a11-food-02",
      "title": "Ana invita",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Are you ready to order?",
          "translation": "¿Ya están listos para pedir?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes. I want this: chicken with rice.",
          "translation": "Sí. Quiero esto: pollo con arroz."
        },
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Of course. And to drink?",
          "translation": "Claro. ¿Y de tomar?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "A coffee, please.",
          "translation": "Un café, por favor."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Water for me, please.",
          "translation": "Para mí, agua, por favor."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Excuse me! The bill, please.",
          "translation": "¡Disculpe! La cuenta, por favor."
        },
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Here you are.",
          "translation": "Aquí tienen."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, it's my turn. I'm paying!",
          "translation": "Ben, me toca a mí. ¡Yo pago!"
        }
      ],
      "notes": [
        {
          "ko": "I want this",
          "es": "Es correcto pero directo. Más cortés: «I'd like this, please»."
        },
        {
          "ko": "The bill",
          "es": "bill = la cuenta en inglés británico; en EE. UU. se dice check."
        },
        {
          "ko": "And to drink?",
          "es": "Pregunta típica del mesero: «¿Y para tomar?»."
        },
        {
          "ko": "it's my turn",
          "es": "«Me toca». turn = turno."
        }
      ],
      "newItems": [
        "rice",
        "coffee",
        "I want this.",
        "The bill, please."
      ]
    },
    {
      "lessonId": "english-a11-food-03",
      "title": "Desayuno británico",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Tea or coffee, Ana?",
          "translation": "¿Té o café, Ana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Tea, please. I drink tea in the morning now!",
          "translation": "Té, por favor. ¡Ahora tomo té por la mañana!"
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Very British! With milk?",
          "translation": "¡Muy británico! ¿Con leche?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes, please. And an apple.",
          "translation": "Sí, por favor. Y una manzana."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Mum, is there any rice from last night?",
          "translation": "Mamá, ¿queda arroz de anoche?"
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Rice? For breakfast?",
          "translation": "¿Arroz? ¿En el desayuno?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes! I want some rice.",
          "translation": "¡Sí! Quiero un poco de arroz."
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Oh, Ben...",
          "translation": "Ay, Ben…"
        }
      ],
      "notes": [
        {
          "ko": "I drink tea",
          "es": "drink = beber o tomar. Con bebidas no se usa «take»."
        },
        {
          "ko": "an apple",
          "es": "Delante de sonido vocálico, a se convierte en an: an apple."
        },
        {
          "ko": "some rice",
          "es": "some = un poco de / algo de, con cosas que no se cuentan."
        },
        {
          "ko": "With milk?",
          "es": "Los británicos toman casi siempre el té negro con un chorrito de leche."
        }
      ],
      "newItems": [
        "tea",
        "apple",
        "I drink tea in the morning.",
        "I want some rice."
      ]
    },
    {
      "lessonId": "english-a11-food-04",
      "title": "Tacos sin carne",
      "scene": "market",
      "lines": [
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Fresh vegetables! Try an apple!",
          "translation": "¡Verduras frescas! ¡Pruebe una manzana!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Mmm. This apple is delicious.",
          "translation": "Mmm. Esta manzana está deliciosa."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ana, burgers tonight?",
          "translation": "Ana, ¿hamburguesas esta noche?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sorry, Ben, I do not eat meat.",
          "translation": "Perdón, Ben, no como carne."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Really? Vegetables, then!",
          "translation": "¿En serio? ¡Entonces verduras!"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Carrots, peppers, tomatoes...",
          "translation": "Zanahorias, pimientos, jitomates…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Peppers and tomatoes, please.",
          "translation": "Pimientos y jitomates, por favor."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Vegetable tacos tonight!",
          "translation": "¡Esta noche, tacos de verduras!"
        }
      ],
      "notes": [
        {
          "ko": "vegetables",
          "es": "Se pronuncia en tres sílabas: «vésh-ta-bols». La segunda e no suena."
        },
        {
          "ko": "I do not eat meat",
          "es": "En la conversación: «I don't eat meat». meat se pronuncia como meet: «mit» larga."
        },
        {
          "ko": "This apple is delicious",
          "es": "this + sustantivo singular; en plural: these apples."
        },
        {
          "ko": "Really?",
          "es": "«¿En serio?». Muestra sorpresa sin ser descortés."
        }
      ],
      "newItems": [
        "meat",
        "vegetables",
        "This apple is delicious.",
        "I do not eat meat."
      ]
    }
  ]
}
