{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "english-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "Ms Brown",
          "speakerEs": "Maestra Brown",
          "gender": "f",
          "text": "Good morning, everyone!",
          "translation": "¡Buenos días a todos!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Good morning!",
          "translation": "¡Buenos días!"
        },
        {
          "speaker": "Ms Brown",
          "speakerEs": "Maestra Brown",
          "gender": "f",
          "text": "Hello! You're new.",
          "translation": "¡Hola! Tú eres nueva."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes. My name is Ana.",
          "translation": "Sí. Me llamo Ana."
        },
        {
          "speaker": "Ms Brown",
          "speakerEs": "Maestra Brown",
          "gender": "f",
          "text": "Nice to meet you, Ana. I'm Ms Brown.",
          "translation": "Mucho gusto, Ana. Soy la maestra Brown."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nice to meet you too.",
          "translation": "Igualmente."
        },
        {
          "speaker": "Ms Brown",
          "speakerEs": "Maestra Brown",
          "gender": "f",
          "text": "Welcome to the class!",
          "translation": "¡Bienvenida a la clase!"
        }
      ],
      "notes": [
        {
          "ko": "Good morning",
          "es": "Se usa hasta el mediodía. Por la tarde se dice good afternoon."
        },
        {
          "ko": "everyone",
          "es": "«Todos», para saludar a un grupo."
        },
        {
          "ko": "Ms Brown",
          "es": "Ms (se pronuncia «mɪz») es el tratamiento neutro para una mujer, sin indicar si está casada."
        },
        {
          "ko": "Nice to meet you",
          "es": "Solo se dice la primera vez que conoces a alguien. Después: «Nice to see you»."
        }
      ],
      "newItems": [
        "hello",
        "good morning",
        "My name is Ana.",
        "Nice to meet you."
      ]
    },
    {
      "lessonId": "english-a11-identity-02",
      "title": "Cena con Ben",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Good evening! A table for two?",
          "translation": "¡Buenas noches! ¿Mesa para dos?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes, please.",
          "translation": "Sí, por favor."
        },
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Here you are. The menu.",
          "translation": "Aquí tienen. La carta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Thank you.",
          "translation": "Gracias."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Thank you. Goodbye!",
          "translation": "Gracias. ¡Adiós!"
        },
        {
          "speaker": "Waiter",
          "speakerEs": "Mesero",
          "gender": "m",
          "text": "Goodbye! Have a good evening.",
          "translation": "¡Adiós! Que pasen buena noche."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, \"good evening\" is \"buenas noches\", right?",
          "translation": "Ben, «good evening» es «buenas noches», ¿verdad?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes, but only for hello. For goodbye, we say \"good night\".",
          "translation": "Sí, pero solo para saludar. Para despedirse decimos «good night»."
        }
      ],
      "notes": [
        {
          "ko": "Good evening",
          "es": "Saludo al llegar por la tarde-noche. Nunca se usa para despedirse."
        },
        {
          "ko": "good night",
          "es": "Solo para despedirse por la noche o antes de dormir."
        },
        {
          "ko": "Yes, please",
          "es": "please hace educada casi cualquier respuesta. En inglés se usa mucho más que «por favor» en español."
        },
        {
          "ko": "right?",
          "es": "Al final de una frase, right? = «¿verdad?»."
        }
      ],
      "newItems": [
        "good evening",
        "goodbye",
        "Thank you.",
        "Please."
      ]
    },
    {
      "lessonId": "english-a11-identity-03",
      "title": "Inscripción en la escuela",
      "scene": "office",
      "lines": [
        {
          "speaker": "Receptionist",
          "speakerEs": "Recepcionista",
          "gender": "m",
          "text": "Hello. What is your name?",
          "translation": "Hola. ¿Cómo te llamas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ana López.",
          "translation": "Ana López."
        },
        {
          "speaker": "Receptionist",
          "speakerEs": "Recepcionista",
          "gender": "m",
          "text": "Can you spell your name, please?",
          "translation": "¿Me deletreas tu nombre, por favor?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "A-N-A, L-O-P-E-Z.",
          "translation": "A-N-A, L-O-P-E-Z."
        },
        {
          "speaker": "Receptionist",
          "speakerEs": "Recepcionista",
          "gender": "m",
          "text": "Thank you. And your country?",
          "translation": "Gracias. ¿Y tu país?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "I am from Mexico.",
          "translation": "Soy de México."
        },
        {
          "speaker": "Receptionist",
          "speakerEs": "Recepcionista",
          "gender": "m",
          "text": "Mexico. Great! Welcome to the school.",
          "translation": "México. ¡Genial! Bienvenida a la escuela."
        }
      ],
      "notes": [
        {
          "ko": "What is your name?",
          "es": "Forma completa de «What's your name?». Suena un poco más formal, típica de una oficina."
        },
        {
          "ko": "spell your name",
          "es": "En países anglohablantes es muy normal pedir que deletrees tu nombre. Practica el alfabeto en inglés."
        },
        {
          "ko": "country",
          "es": "Se pronuncia «kán-tri»: la ou suena como una a corta."
        },
        {
          "ko": "I am from Mexico",
          "es": "I am from + lugar = soy de. Fíjate en el verbo to be: «I am»."
        }
      ],
      "newItems": [
        "name",
        "country",
        "What is your name?",
        "I am from Mexico."
      ]
    },
    {
      "lessonId": "english-a11-identity-04",
      "title": "Una fiesta con mucho ruido",
      "scene": "party",
      "lines": [
        {
          "speaker": "Jack",
          "speakerEs": "Jack",
          "gender": "m",
          "text": "Hi! Are you Ben's friend?",
          "translation": "¡Hola! ¿Tú eres la amiga de Ben?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes, I'm Ana. I speak a little English.",
          "translation": "Sí, soy Ana. Hablo un poco de inglés."
        },
        {
          "speaker": "Jack",
          "speakerEs": "Jack",
          "gender": "m",
          "text": "Your English is good! How many languages do you speak?",
          "translation": "¡Hablas bien inglés! ¿Cuántos idiomas hablas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sorry, I do not understand.",
          "translation": "Perdón, no entiendo."
        },
        {
          "speaker": "Jack",
          "speakerEs": "Jack",
          "gender": "m",
          "text": "Languages. Spanish, English...",
          "translation": "Idiomas. Español, inglés…"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah! Two languages: Spanish and a little English.",
          "translation": "¡Ah! Dos idiomas: español y un poco de inglés."
        },
        {
          "speaker": "Jack",
          "speakerEs": "Jack",
          "gender": "m",
          "text": "I only speak one language. Ben says you're a great person.",
          "translation": "Yo solo hablo un idioma. Ben dice que eres una gran persona."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ha! Ben is a great person too.",
          "translation": "¡Ja! Ben también es una gran persona."
        }
      ],
      "notes": [
        {
          "ko": "a little English",
          "es": "a little = «un poco». Sin a («little English») significa «casi nada»."
        },
        {
          "ko": "languages",
          "es": "Se pronuncia «láng-güi-dʒiz». Los nombres de idiomas van con mayúscula: English, Spanish."
        },
        {
          "ko": "I do not understand",
          "es": "Forma completa de «I don't understand». En la conversación casi siempre se contrae."
        },
        {
          "ko": "a great person",
          "es": "great = genial, estupendo. Es un cumplido muy común."
        }
      ],
      "newItems": [
        "language",
        "person",
        "I speak a little English.",
        "I do not understand."
      ]
    }
  ]
}
