    {
      "lessonId": "english-survival-11",
      "title": "Paseo por el barrio de Ben",
      "scene": "street",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, what's that building?",
          "translation": "Ben, ¿qué es ese edificio?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "That's my old school.",
          "translation": "Es mi antigua escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Your school? It's beautiful!",
          "translation": "¿Tu escuela? ¡Está preciosa!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "And that's the station. My home is near it.",
          "translation": "Y esa es la estación. Mi casa está cerca."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Who's that man at the door?",
          "translation": "¿Quién es ese señor en la puerta?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "That's Mr Green, my old teacher!",
          "translation": "¡Es el señor Green, mi antiguo maestro!"
        },
        {
          "speaker": "Mr Green",
          "speakerEs": "Sr. Green",
          "gender": "m",
          "text": "Ben! Hello! What are you doing here?",
          "translation": "¡Ben! ¡Hola! ¿Qué haces por aquí?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Hello, Mr Green! I'm going home with my friend Ana.",
          "translation": "¡Hola, señor Green! Voy a casa con mi amiga Ana."
        }
      ],
      "notes": [
        {
          "ko": "Who's",
          "es": "Who's = Who is. who pregunta por personas; what, por cosas."
        },
        {
          "ko": "going home",
          "es": "Con home no se usa to: «I'm going home», no «going to home»."
        },
        {
          "ko": "Mr Green",
          "es": "En inglés británico Mr y Ms se escriben sin punto. Se usan con el apellido, nunca con el nombre de pila."
        },
        {
          "ko": "old",
          "es": "Delante de lugares o personas, old puede significar «antiguo, de antes»: my old school."
        }
      ],
      "newItems": [
        "home",
        "school",
        "station",
        "what",
        "who"
      ]
    },
    {
      "lessonId": "english-survival-12",
      "title": "Ben se va a Manchester",
      "scene": "station",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, where are you going?",
          "translation": "Ben, ¿a dónde vas?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "To Manchester. My sister is there.",
          "translation": "A Manchester. Mi hermana está allá."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "When are you coming back?",
          "translation": "¿Cuándo regresas?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Next week. On Sunday.",
          "translation": "La próxima semana. El domingo."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "I see. Is this your train?",
          "translation": "Ya veo. ¿Este es tu tren?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes. Do you want a sandwich from the shop? Cheese or chicken?",
          "translation": "Sí. ¿Quieres un sándwich de la tienda? ¿De queso o de pollo?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Cheese, please!",
          "translation": "¡De queso, por favor!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Here you are. See you next week!",
          "translation": "Aquí tienes. ¡Nos vemos la próxima semana!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "See you! Have a good trip!",
          "translation": "¡Nos vemos! ¡Buen viaje!"
        }
      ],
      "notes": [
        {
          "ko": "Where / When",
