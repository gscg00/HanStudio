{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "english-survival-01",
      "title": "Llegada a Londres",
      "scene": "airport",
      "lines": [
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ana! Hello!",
          "translation": "¡Ana! ¡Hola!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello, Ben!",
          "translation": "¡Hola, Ben!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, where is the bathroom?",
          "translation": "Ben, ¿dónde está el baño?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "It's over there.",
          "translation": "Está por allá."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello! This water... how much is it?",
          "translation": "¡Hola! Esta agua… ¿cuánto cuesta?"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Two pounds fifty.",
          "translation": "Dos libras cincuenta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sorry, I don't understand. Could you repeat that?",
          "translation": "Perdón, no entiendo. ¿Podría repetirlo?"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Two pounds fifty.",
          "translation": "Dos libras cincuenta."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah! Thank you.",
          "translation": "¡Ah! Gracias."
        }
      ],
      "notes": [
        {
          "ko": "Hello!",
          "es": "El saludo universal: sirve a cualquier hora y con cualquier persona."
        },
        {
          "ko": "I don't understand",
          "es": "don't es la contracción de do not. En inglés la negación necesita el auxiliar do: no se dice «I not understand»."
        },
        {
          "ko": "Could you repeat that?",
          "es": "Could hace la petición más cortés que «Can you…?». Ideal con desconocidos."
        },
        {
          "ko": "where is the bathroom?",
          "es": "En Gran Bretaña, en lugares públicos se dice más «Where are the toilets?»; bathroom se entiende sin problema."
        }
      ],
      "newItems": [
        "Hello!",
        "I don't understand.",
        "Could you repeat that?",
        "Where is the bathroom?",
        "How much is it?"
      ]
    },
    {
      "lessonId": "english-survival-02",
      "title": "Un café nuevo",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Hello! What would you like?",
          "translation": "¡Hola! ¿Qué vas a querer?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello! Can you help me? I would like water.",
          "translation": "¡Hola! ¿Me puedes ayudar? Quisiera agua."
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Sure! Here you are.",
          "translation": "¡Claro! Aquí tienes."
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "You're new here. What's your name?",
          "translation": "Eres nueva por aquí. ¿Cómo te llamas?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "My name is Ana. And you?",
          "translation": "Me llamo Ana. ¿Y tú?"
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "I'm Emma.",
          "translation": "Yo soy Emma."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nice to meet you, Emma.",
          "translation": "Mucho gusto, Emma."
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Nice to meet you too!",
          "translation": "¡Igualmente!"
        }
      ],
      "notes": [
        {
          "ko": "What's your name?",
          "es": "What's = What is. Literalmente «¿Cuál es tu nombre?»: en inglés el nombre se «es», no «se llama»."
        },
        {
          "ko": "I would like water",
          "es": "I would like (muy a menudo I'd like) es la forma educada de pedir algo, como «quisiera»."
        },
        {
          "ko": "Here you are",
          "es": "Se dice al entregarle algo a alguien: «aquí tienes»."
        },
        {
          "ko": "Nice to meet you too!",
          "es": "La respuesta habitual a «Nice to meet you»: se añade too («también»)."
        }
      ],
      "newItems": [
        "Nice to meet you.",
        "Can you help me?",
        "I would like water.",
        "My name is Ana.",
        "What's your name?"
      ]
    },
    {
      "lessonId": "english-survival-03",
      "title": "La contraseña del wifi",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Ana, where are you from?",
          "translation": "Ana, ¿de dónde eres?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "I'm from Mexico. From Guadalajara.",
          "translation": "Soy de México. De Guadalajara."
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Cool! Welcome to London.",
          "translation": "¡Qué padre! Bienvenida a Londres."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Thanks! Emma, what's the Wi-Fi password?",
          "translation": "¡Gracias! Emma, ¿cuál es la contraseña del wifi?"
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "It's \"cafe\", then zero, one, two, three.",
          "translation": "Es «cafe» y luego cero, uno, dos, tres."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Zero, one, two... three?",
          "translation": "Cero, uno, dos… ¿tres?"
        },
        {
          "speaker": "Emma",
          "speakerEs": "Emma",
          "gender": "f",
          "text": "Yes, that's it!",
          "translation": "¡Sí, eso es!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Great, it works!",
          "translation": "¡Genial, ya funciona!"
        }
      ],
      "notes": [
        {
          "ko": "I'm from Mexico",
          "es": "I'm = I am. Con países no se usa artículo: from Mexico, from Spain (excepción: the USA, the UK)."
        },
        {
          "ko": "zero",
          "es": "En números de teléfono o códigos, los británicos dicen a menudo «oh» en lugar de zero: «oh-one-two»."
        },
        {
          "ko": "Wi-Fi",
          "es": "Se pronuncia «uái-fai», no «uí-fi» como en español."
        },
        {
          "ko": "that's it!",
          "es": "«¡Eso es!», para confirmar que algo está bien."
        }
      ],
      "newItems": [
        "I'm from Mexico.",
        "zero",
        "one",
        "two",
        "three"
      ]
    },
    {
      "lessonId": "english-survival-04",
      "title": "Naranjas en el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello! How much is it?",
          "translation": "¡Hola! ¿Cuánto cuesta?"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Five pounds.",
          "translation": "Cinco libras."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Sorry... four?",
          "translation": "Perdón… ¿cuatro?"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "No, five. Four, five. Five pounds.",
          "translation": "No, cinco. Cuatro, cinco. Cinco libras."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ah, five! And how many oranges?",
          "translation": "¡Ah, cinco! ¿Y cuántas naranjas son?"
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Eight oranges. Six, seven, eight!",
          "translation": "Ocho naranjas. ¡Seis, siete, ocho!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Great. Here you are.",
          "translation": "Perfecto. Aquí tiene."
        },
        {
          "speaker": "Seller",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "Thank you, love!",
          "translation": "¡Gracias, linda!"
        }
      ],
      "notes": [
        {
          "ko": "four",
          "es": "four se pronuncia «for»; la u no suena."
        },
        {
          "ko": "Eight",
          "es": "En eight la gh no se pronuncia: suena «eit»."
        },
        {
          "ko": "how many oranges?",
          "es": "how many se usa con cosas que se cuentan (oranges); how much, con precios y cosas que no se cuentan."
        },
        {
          "ko": "love",
          "es": "En Londres y el norte de Inglaterra, muchos vendedores llaman «love» a los clientes. Es cariñoso, no coqueteo."
        }
      ],
      "newItems": [
        "four",
        "five",
        "six",
        "seven",
        "eight"
      ]
    },
    {
      "lessonId": "english-survival-05",
      "title": "El andén nueve y tres cuartos",
      "scene": "station",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, how much is the ticket?",
          "translation": "Ben, ¿cuánto cuesta el boleto?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Thirteen pounds.",
          "translation": "Trece libras."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Thirteen? Or thirty?",
          "translation": "¿Trece? ¿O treinta?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Thirteen. Ten, eleven, twelve, thirteen!",
          "translation": "Trece. ¡Diez, once, doce, trece!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "OK. And the platform?",
          "translation": "Bueno. ¿Y el andén?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Platform nine. No, wait... platform ten!",
          "translation": "Andén nueve. No, espera… ¡andén diez!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ten? Not nine?",
          "translation": "¿Diez? ¿No el nueve?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ten. Look: nine, ten, eleven, twelve.",
          "translation": "Diez. Mira: nueve, diez, once, doce."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ha! No platform nine and three-quarters?",
          "translation": "¡Ja! ¿No hay andén nueve y tres cuartos?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "That one is only for wizards!",
          "translation": "¡Ese es solo para magos!"
        }
      ],
      "notes": [
        {
          "ko": "Thirteen? Or thirty?",
          "es": "Trampa clásica: en thirTEEN el acento va al final y la ee es larga; en THIRty el acento va al principio."
        },
        {
          "ko": "Platform",
          "es": "platform = andén. En las estaciones británicas siempre se indica el número de platform."
        },
        {
          "ko": "wait",
          "es": "«Espera»: muy útil para corregirse a mitad de frase."
        },
        {
          "ko": "nine and three-quarters",
          "es": "Guiño a Harry Potter: el andén 9 ¾ está en la estación de King's Cross, en Londres."
        }
      ],
      "newItems": [
        "nine",
        "ten",
        "eleven",
        "twelve",
        "thirteen"
      ]
    },
    {
      "lessonId": "english-survival-06",
      "title": "¿Cuál es nuestro autobús?",
      "scene": "bus",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, is this our bus? The fourteen?",
          "translation": "Ben, ¿este es nuestro camión? ¿El catorce?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "No, we need the fifteen.",
          "translation": "No, necesitamos el quince."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Fourteen, fifteen... and the sixteen?",
          "translation": "Catorce, quince… ¿y el dieciséis?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "The sixteen goes to the station.",
          "translation": "El dieciséis va a la estación."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "How many stops?",
          "translation": "¿Cuántas paradas son?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Seventeen... no, eighteen stops.",
          "translation": "Diecisiete… no, dieciocho paradas."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Eighteen stops! That's a lot.",
          "translation": "¡Dieciocho paradas! Son muchas."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Look, here's the fifteen. Come on!",
          "translation": "Mira, ahí viene el quince. ¡Vamos!"
        }
      ],
      "notes": [
        {
          "ko": "the fifteen",
          "es": "Los autobuses se nombran por su número con the: «the fifteen» = el (autobús) quince."
        },
        {
          "ko": "Fourteen",
          "es": "Como en todos los -teen, el acento va al final: fourTEEN. En forty (40) va al principio."
        },
        {
          "ko": "That's a lot",
          "es": "«Es mucho / son muchos». Expresión muy frecuente."
        },
        {
          "ko": "Come on!",
          "es": "«¡Vamos!» o «¡Ándale!», para meter prisa."
        }
      ],
      "newItems": [
        "fourteen",
        "fifteen",
        "sixteen",
        "seventeen",
        "eighteen"
      ]
    },
    {
      "lessonId": "english-survival-07",
      "title": "¡Ya son las tres!",
      "scene": "home",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, what time is it?",
          "translation": "Ben, ¿qué hora es?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "It's three o'clock.",
          "translation": "Son las tres."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Oh no! My English class is at three!",
          "translation": "¡Ay, no! ¡Mi clase de inglés es a las tres!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Relax. Your class is on Monday.",
          "translation": "Tranquila. Tu clase es el lunes."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Monday? Ah, yes! Monday at three.",
          "translation": "¿El lunes? ¡Ah, sí! El lunes a las tres."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "How many students are in your class?",
          "translation": "¿Cuántos alumnos hay en tu clase?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Nineteen. No, twenty with me!",
          "translation": "Diecinueve. ¡No, veinte conmigo!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Twenty students! That's a big class.",
          "translation": "¡Veinte alumnos! Es una clase grande."
        }
      ],
      "notes": [
        {
          "ko": "It's three o'clock",
          "es": "o'clock (de «of the clock») solo se usa con horas exactas. El sujeto es it: «it is three»."
        },
        {
          "ko": "on Monday",
          "es": "Con días de la semana se usa on, y siempre van con mayúscula: Monday."
        },
        {
          "ko": "at three",
          "es": "Para la hora se usa at: at three = a las tres."
        }
      ],
      "newItems": [
        "nineteen",
        "twenty",
        "What time is it?",
        "It's three o'clock.",
        "Monday"
      ]
    },
    {
      "lessonId": "english-survival-08",
      "title": "Planes para la semana",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ana, are you free this week?",
          "translation": "Ana, ¿estás libre esta semana?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Tuesday and Thursday, no. I have class.",
          "translation": "El martes y el jueves no. Tengo clase."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "And Wednesday?",
          "translation": "¿Y el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Wednesday is OK.",
          "translation": "El miércoles me queda bien."
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Great! A museum on Wednesday?",
          "translation": "¡Genial! ¿Un museo el miércoles?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Good idea! And on Friday?",
          "translation": "¡Buena idea! ¿Y el viernes?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Friday is my mum's birthday. And on Saturday... football!",
          "translation": "El viernes es el cumpleaños de mi mamá. Y el sábado… ¡fútbol!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Football on Saturday? I want to come too!",
          "translation": "¿Fútbol el sábado? ¡Yo también quiero ir!"
        }
      ],
      "notes": [
        {
          "ko": "Wednesday",
          "es": "Ojo: la primera d no se pronuncia. Suena «uéns-dei»."
        },
        {
          "ko": "Thursday",
          "es": "th suena como la z de España (con la lengua entre los dientes): «zérs-dei»."
        },
        {
          "ko": "mum",
          "es": "mum es «mamá» en inglés británico; en Estados Unidos se dice mom."
        },
        {
          "ko": "I have class",
          "es": "Sin artículo: «I have class», igual que «tengo clase»."
        }
      ],
      "newItems": [
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ]
    },
    {
      "lessonId": "english-survival-09",
      "title": "Mercado de domingo",
      "scene": "market",
      "lines": [
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "I love Sunday markets.",
          "translation": "Me encantan los mercados de los domingos."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Me too! Ben, what's this?",
          "translation": "¡A mí también! Ben, ¿qué es esto?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "This? It's a Scotch egg. Do you want one?",
          "translation": "¿Esto? Es un huevo escocés. ¿Quieres uno?"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hmm... maybe. Is it spicy?",
          "translation": "Mmm… quizá. ¿Pica?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "No, it isn't.",
          "translation": "No, no pica."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Then no, thanks. I'm Mexican. I like spicy food!",
          "translation": "Entonces no, gracias. Soy mexicana. ¡Me gusta la comida picante!"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Ha! And this? Chilli sauce.",
          "translation": "¡Ja! ¿Y esto? Salsa de chile."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Yes, please!",
          "translation": "¡Sí, por favor!"
        }
      ],
      "notes": [
        {
          "ko": "this",
          "es": "this (esto/este) señala algo cercano; para algo más lejos se usa that."
        },
        {
          "ko": "Scotch egg",
          "es": "Huevo cocido envuelto en carne y empanizado: un clásico de los picnics británicos."
        },
        {
          "ko": "no, thanks",
          "es": "Los británicos casi nunca dicen solo «yes» o «no» al ofrecerles algo: «Yes, please» / «No, thanks»."
        },
        {
          "ko": "No, it isn't",
          "es": "Respuesta corta típica: se repite el verbo (is) en negativo en lugar de un simple «no»."
        }
      ],
      "newItems": [
        "Sunday",
        "yes",
        "no",
        "maybe",
        "this"
      ]
    },
    {
      "lessonId": "english-survival-10",
      "title": "Picnic en el parque",
      "scene": "park",
      "lines": [
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Ben, that person... is he your friend?",
          "translation": "Ben, esa persona… ¿es tu amigo?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes! That's Tom, my friend from school.",
          "translation": "¡Sí! Es Tom, mi amigo de la escuela."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "And that over there, near the trees?",
          "translation": "¿Y aquello de allá, junto a los árboles?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "That's my family! My mum, my dad and my sister.",
          "translation": "¡Es mi familia! Mi mamá, mi papá y mi hermana."
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Your family is in the park too?",
          "translation": "¿Tu familia también está en el parque?"
        },
        {
          "speaker": "Ben",
          "speakerEs": "Ben",
          "gender": "m",
          "text": "Yes, it's a picnic. Come on!",
          "translation": "Sí, es un picnic. ¡Ven!"
        },
        {
          "speaker": "Ana",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "Hello! I'm Ana, Ben's friend.",
          "translation": "¡Hola! Soy Ana, amiga de Ben."
        },
        {
          "speaker": "Ben's mum",
          "speakerEs": "Mamá de Ben",
          "gender": "f",
          "text": "Hello, Ana! Ben's friends are family. Sit down!",
          "translation": "¡Hola, Ana! Los amigos de Ben son de la familia. ¡Siéntate!"
        }
      ],
      "notes": [
        {
          "ko": "that over there",
          "es": "El inglés no distingue «eso» y «aquello»: usa that y añade over there («allá») si está lejos."
        },
        {
          "ko": "Ben's friend",
          "es": "El posesivo con 's: Ben's friend = la amiga de Ben. Se pone primero el dueño."
        },
        {
          "ko": "that person",
          "es": "person es singular; el plural normal es people (personas, gente)."
        },
        {
          "ko": "friend",
          "es": "friend sirve para hombre o mujer: «my friend» = mi amigo o mi amiga."
        }
      ],
      "newItems": [
        "that",
        "that over there",
        "person",
        "friend",
        "family"
      ]
