{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "korean-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "좋은 아침이에요!",
          "translation": "¡Buenos días!"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "안녕하세요! 좋은 아침이에요.",
          "translation": "¡Hola! Buenos días."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "이름이 뭐예요?",
          "translation": "¿Cómo te llamas?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "제 이름은 아나예요. 멕시코에서 왔어요.",
          "translation": "Me llamo Ana. Soy de México."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "만나서 반가워요, 아나 씨.",
          "translation": "Mucho gusto, Ana."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "저도 만나서 반가워요.",
          "translation": "Igualmente, mucho gusto."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "아나 씨, 여기 앉으세요.",
          "translation": "Ana, siéntate aquí."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 감사합니다.",
          "translation": "Sí, gracias."
        }
      ],
      "notes": [
        {
          "ko": "좋은 아침이에요",
          "es": "«Buen día». Es correcto, pero en Corea la mayoría simplemente dice 안녕하세요 a cualquier hora."
        },
        {
          "ko": "제 이름은",
          "es": "제 = «mi» cortés; 이름 = nombre; 은 marca el tema. «Mi nombre es…»."
        },
        {
          "ko": "만나서 반가워요",
          "es": "Literalmente «como nos conocimos, me alegro». Se dice al conocer a alguien; la respuesta típica es 저도 반가워요."
        }
      ],
      "newItems": [
        "안녕하세요",
        "좋은 아침이에요",
        "제 이름은 아나예요.",
        "만나서 반가워요."
      ]
    },
    {
      "lessonId": "korean-a11-identity-02",
      "title": "Compras por la noche",
      "scene": "shop",
      "lines": [
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "어서 오세요! 좋은 저녁이에요.",
          "translation": "¡Bienvenida! Buenas noches."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "안녕하세요. 물 한 병 부탁합니다.",
          "translation": "Hola. Una botella de agua, por favor."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "여기 있어요. 천 원이에요.",
          "translation": "Aquí tiene. Son mil wones."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "여기요.",
          "translation": "Tome."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "감사합니다.",
          "translation": "Gracias."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "봉지도 하나 부탁합니다.",
          "translation": "Y una bolsa también, por favor."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "네, 여기요. 안녕히 가세요!",
          "translation": "Sí, aquí tiene. ¡Que le vaya bien!"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "감사합니다. 안녕히 계세요!",
          "translation": "Gracias. ¡Hasta luego!"
        }
      ],
      "notes": [
        {
          "ko": "안녕히 가세요 / 안녕히 계세요",
          "es": "Hay dos «adiós»: 안녕히 가세요 («vaya en paz») se le dice a quien se va; 안녕히 계세요 («quédese en paz») a quien se queda. Aquí el dueño se queda y Ana se va."
        },
        {
          "ko": "부탁합니다",
          "es": "«Se lo encargo / por favor». Va después de lo que pides: 물 한 병 부탁합니다. Es más formal que 주세요."
        },
        {
          "ko": "어서 오세요",
          "es": "Saludo fijo de tiendas y restaurantes al entrar un cliente: «¡bienvenido!». No hace falta contestarlo."
        },
        {
          "ko": "좋은 저녁이에요",
          "es": "«Buenas noches» como saludo. Es comprensible, aunque los coreanos suelen decir sólo 안녕하세요."
        }
      ],
      "newItems": [
        "좋은 저녁이에요",
        "안녕히 가세요",
        "감사합니다.",
        "부탁합니다."
      ]
    },
    {
      "lessonId": "korean-a11-identity-03",
      "title": "El formulario de inscripción",
      "scene": "office",
      "lines": [
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "안녕하세요. 이름이 뭐예요?",
          "translation": "Hola. ¿Cómo te llamas?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아나예요.",
          "translation": "Ana."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "여기에 이름을 써 주세요.",
          "translation": "Escribe tu nombre aquí, por favor."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네. 여기요.",
          "translation": "Sí. Aquí está."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "나라는요?",
          "translation": "¿Y el país?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "저는 멕시코에서 왔어요.",
          "translation": "Soy de México."
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "멕시코! 여기에 나라 이름도 써 주세요.",
          "translation": "¡México! Escribe aquí también el nombre del país."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 다 썼어요!",
          "translation": "¡Listo, ya terminé!"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "감사합니다.",
          "translation": "Gracias."
        }
      ],
      "notes": [
        {
          "ko": "이름을",
          "es": "을 marca el objeto directo tras consonante (tras vocal, 를): 이름을 써요 = escribo el nombre."
        },
        {
          "ko": "써 주세요",
          "es": "De 쓰다 (escribir) + -어 주세요 (por favor). 쓰 + 어 se contrae en 써."
        },
        {
          "ko": "나라 이름",
          "es": "Dos sustantivos juntos: «nombre de país». En coreano no hace falta «de»: 나라 이름, 가족 사진."
        }
      ],
      "newItems": [
        "이름",
        "나라",
        "이름이 뭐예요?",
        "저는 멕시코에서 왔어요."
      ]
    },
    {
      "lessonId": "korean-a11-identity-04",
      "title": "¿Hablas coreano?",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "어서 오세요! 어느 나라 사람이에요?",
          "translation": "¡Bienvenida! ¿De qué país eres?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "멕시코 사람이에요.",
          "translation": "Soy mexicana."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "와, 한국어 잘해요!",
          "translation": "¡Vaya, hablas muy bien coreano!"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아니에요. 한국어를 조금 해요.",
          "translation": "No, qué va. Hablo un poco de coreano."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "멕시코에서는 무슨 언어를 써요?",
          "translation": "¿Qué idioma se habla en México?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "스페인어를 써요.",
          "translation": "Se habla español."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "오늘은 아인슈페너하고 플랫화이트가 맛있는데, 시즌 메뉴도 있어요!",
          "translation": "Hoy el einspänner y el flat white están buenísimos, ¡y también tenemos menú de temporada!"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "죄송해요. 이해하지 못해요.",
          "translation": "Perdón. No entiendo."
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "하하, 괜찮아요. 커피 어때요?",
          "translation": "Jaja, no pasa nada. ¿Qué tal un café?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 커피 주세요!",
          "translation": "¡Sí, un café, por favor!"
        }
      ],
      "notes": [
        {
          "ko": "멕시코 사람",
          "es": "Nacionalidad = país + 사람 (persona): 멕시코 사람 = mexicano/a, 한국 사람 = coreano/a."
        },
        {
          "ko": "한국어를 조금 해요",
          "es": "Con idiomas se usa 하다 (hacer): 한국어를 해요 = hablo coreano. 조금 = un poco."
        },
        {
          "ko": "아니에요",
          "es": "Respuesta modesta a un cumplido: «no, qué va». En Corea es de buena educación no aceptar los elogios de inmediato."
        },
        {
          "ko": "이해하지 못해요",
          "es": "-지 못해요 = «no puedo…». Es correcto pero suena algo formal; en la conversación diaria también se dice 이해가 안 돼요 o 잘 모르겠어요."
        }
      ],
      "newItems": [
        "언어",
        "사람",
        "한국어를 조금 해요.",
        "이해하지 못해요."
      ]
    }
  ]
}
