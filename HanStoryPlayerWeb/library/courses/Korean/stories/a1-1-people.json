{
  "unitId": "a1-1-people",
  "stories": [
    {
      "lessonId": "korean-a11-people-01",
      "title": "La tarea de la familia",
      "scene": "home",
      "lines": [
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "아나 씨, 뭐 해요?",
          "translation": "Ana, ¿qué haces?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "한국어 숙제를 해요. 가족 사진 숙제예요.",
          "translation": "Hago la tarea de coreano. Es sobre una foto de la familia.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "읽어 주세요!",
          "translation": "¡Léemela!",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "“이 사람들은 제 가족이에요. 이분은 제 어머니예요.”",
          "translation": "«Estas personas son mi familia. Ella es mi madre.»",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "“이분은 제 아버지예요. 이 사람은 카를로스예요. 그는 제 친구예요.”",
          "translation": "«Él es mi padre. Este es Carlos. Él es mi amigo.»",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "와, 잘 썼어요!",
          "translation": "¡Qué bien escrito!",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "어머니하고 아버지는 멕시코에 있어요?",
          "translation": "¿Tu mamá y tu papá están en México?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 멕시코시티에 있어요.",
          "translation": "Sí, están en la Ciudad de México.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "사람들",
          "es": "들 marca plural, pero en coreano se usa poco; aquí se usa porque son varias personas concretas: 이 사람들."
        },
        {
          "ko": "이분",
          "es": "분 es la forma respetuosa de 사람. Para presentar a padres o mayores se dice 이분, no 이 사람."
        },
        {
          "ko": "그는",
          "es": "그 (él) y 그녀 (ella) son propios del texto escrito, por eso Ana los usa al leer su tarea. Hablando se diría 이 사람은 o el nombre."
        },
        {
          "ko": "어머니",
          "es": "Ana llama 어머니 a la mamá de Minho: en Corea es normal dirigirse así a la madre de un amigo (más respetuoso aún: 어머님)."
        }
      ],
      "newItems": [
        "어머니",
        "아버지",
        "이 사람들은 제 가족이에요.",
        "그는 제 친구예요."
      ]
    },
    {
      "lessonId": "korean-a11-people-02",
      "title": "Hermanos menores",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 이 사진은 누구예요?",
          "translation": "Ana, ¿quién sale en esta foto?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "그녀는 제 여동생이에요. 이름은 루시아예요.",
          "translation": "Ella es mi hermana menor. Se llama Lucía.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "와, 아나 씨하고 많이 닮았어요!",
          "translation": "¡Se parece mucho a ti!",
          "gender": "m"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "남동생도 있어요?",
          "translation": "¿También tienes hermanos menores?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 저는 남동생이 두 명 있어요.",
          "translation": "Sí, tengo dos hermanos menores.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "와, 가족이 많아요! 저는 여동생이 한 명 있어요.",
          "translation": "¡Qué familia tan grande! Yo tengo una hermana menor.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨 여동생 이름은 뭐예요?",
          "translation": "¿Cómo se llama tu hermana, Minho?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "지은이에요. 대학생이에요.",
          "translation": "Jieun. Es universitaria.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "여동생 / 남동생",
          "es": "동생 = hermano/a menor; 여 (mujer) o 남 (hombre) delante precisan el sexo. Para los mayores hay palabras distintas según quien habla (형, 오빠, 누나, 언니)."
        },
        {
          "ko": "두 명",
          "es": "명 cuenta personas y va con números nativos: 한 명, 두 명, 세 명. 하나, 둘 se acortan a 한, 두 delante del contador."
        },
        {
          "ko": "남동생이 … 있어요",
          "es": "있어요 expresa «tener»: lo que se tiene lleva 이/가. «A mí, hermanos menores, hay dos.»"
        },
        {
          "ko": "그녀는",
          "es": "그녀 es muy literario; en la conversación sonaría más natural 제 여동생이에요 a secas."
        }
      ],
      "newItems": [
        "여동생",
        "남동생",
        "그녀는 제 여동생이에요.",
        "저는 남동생이 두 명 있어요."
      ]
    },
    {
      "lessonId": "korean-a11-people-03",
      "title": "¿Cuántos años tiene?",
      "scene": "park",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 저 아이는 누구예요?",
          "translation": "Minho, ¿quién es ese niño?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "제 친구 아들이에요. 이름은 하준이에요.",
          "translation": "Es el hijo de un amigo mío. Se llama Hajun.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "몇 살이에요?",
          "translation": "¿Cuántos años tiene?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "다섯 살이에요.",
          "translation": "Cinco.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "귀여워요! 그럼 저 남자는 누구예요?",
          "translation": "¡Qué lindo! ¿Y aquel hombre quién es?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "하준이 아버지예요. 제 친구예요.",
          "translation": "Es el papá de Hajun. Mi amigo.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨는 몇 살이에요?",
          "translation": "¿Y tú cuántos años tienes, Minho?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "하하, 비밀이에요!",
          "translation": "¡Jaja, es secreto!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "몇 살",
          "es": "몇 = cuántos; 살 = años de edad. La edad se dice con números nativos: 다섯 살 = cinco años."
        },
        {
          "ko": "저 아이",
          "es": "아이 = niño/a. 저 + persona señala a alguien lejos: 저 아이, 저 남자."
        },
        {
          "ko": "제 친구 아들",
          "es": "Varios sustantivos seguidos se leen como «de»: 제 친구 아들 = el hijo de mi amigo."
        },
        {
          "ko": "몇 살이에요?",
          "es": "En Corea preguntar la edad es normal: ayuda a saber cómo hablarse. Aun así, entre adultos a veces se esquiva con humor."
        }
      ],
      "newItems": [
        "친구",
        "아이",
        "누구예요?",
        "몇 살이에요?"
      ]
    },
    {
      "lessonId": "korean-a11-people-04",
      "title": "El restaurante de la mamá de Minho",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 이 식당이에요. 제 어머니는 여기에서 일해요.",
          "translation": "Ana, es este restaurante. Mi mamá trabaja aquí.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "정말요? 어머니가 어디에 있어요?",
          "translation": "¿En serio? ¿Dónde está tu mamá?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저 여자분이요. 저기, 부엌 앞에요.",
          "translation": "Aquella señora. Allá, frente a la cocina.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아! 그럼 저 남자분은요?",
          "translation": "¡Ah! ¿Y aquel señor?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저 남자분은 사장님이에요.",
          "translation": "Aquel señor es el dueño.",
          "gender": "m"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "아나 씨! 어서 와요.",
          "translation": "¡Ana! Bienvenida.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "안녕하세요, 어머니!",
          "translation": "¡Hola, señora!",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨는 어머니하고 같이 살아요?",
          "translation": "Minho, ¿vives con tu mamá?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "네, 우리는 함께 살아요.",
          "translation": "Sí, vivimos juntos.",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "여기에서 일해요",
          "es": "에서 marca el lugar donde se hace una acción: 여기에서 일해요 = trabaja aquí. Con 있어요 se usa 에: 여기에 있어요."
        },
        {
          "ko": "여자분 / 남자분",
          "es": "여자 = mujer, 남자 = hombre. Añadir 분 lo vuelve respetuoso: «aquella señora», «aquel señor»."
        },
        {
          "ko": "함께 / 같이",
          "es": "Ambos significan «juntos». 같이 es más coloquial; 함께 suena un poco más cuidado."
        },
        {
          "ko": "사장님",
          "es": "Literalmente «jefe/dueño» + 님. Así se llama a los dueños de tiendas y restaurantes, aunque no sepas si lo son."
        }
      ],
      "newItems": [
        "여자",
        "남자",
        "제 어머니는 여기에서 일해요.",
        "우리는 함께 살아요."
      ]
    }
  ]
}
