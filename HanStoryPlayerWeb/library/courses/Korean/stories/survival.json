{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "korean-survival-01",
      "title": "Llegada al aeropuerto",
      "scene": "airport",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨! 안녕하세요!",
          "translation": "¡Ana! ¡Hola!",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "안녕하세요, 민호 씨!",
          "translation": "¡Hola, Minho!",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 화장실이 어디예요?",
          "translation": "Minho, ¿dónde está el baño?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "화장실은 저쪽 끝에 있어요.",
          "translation": "El baño está allá, al fondo.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "잘 모르겠어요. 다시 말해 주세요.",
          "translation": "No entiendo bien. ¿Me lo repites, por favor?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저기예요. 저기!",
          "translation": "Es allá. ¡Allá!",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 저기! 감사합니다.",
          "translation": "¡Ah, allá! Gracias.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "안녕하세요",
          "es": "Saludo cortés que sirve a cualquier hora del día: equivale a «hola», «buenos días» o «buenas tardes»."
        },
        {
          "ko": "아나 씨",
          "es": "씨 se pone después del nombre de pila para tratar a alguien con cortesía entre iguales. Nunca se usa con el propio nombre."
        },
        {
          "ko": "다시 말해 주세요",
          "es": "말하다 = hablar, decir; -아/어 주세요 = «hágame el favor de…». Literalmente: «dígalo otra vez, por favor»."
        },
        {
          "ko": "감사합니다",
          "es": "Forma formal (합니다체) de «gracias». Se aprende como frase hecha y es perfecta con desconocidos."
        }
      ],
      "newItems": [
        "안녕하세요",
        "감사합니다",
        "잘 모르겠어요",
        "다시 말해 주세요",
        "화장실이 어디예요?"
      ]
    },
    {
      "lessonId": "korean-survival-02",
      "title": "En casa de la familia de Minho",
      "scene": "home",
      "lines": [
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "어서 와요! 아나 씨 맞죠? 들어와요, 들어와요!",
          "translation": "¡Bienvenida! Eres Ana, ¿verdad? ¡Pasa, pasa!",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "천천히 말해 주세요.",
          "translation": "Más despacio, por favor.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "아나… 씨… 예요?",
          "translation": "¿Eres… Ana?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 저는 아나예요. 안녕하세요.",
          "translation": "Sí, soy Ana. Mucho gusto.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "가방이 많아요. 괜찮아요?",
          "translation": "Traes muchas maletas. ¿Estás bien?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아… 도와주세요.",
          "translation": "Ay… ayúdeme, por favor.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "감사합니다. 이제 괜찮아요.",
          "translation": "Gracias. Ya estoy bien.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "강아지 이름이 뭐예요?",
          "translation": "¿Cómo se llama el perrito?",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "콩이예요.",
          "translation": "Se llama Kong.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "저는 아나예요",
          "es": "저 = «yo» cortés; 는 marca el tema; 예요 = «es/soy» tras un nombre que termina en vocal (tras consonante sería 이에요)."
        },
        {
          "ko": "괜찮아요",
          "es": "Comodín muy útil: «¿estás bien?» (con entonación de pregunta), «estoy bien», «no pasa nada» o «no, gracias»."
        },
        {
          "ko": "도와주세요",
          "es": "De 도와주다 (ayudar) + -세요 (petición cortés). Sirve para pedir ayuda en cualquier situación."
        },
        {
          "ko": "이름이 뭐예요?",
          "es": "Literalmente «¿el nombre qué es?». Con adultos mayores se prefiere una forma más respetuosa; con niños, amigos o mascotas está perfecto."
        }
      ],
      "newItems": [
        "천천히 말해 주세요.",
        "괜찮아요.",
        "도와주세요.",
        "저는 아나예요.",
        "이름이 뭐예요?"
      ]
    },
    {
      "lessonId": "korean-survival-03",
      "title": "Inscripción en la escuela",
      "scene": "school",
      "lines": [
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "안녕하세요. 이름이 뭐예요?",
          "translation": "Hola. ¿Cómo te llamas?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "저는 아나예요. 저는 멕시코에서 왔어요.",
          "translation": "Soy Ana. Soy de México.",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "전화번호가 뭐예요?",
          "translation": "¿Cuál es tu número de teléfono?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "영일영, 삼이일삼, 일이삼영이에요.",
          "translation": "Cero uno cero, tres dos uno tres, uno dos tres cero.",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "영일영, 삼이일삼… 다시 말해 주세요.",
          "translation": "Cero uno cero, tres dos uno tres… ¿me lo repites?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "일이삼영이에요.",
          "translation": "Uno dos tres cero.",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "감사합니다. 아나 씨는 삼 반이에요.",
          "translation": "Gracias. Ana, tú estás en el grupo tres.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "삼 반! 감사합니다.",
          "translation": "¡Grupo tres! Gracias.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "멕시코에서 왔어요",
          "es": "에서 = «desde»; 왔어요 = «vine» (pasado de 오다, venir). Literalmente «vine de México»: así se dice de dónde eres."
        },
        {
          "ko": "영일영",
          "es": "Los números de teléfono se dicen cifra por cifra con los números sinocoreanos (영, 일, 이, 삼…). Para el cero, en el habla diaria también se oye mucho 공."
        },
        {
          "ko": "삼 반",
          "es": "반 = grupo o clase escolar. Los grupos se numeran con números sinocoreanos: 일 반, 이 반, 삼 반."
        }
      ],
      "newItems": [
        "저는 멕시코에서 왔어요.",
        "영",
        "일",
        "이",
        "삼"
      ]
    },
    {
      "lessonId": "korean-survival-04",
      "title": "El número de Minho",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 전화번호가 뭐예요?",
          "translation": "Minho, ¿cuál es tu número?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "영일영, 사오육칠, 팔사오육이에요.",
          "translation": "Cero uno cero, cuatro cinco seis siete, ocho cuatro cinco seis.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "천천히 말해 주세요.",
          "translation": "Más despacio, por favor.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "영일영… 사, 오, 육, 칠…",
          "translation": "Cero uno cero… cuatro, cinco, seis, siete…",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "사오육칠…",
          "translation": "Cuatro cinco seis siete…",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "팔, 사, 오, 육.",
          "translation": "Ocho, cuatro, cinco, seis.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "영일영, 사오육칠, 팔사오육. 감사합니다!",
          "translation": "Cero uno cero, cuatro cinco seis siete, ocho cuatro cinco seis. ¡Gracias!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "전화번호",
          "es": "전화 = teléfono; 번호 = número. 전화번호가 뭐예요? es la forma normal de pedir un número."
        },
        {
          "ko": "사",
          "es": "사 (cuatro) suena igual que 死 «muerte», por eso en muchos edificios el piso 4 aparece como «F»."
        },
        {
          "ko": "육",
          "es": "육 (seis) se pronuncia [륙] cuando va después de otro número, como en 십육 [심뉵]. Aquí, cifra por cifra, suena simplemente 육."
        }
      ],
      "newItems": [
        "사",
        "오",
        "육",
        "칠",
        "팔"
      ]
    },
    {
      "lessonId": "korean-survival-05",
      "title": "¿Qué autobús tomamos?",
      "scene": "bus",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 우리 버스는 몇 번이에요?",
          "translation": "Minho, ¿qué número es nuestro autobús?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "십일 번이에요.",
          "translation": "Es el 11.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "저 버스! 십일 번이에요?",
          "translation": "¡Ese autobús! ¿Es el 11?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아니요, 저건 십이 번이에요.",
          "translation": "No, ese es el 12.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "구 번, 십 번, 십이 번, 십삼 번… 십일 번은 없어요?",
          "translation": "El 9, el 10, el 12, el 13… ¿No hay 11?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저기 와요! 십일 번!",
          "translation": "¡Ahí viene! ¡El 11!",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "와, 십일 번! 감사합니다, 민호 씨.",
          "translation": "¡Por fin, el 11! Gracias, Minho.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "번",
          "es": "번 = «número». Para líneas de autobús, asientos o turnos se usan números sinocoreanos + 번: 구 번, 십일 번."
        },
        {
          "ko": "십일",
          "es": "Del 11 al 19 se forman como «diez-uno», «diez-dos»…: 십일, 십이, 십삼. Fácil y regular."
        },
        {
          "ko": "저건",
          "es": "Contracción hablada de 저것은, «aquello (de allá)». La verás a fondo más adelante."
        }
      ],
      "newItems": [
        "구",
        "십",
        "십일",
        "십이",
        "십삼"
      ]
    },
    {
      "lessonId": "korean-survival-06",
      "title": "Página catorce",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "여러분, 책 십사 쪽을 보세요.",
          "translation": "Todos, abran el libro en la página 14.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "선생님, 다시 말해 주세요.",
          "translation": "Profesora, ¿lo puede repetir, por favor?",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "십사 쪽이에요.",
          "translation": "Es la página 14.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "감사합니다.",
          "translation": "Gracias.",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "숙제는 십오 쪽하고 십육 쪽이에요.",
          "translation": "La tarea son las páginas 15 y 16.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "십칠 쪽도요?",
          "translation": "¿También la 17?",
          "gender": "f"
        },
        {
          "speaker": "선생님",
          "speakerEs": "Profesora",
          "text": "아니요, 십칠 쪽하고 십팔 쪽은 내일 해요.",
          "translation": "No, la 17 y la 18 las hacemos mañana.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 알겠어요.",
          "translation": "Sí, entendido.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "쪽",
          "es": "쪽 = página. Se cuenta con números sinocoreanos: 십사 쪽 (página 14)."
        },
        {
          "ko": "선생님",
          "es": "Significa «maestro/a» y también se usa como forma de dirigirse a él o ella: en vez de su nombre, se dice 선생님."
        },
        {
          "ko": "하고",
          "es": "하고 = «y» entre sustantivos: 십오 쪽하고 십육 쪽 (la 15 y la 16)."
        },
        {
          "ko": "십육",
          "es": "Ojo con la pronunciación: 십육 suena [심뉵]."
        }
      ],
      "newItems": [
        "십사",
        "십오",
        "십육",
        "십칠",
        "십팔"
      ]
    },
    {
      "lessonId": "korean-survival-07",
      "title": "El lunes a las tres",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 지금 몇 시예요?",
          "translation": "Minho, ¿qué hora es?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "세 시예요.",
          "translation": "Son las tres.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "오늘이 십구 일이에요?",
          "translation": "¿Hoy es 19?",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "네, 십구 일이에요. 내일은 이십 일, 월요일이에요.",
          "translation": "Sí, es 19. Mañana es 20, lunes.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "월요일! 월요일에 한국어 수업이 있어요.",
          "translation": "¡Lunes! El lunes tengo clase de coreano.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "몇 시예요?",
          "translation": "¿A qué hora es?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "세 시예요.",
          "translation": "A las tres.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "세 시",
          "es": "¡Ojo! Las horas usan números coreanos nativos (한, 두, 세…): 세 시 = las tres. Los minutos y los días del mes usan sinocoreanos."
        },
        {
          "ko": "십구 일",
          "es": "일 aquí significa «día»: 십구 일 = día 19, 이십 일 = día 20."
        },
        {
          "ko": "월요일에",
          "es": "에 marca el momento en que pasa algo: 월요일에 = «el lunes»."
        }
      ],
      "newItems": [
        "십구",
        "이십",
        "몇 시예요?",
        "세 시예요.",
        "월요일"
      ]
    },
    {
      "lessonId": "korean-survival-08",
      "title": "Planes para el sábado",
      "scene": "school",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 한국어 수업이 언제예요?",
          "translation": "Ana, ¿cuándo tienes clase de coreano?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "월요일, 수요일, 금요일이에요.",
          "translation": "Lunes, miércoles y viernes.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "화요일하고 목요일은요?",
          "translation": "¿Y martes y jueves?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "화요일하고 목요일은 아르바이트해요.",
          "translation": "Martes y jueves trabajo medio tiempo.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "토요일은요?",
          "translation": "¿Y el sábado?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "토요일은 괜찮아요!",
          "translation": "¡El sábado estoy libre!",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
