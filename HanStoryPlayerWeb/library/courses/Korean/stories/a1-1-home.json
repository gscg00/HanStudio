{
  "unitId": "a1-1-home",
  "stories": [
    {
      "lessonId": "korean-a11-home-01",
      "title": "¿Dónde está mi celular?",
      "scene": "home",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 새 집이 좋아요!",
          "translation": "¡Ana, tu casa nueva está muy bien!"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "감사합니다. 작아요. 방이 하나 있어요.",
          "translation": "Gracias. Es pequeña. Tiene un cuarto."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "어? 제 휴대폰이 어디에 있어요?",
          "translation": "¿Eh? ¿Dónde está mi celular?"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "방에 있어요?",
          "translation": "¿Está en el cuarto?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "잘 모르겠어요…",
          "translation": "No sé…"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "제가 전화해요.",
          "translation": "Te marco."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 여기 있어요! 가방 안에 있어요.",
          "translation": "¡Ah, aquí está! Está dentro de la bolsa."
        }
      ],
      "notes": [
        {
          "ko": "어디에 있어요?",
          "es": "에 + 있어요 indica dónde está algo: 방에 있어요 = está en el cuarto. 어디에 있어요? = ¿dónde está?"
        },
        {
          "ko": "여기 있어요",
          "es": "«Aquí está». También se usa al entregar algo: «aquí tiene»."
        },
        {
          "ko": "가방 안에",
          "es": "Las posiciones se dicen «bolsa + interior + 에»: 가방 안에 = dentro de la bolsa."
        },
        {
          "ko": "휴대폰",
          "es": "Teléfono celular. En el habla diaria se dice mucho 핸드폰 o simplemente 폰."
        }
      ],
      "newItems": [
        "집",
        "방",
        "여기 있어요.",
        "어디에 있어요?"
      ]
    },
    {
      "lessonId": "korean-a11-home-02",
      "title": "Falta papel en el baño",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 부엌이 예뻐요. 이 컵은 누구 거예요?",
          "translation": "Ana, tu cocina está bonita. ¿De quién es esta taza?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "제 거예요. 멕시코 컵이에요.",
          "translation": "Es mía. Es una taza de México."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "화장실은 어디에 있어요?",
          "translation": "¿Dónde está el baño?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "부엌 옆에 있어요.",
          "translation": "Junto a la cocina."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨, 화장실에 휴지가 없어요!",
          "translation": "¡Ana, no hay papel en el baño!"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 미안해요! 휴지는 부엌에 있어요… 어? 여기에 없어요.",
          "translation": "¡Ay, perdón! El papel está en la cocina… ¿Eh? No está aquí."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "그럼 이 가방 안에 있어요?",
          "translation": "¿Y no está en esta bolsa?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 네! 여기 있어요.",
          "translation": "¡Ah, sí! Aquí está."
        }
      ],
      "notes": [
        {
          "ko": "제 거예요",
          "es": "거 es la forma hablada de 것 («cosa»): 제 거 = «mi cosa» = lo mío. 누구 거예요? = ¿de quién es?"
        },
        {
          "ko": "없어요",
          "es": "Lo contrario de 있어요: «no hay / no está». 여기에 없어요 = no está aquí."
        },
        {
          "ko": "화장실",
          "es": "Palabra general para «baño» (sobre todo el sanitario). 욕실 es el cuarto de baño con regadera."
        }
      ],
      "newItems": [
        "부엌",
        "화장실",
        "제 거예요.",
        "여기에 없어요."
      ]
    },
    {
      "lessonId": "korean-a11-home-03",
      "title": "Las llaves",
      "scene": "bedroom",
      "lines": [
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아나 씨 방은 어때요?",
          "translation": "¿Qué tal tu cuarto, Ana?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "제 방은 작아요. 침대하고 탁자하고 의자가 있어요.",
          "translation": "Mi cuarto es pequeño. Hay una cama, una mesa y una silla."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "좋아요! 그럼 이제 나가요.",
          "translation": "¡Está bien! Bueno, ya vámonos."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네. 그런데 열쇠가 어디에 있어요?",
          "translation": "Sí. Pero, ¿dónde están las llaves?"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "의자 위에 있어요?",
          "translation": "¿Están sobre la silla?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아니요, 의자 위에 없어요.",
          "translation": "No, no están en la silla."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아! 열쇠는 탁자 위에 있어요.",
          "translation": "¡Ah! Las llaves están sobre la mesa."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 감사합니다!",
          "translation": "¡Ay, gracias!"
        }
      ],
      "notes": [
        {
          "ko": "탁자 위에",
          "es": "위 = arriba/sobre. Igual que 안 (dentro): sustantivo + 위에 = sobre el sustantivo."
        },
        {
          "ko": "작아요",
          "es": "De 작다 (ser pequeño). En coreano los adjetivos se conjugan como verbos: 작아요 = es pequeño."
        },
        {
          "ko": "침대하고 탁자하고 의자",
          "es": "하고 une sustantivos en una lista: «cama, mesa y silla»."
        },
        {
          "ko": "탁자",
          "es": "탁자 es «mesa» en general; para mesas modernas también se oye mucho 테이블."
        }
      ],
      "newItems": [
        "탁자",
        "의자",
        "열쇠는 탁자 위에 있어요.",
        "제 방은 작아요."
      ]
    },
    {
      "lessonId": "korean-a11-home-04",
      "title": "La puerta abierta",
      "scene": "home",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "어? 문이 열려 있어요!",
          "translation": "¿Eh? ¡La puerta está abierta!"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "열쇠는요?",
          "translation": "¿Y la llave?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "열쇠는 여기 있어요. 제 가방에 있어요.",
          "translation": "La llave está aquí. Está en mi bolsa."
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "안에 누구 있어요?",
          "translation": "¿Hay alguien adentro?"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아무도 없어요. 어? 의자가 두 개 있어요.",
          "translation": "No hay nadie. ¿Eh? Hay dos sillas."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "어제는 하나였어요!",
          "translation": "¡Ayer había una!"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "아… 그건 제 의자예요. 어제 제가 가져왔어요.",
          "translation": "Ah… esa silla es mía. Ayer la traje yo."
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "그리고 문도 민호 씨가…?",
          "translation": "¿Y la puerta también fuiste tú…?"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "네… 미안해요!",
          "translation": "Sí… ¡perdón!"
        }
      ],
      "notes": [
        {
          "ko": "열려 있어요",
          "es": "-아/어 있어요 describe un estado que continúa: 열려 있어요 = está abierta (alguien la abrió y así sigue)."
        },
        {
          "ko": "두 개",
          "es": "개 cuenta cosas, con números nativos: 한 개, 두 개, 세 개."
        },
        {
          "ko": "열쇠는요?",
          "es": "Igual que 토요일은요?: sustantivo + 은요/는요 = «¿y…?»."
        },
        {
          "ko": "아무도 없어요",
          "es": "«No hay nadie». 아무도 siempre va con una forma negativa."
        }
      ],
      "newItems": [
        "문",
        "열쇠",
        "의자가 두 개 있어요.",
        "문이 열려 있어요."
      ]
    }
  ]
}
