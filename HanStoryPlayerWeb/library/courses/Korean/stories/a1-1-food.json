{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "korean-a11-food-01",
      "title": "Picnic improvisado",
      "scene": "park",
      "lines": [
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "민호 씨, 배고파요.",
          "translation": "Minho, tengo hambre.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저도요. 그리고 목말라요.",
          "translation": "Yo también. Y tengo sed.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "제 가방에 빵이 있어요. 같이 먹어요!",
          "translation": "Traigo pan en la bolsa. ¡Comamos juntos!",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "좋아요! 물도 있어요?",
          "translation": "¡Va! ¿También traes agua?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아니요, 물은 없어요.",
          "translation": "No, agua no tengo.",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저기 편의점이 있어요. 제가 물 사 올게요.",
          "translation": "Allá hay una tienda de conveniencia. Voy a comprar agua.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "감사합니다, 민호 씨!",
          "translation": "¡Gracias, Minho!",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "배고파요",
          "es": "Literalmente «el estómago (배) tiene hambre». En coreano el hambre es un estado: 배고파요 = tengo hambre."
        },
        {
          "ko": "목말라요",
          "es": "목 = garganta; 마르다 = secarse. «Se me seca la garganta» = tengo sed."
        },
        {
          "ko": "저도요",
          "es": "Respuesta rápida «yo también»: 저 + 도 + 요 (cortesía)."
        },
        {
          "ko": "물은 없어요",
          "es": "은/는 aquí contrasta: «pan sí, pero agua no»."
        }
      ],
      "newItems": [
        "물",
        "빵",
        "배고파요.",
        "목말라요."
      ]
    },
    {
      "lessonId": "korean-a11-food-02",
      "title": "En el restaurante",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "어서 오세요! 뭐 드릴까요?",
          "translation": "¡Bienvenidos! ¿Qué les sirvo?",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "이것을 원해요.",
          "translation": "(Señalando el menú) Quiero esto.",
          "gender": "f"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "이거요? 네, 알겠어요.",
          "translation": "¿Esto? Sí, claro.",
          "gender": "m"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "저도 같은 걸로 주세요. 커피도 있어요?",
          "translation": "Para mí lo mismo, por favor. ¿Tienen café también?",
          "gender": "m"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "네, 식사 후에 커피는 무료예요.",
          "translation": "Sí, después de la comida el café es gratis.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "와, 밥이 정말 맛있어요!",
          "translation": "¡Qué rico está el arroz!",
          "gender": "f"
        },
        {
          "speaker": "민호",
          "speakerEs": "Minho",
          "text": "사장님, 계산서 주세요.",
          "translation": "Disculpe, la cuenta, por favor.",
          "gender": "m"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "네, 여기 있어요. 감사합니다!",
          "translation": "Sí, aquí tiene. ¡Gracias!",
          "gender": "m"
        }
      ],
      "notes": [
        {
          "ko": "이것을 원해요",
          "es": "Gramaticalmente correcto («quiero esto»), pero al pedir comida un coreano diría 이거 주세요 («deme esto»). 원하다 suena formal."
        },
        {
          "ko": "밥",
          "es": "밥 es «arroz cocido» y también «comida» en general: 밥 먹었어요? = ¿ya comiste?"
        },
        {
          "ko": "계산서 주세요",
          "es": "En muchos restaurantes coreanos se paga en la caja al salir; también se oye 계산해 주세요 («cóbreme, por favor»)."
        },
        {
          "ko": "사장님",
          "es": "Así se llama al dueño o al encargado para pedir algo, en lugar de «¡disculpe!» o «¡joven!»."
        }
      ],
      "newItems": [
        "밥",
        "커피",
        "이것을 원해요.",
        "계산서 주세요."
      ]
    },
    {
      "lessonId": "korean-a11-food-03",
      "title": "Desayuno en casa de Minho",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "아나 씨, 아침 먹어요! 커피 마셔요?",
          "translation": "¡Ana, a desayunar! ¿Tomas café?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아니요, 저는 아침에 차를 마셔요.",
          "translation": "No, en las mañanas tomo té.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "그래요? 녹차가 있어요. 여기요.",
          "translation": "¿Ah, sí? Hay té verde. Toma.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "밥은 많이 먹어요?",
          "translation": "¿Comes mucho arroz?",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "밥을 조금 주세요. 아침에는 조금 먹어요.",
          "translation": "Un poco de arroz, por favor. En la mañana como poco.",
          "gender": "f"
        },
        {
          "speaker": "어머니",
          "speakerEs": "Mamá de Minho",
          "text": "그럼 사과도 먹어요.",
          "translation": "Entonces come también una manzana.",
          "gender": "f"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "와, 사과! 감사합니다.",
          "translation": "¡Una manzana! Gracias.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "차를 마셔요",
          "es": "차 = té (también significa «coche», según el contexto). 를/을 marca lo que se bebe."
        },
        {
          "ko": "녹차",
          "es": "녹 (verde) + 차 (té): té verde, la infusión más común en Corea."
        },
        {
          "ko": "밥을 조금 주세요",
          "es": "주세요 = «deme, por favor». 조금 antes del verbo: un poco."
        },
        {
          "ko": "아침에는",
          "es": "에 (tiempo) + 는 (contraste): «en la mañana (a diferencia de otras horas)»."
        }
      ],
      "newItems": [
        "차",
        "사과",
        "저는 아침에 차를 마셔요.",
        "밥을 조금 주세요."
      ]
    },
    {
      "lessonId": "korean-a11-food-04",
      "title": "En el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "어서 오세요! 오늘 고기가 좋아요!",
          "translation": "¡Pásele! ¡Hoy la carne está muy buena!",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "아, 저는 고기를 먹지 않아요.",
          "translation": "Ah, yo no como carne.",
          "gender": "f"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "그래요? 그럼 채소는요? 오이, 호박 다 있어요.",
          "translation": "¿Ah, sí? ¿Y verduras? Hay pepino, calabacita, de todo.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 오이하고 호박 주세요.",
          "translation": "Sí, deme pepino y calabacita.",
          "gender": "f"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "사과도 하나 먹어 봐요.",
          "translation": "Pruebe también una manzana.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "와, 이 사과는 맛있어요!",
          "translation": "¡Mmm, esta manzana está deliciosa!",
          "gender": "f"
        },
        {
          "speaker": "사장님",
          "speakerEs": "Dueño de la tienda",
          "text": "그렇죠? 사과도 사세요.",
          "translation": "¿Verdad que sí? Llévese manzanas también.",
          "gender": "m"
        },
        {
          "speaker": "아나",
          "speakerEs": "Ana",
          "text": "네, 사과 세 개 주세요.",
          "translation": "Sí, deme tres manzanas.",
          "gender": "f"
        }
      ],
      "notes": [
        {
          "ko": "먹지 않아요",
          "es": "-지 않아요 niega el verbo: 먹지 않아요 = no como. Muy útil para hablar de dietas."
        },
        {
          "ko": "이 사과는",
          "es": "는 aquí destaca «esta manzana en particular» frente a las demás."
        },
        {
          "ko": "먹어 봐요",
          "es": "-아/어 봐요 = «pruebe a…»: 먹어 봐요 = pruébelo. Los vendedores lo dicen mucho."
        },
        {
          "ko": "채소",
          "es": "채소 = verduras; en la calle también se oye 야채."
        }
      ],
      "newItems": [
        "고기",
        "채소",
        "이 사과는 맛있어요.",
        "저는 고기를 먹지 않아요."
      ]
    }
  ]
}
