{
  "unitId": "a1-1-routine",
  "stories": [
    {
      "lessonId": "arabic-a11-routine-01",
      "title": "Omar madruga",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "صباح الخير، آنا!",
          "reading": "sabāh al-khayr, Ānā!",
          "translation": "¡Buenos días, Ana!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "صباح الخير! أين عمر؟",
          "reading": "sabāh al-khayr! ayna ʿUmar?",
          "translation": "¡Buenos días! ¿Dónde está Omar?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "عمر يعمل.",
          "reading": "ʿUmar yaʿmal.",
          "translation": "Omar está trabajando."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "الآن؟",
          "reading": "al-ān?",
          "translation": "¿Ya?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "نعم. هو يستيقظ في الساعة السابعة كل يوم.",
          "reading": "naʿam. huwa yastayqiz fi s-sāʿa s-sābiʿa kull yawm.",
          "translation": "Sí. Se levanta a las siete todos los días."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "كل يوم؟",
          "reading": "kull yawm?",
          "translation": "¿Todos los días?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "نعم، ويعمل في مكتب.",
          "reading": "naʿam, wa-yaʿmal fī maktab.",
          "translation": "Sí, y trabaja en una oficina."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "وأنتِ؟",
          "reading": "wa-anti?",
          "translation": "¿Y usted?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "أنا أعمل في البيت كل يوم!",
          "reading": "ana aʿmal fi l-bayt kull yawm!",
          "translation": "¡Yo trabajo en casa todos los días!"
        }
      ],
      "notes": [
        {
          "ko": "يستيقظ",
          "es": "El prefijo يـ indica «él»: يعمل «trabaja», يستيقظ «se despierta». Con «yo» cambia a أ: أعمل."
        },
        {
          "ko": "في الساعة السابعة",
          "es": "«A la hora séptima» = «a las siete». س es letra solar, así que suena dos veces: fi s-sāʿa s-sābiʿa."
        },
        {
          "ko": "كل يوم",
          "es": "كل + sustantivo sin artículo = «cada»: كل يوم «cada día, todos los días»."
        },
        {
          "ko": "وأنتِ؟",
          "es": "El árabe no tiene «usted»: Ana trata de «tú» (أنتِ) a la madre de Omar. La cortesía se marca con el tono y con fórmulas como من فضلك."
        }
      ],
      "newItems": [
        "يستيقظ",
        "يعمل",
        "كل يوم",
        "في الساعة السابعة"
      ]
    },
    {
      "lessonId": "arabic-a11-routine-02",
      "title": "Lo que estudia Omar",
      "scene": "home",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "ليلى، عمر يأكل معنا؟",
          "reading": "Laylā, ʿUmar ya'kul maʿanā?",
          "translation": "Layla, ¿Omar come con nosotras?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "نعم، بعد العمل.",
          "reading": "naʿam, baʿd al-ʿamal.",
          "translation": "Sí, después del trabajo."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "وبعد ذلك؟",
          "reading": "wa-baʿd dhālik?",
          "translation": "¿Y después?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "بعد ذلك يدرس.",
          "reading": "baʿd dhālik yadrus.",
          "translation": "Después estudia."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "يدرس؟ ماذا يدرس؟",
          "reading": "yadrus? mādhā yadrus?",
          "translation": "¿Estudia? ¿Qué estudia?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "يدرس الإسبانية!",
          "reading": "yadrus al-isbāniyya!",
          "translation": "¡Estudia español!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "الإسبانية؟ متى؟",
          "reading": "al-isbāniyya? matā?",
          "translation": "¿Español? ¿Cuándo?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "قبل النوم، كل يوم!",
          "reading": "qabl an-nawm, kull yawm!",
          "translation": "¡Antes de dormir, todos los días!"
        }
      ],
      "notes": [
        {
          "ko": "قبل النوم",
          "es": "بعد = «después de», قبل = «antes de». Van seguidos directamente del sustantivo, sin «de»."
        },
        {
          "ko": "النوم",
          "es": "ن es letra solar: an-nawm. En cambio العمل lleva letra lunar: al-ʿamal."
        },
        {
          "ko": "بعد ذلك",
          "es": "«Después de eso», es decir, «luego». ذلك = «eso, aquello»."
        },
        {
          "ko": "ماذا يدرس؟",
          "es": "ماذا («qué») va delante del verbo. يدرس = «él estudia»."
        }
      ],
      "newItems": [
        "يدرس",
        "يأكل",
        "بعد العمل",
        "قبل النوم"
      ]
    },
    {
      "lessonId": "arabic-a11-routine-03",
      "title": "Té, café y siesta",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، متى تستيقظين؟",
          "reading": "Ānā, matā tastayqizīn?",
          "translation": "Ana, ¿a qué hora te levantas?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أستيقظ في الساعة السابعة.",
          "reading": "astayqiz fi s-sāʿa s-sābiʿa.",
          "translation": "Me levanto a las siete."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وماذا تشربين؟",
          "reading": "wa-mādhā tashrabīn?",
          "translation": "¿Y qué tomas?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أشرب القهوة. وأنتَ؟",
          "reading": "ashrab al-qahwa. wa-anta?",
          "translation": "Tomo café. ¿Y tú?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أنا أشرب الشاي، وأبي يشرب القهوة.",
          "reading": "ana ashrab ash-shāy, wa-abī yashrab al-qahwa.",
          "translation": "Yo tomo té, y mi papá toma café."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "ومتى تدرسين؟",
          "reading": "wa-matā tadrusīn?",
          "translation": "¿Y cuándo estudias?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أدرس بعد الظهر.",
          "reading": "adrus baʿd az-zuhr.",
          "translation": "Estudio por la tarde."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وأبي ينام بعد الظهر!",
          "reading": "wa-abī yanām baʿd az-zuhr!",
          "translation": "¡Y mi papá duerme la siesta por la tarde!"
        }
      ],
      "notes": [
        {
          "ko": "تستيقظين",
          "es": "Para hablarle a una mujer el verbo lleva تـ...ين: tastayqizīn, tashrabīn. A un hombre: تستيقظ, تشرب."
        },
        {
          "ko": "بعد الظهر",
          "es": "الظهر (az-zuhr) es el mediodía; «después del mediodía» = «por la tarde». La ظ es una «z» enfática, pronunciada con la lengua entre los dientes."
        },
        {
          "ko": "ينام",
          "es": "«Él duerme». En muchos países árabes la siesta después de comer (قيلولة) es costumbre."
        },
        {
          "ko": "الشاي",
          "es": "ش es letra solar (ash-shāy); ق es lunar (al-qahwa)."
        }
      ],
      "newItems": [
        "يشرب",
        "ينام",
        "أستيقظ في الساعة السابعة.",
        "أدرس بعد الظهر."
      ]
    },
    {
      "lessonId": "arabic-a11-routine-04",
      "title": "El domingo en familia",
      "scene": "home",
      "lines": [
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "آنا، غدًا يوم الأحد.",
          "reading": "Ānā, ghadan yawm al-ahad.",
          "translation": "Ana, mañana es domingo."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "يوم الأحد؟ عمر يعمل؟",
          "reading": "yawm al-ahad? ʿUmar yaʿmal?",
          "translation": "¿Domingo? ¿Omar trabaja?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "لا، لا أعمل يوم الأحد.",
          "reading": "lā, lā aʿmal yawm al-ahad.",
          "translation": "No, no trabajo el domingo."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "في الصباح نأكل معًا، كل العائلة.",
          "reading": "fi s-sabāh na'kul maʿan, kull al-ʿā'ila.",
          "translation": "Por la mañana comemos juntos, toda la familia."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "جميل! وفي الليل؟",
          "reading": "jamīl! wa-fi l-layl?",
          "translation": "¡Qué bonito! ¿Y por la noche?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "في الليل نشرب الشاي.",
          "reading": "fi l-layl nashrab ash-shāy.",
          "translation": "Por la noche tomamos té."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "صباح مع العائلة، وليل مع الشاي!",
          "reading": "sabāh maʿa l-ʿā'ila, wa-layl maʿa sh-shāy!",
          "translation": "¡Mañana con la familia y noche con té!"
        }
      ],
      "notes": [
        {
          "ko": "لا أعمل يوم الأحد",
          "es": "لا + presente = negación. Ojo cultural: en Egipto y el Golfo el fin de semana es viernes y sábado, y el domingo se trabaja; en Marruecos o Líbano se descansa el domingo."
        },
        {
          "ko": "نأكل معًا",
          "es": "El prefijo نـ marca «nosotros»: نأكل «comemos», نشرب «bebemos»."
        },
        {
          "ko": "الليل",
          "es": "ل es letra solar: la l del artículo se funde con la de ليل y suena doble: al-layl."
        },
        {
          "ko": "كل العائلة",
          "es": "كل + sustantivo con artículo = «todo/toda»: «toda la familia». Sin artículo (كل يوم) significa «cada»."
        }
      ],
      "newItems": [
        "صباح",
        "ليل",
        "نأكل معًا.",
        "لا أعمل يوم الأحد."
      ]
    }
  ]
}
