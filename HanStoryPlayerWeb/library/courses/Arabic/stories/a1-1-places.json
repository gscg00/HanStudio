{
  "unitId": "a1-1-places",
  "stories": [
    {
      "lessonId": "arabic-a11-places-01",
      "title": "¿Dónde está la estación?",
      "scene": "street",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، أين المحطة؟",
          "reading": "ʿUmar, ayna l-mahatta?",
          "translation": "Omar, ¿dónde está la estación?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "المحطة هناك، بعد البنك.",
          "reading": "al-mahatta hunāka, baʿd al-bank.",
          "translation": "La estación está allí, después del banco."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "البنك؟ أين البنك؟",
          "reading": "al-bank? ayna l-bank?",
          "translation": "¿El banco? ¿Dónde está el banco?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "إنه قريب. هناك!",
          "reading": "innahu qarīb. hunāka!",
          "translation": "Está cerca. ¡Allí!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "آه، البنك الكبير؟",
          "reading": "āh, al-bank al-kabīr?",
          "translation": "Ah, ¿el banco grande?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "نعم. والمحطة بعد البنك.",
          "reading": "naʿam. wa-l-mahatta baʿd al-bank.",
          "translation": "Sí. Y la estación está después del banco."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا، عمر!",
          "reading": "shukran, ʿUmar!",
          "translation": "¡Gracias, Omar!"
        }
      ],
      "notes": [
        {
          "ko": "أين المحطة؟",
          "es": "أين = «dónde». No hace falta verbo: «¿dónde la estación?»."
        },
        {
          "ko": "إنه قريب",
          "es": "Se refiere al banco (البنك, masculino). Para la estación, que es femenina, se diría إنها قريبة."
        },
        {
          "ko": "بنك",
          "es": "Préstamo del italiano/francés: bank. محطة es la palabra árabe para «estación», de un verbo que significa «hacer un alto»."
        },
        {
          "ko": "البنك الكبير",
          "es": "El adjetivo va detrás y, si el sustantivo lleva artículo, el adjetivo también: al-bank al-kabīr."
        }
      ],
      "newItems": [
        "محطة",
        "بنك",
        "أين المحطة؟",
        "إنه قريب."
      ]
    },
    {
      "lessonId": "arabic-a11-places-02",
      "title": "Camino al hospital",
      "scene": "street",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "عذرًا، أين المستشفى؟",
          "reading": "ʿudhran, ayna l-mustashfā?",
          "translation": "Disculpe, ¿dónde está el hospital?"
        },
        {
          "speaker": "الرجل",
          "speakerEs": "El hombre",
          "gender": "m",
          "text": "المستشفى؟ اذهب مستقيمًا.",
          "reading": "al-mustashfā? idhhab mustaqīman.",
          "translation": "¿El hospital? Siga recto."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "مستقيمًا؟ بعد المتجر؟",
          "reading": "mustaqīman? baʿd al-matjar?",
          "translation": "¿Recto? ¿Después de la tienda?"
        },
        {
          "speaker": "الرجل",
          "speakerEs": "El hombre",
          "gender": "m",
          "text": "نعم، بعد المتجر الكبير.",
          "reading": "naʿam, baʿd al-matjar al-kabīr.",
          "translation": "Sí, después de la tienda grande."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "شكرًا!",
          "reading": "shukran!",
          "translation": "¡Gracias!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، لماذا المستشفى؟",
          "reading": "ʿUmar, limādhā l-mustashfā?",
          "translation": "Omar, ¿por qué al hospital?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أبي يعمل هناك. هو طبيب.",
          "reading": "abī yaʿmal hunāk. huwa tabīb.",
          "translation": "Mi papá trabaja allí. Es médico."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "آه! أبوك طبيب!",
          "reading": "āh! abūka tabīb!",
          "translation": "¡Ah! ¡Tu papá es médico!"
        }
      ],
      "notes": [
        {
          "ko": "عذرًا",
          "es": "ʿudhran: «disculpe, perdón». Sirve para llamar la atención de un desconocido antes de preguntar."
        },
        {
          "ko": "اذهب مستقيمًا",
          "es": "اذهب es el imperativo «ve» dirigido a un hombre (el señor le habla a Omar). A una mujer se le diría اذهبي."
        },
        {
          "ko": "المستشفى",
          "es": "La ى final (alif maqsura) se lee como una a larga: al-mustashfā."
        },
        {
          "ko": "أبوك",
          "es": "A Omar, que es hombre, Ana le dice abūka; a una mujer se le diría abūki."
        }
      ],
      "newItems": [
        "متجر",
        "مستشفى",
        "اذهب مستقيمًا.",
        "عذرًا."
      ]
    },
    {
      "lessonId": "arabic-a11-places-03",
      "title": "Cada una a lo suyo",
      "scene": "street",
      "lines": [
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "صباح الخير، آنا! أين تذهبين؟",
          "reading": "sabāh al-khayr, Ānā! ayna tadhhabīn?",
          "translation": "¡Buenos días, Ana! ¿A dónde vas?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أذهب إلى المدرسة. وأنتِ؟",
          "reading": "adhhab ilā l-madrasa. wa-anti?",
          "translation": "Voy a la escuela. ¿Y tú?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "أنا أذهب إلى الحديقة مع صديقتي.",
          "reading": "ana adhhab ilā l-hadīqa maʿa sadīqatī.",
          "translation": "Yo voy al parque con mi amiga."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "الحديقة قريبة؟",
          "reading": "al-hadīqa qarība?",
          "translation": "¿El parque está cerca?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "نعم. وأنتِ، تذهبين بالقطار؟",
          "reading": "naʿam. wa-anti, tadhhabīn bi-l-qitār?",
          "translation": "Sí. Y tú, ¿vas en tren?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم. أين المحطة؟",
          "reading": "naʿam. ayna l-mahatta?",
          "translation": "Sí. ¿Dónde está la estación?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "المحطة على اليسار.",
          "reading": "al-mahatta ʿala l-yasār.",
          "translation": "La estación está a la izquierda."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا! إلى اللقاء!",
          "reading": "shukran! ilā l-liqā'!",
          "translation": "¡Gracias! ¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "أذهب إلى المدرسة",
          "es": "إلى = «a, hacia». أذهب = «voy»; a una mujer se le pregunta تذهبين («vas»)."
        },
        {
          "ko": "الحديقة قريبة",
          "es": "حديقة es femenina, así que قريب toma ة: قريبة. Ojo: حديقة es «jardín» o «parque»."
        },
        {
          "ko": "على اليسار",
          "es": "«A la izquierda», literalmente «sobre la izquierda». ي es letra lunar: al-yasār."
        },
        {
          "ko": "بالقطار",
          "es": "بـ + القطار = «en tren». بـ se pega a la palabra y la alif del artículo no se pronuncia: bi-l-qitār."
        }
      ],
      "newItems": [
        "مدرسة",
        "حديقة",
        "المحطة على اليسار.",
        "أذهب إلى المدرسة."
      ]
    },
    {
      "lessonId": "arabic-a11-places-04",
      "title": "¿Derecha o izquierda?",
      "scene": "street",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عذرًا، كيف أذهب إلى الحديقة؟",
          "reading": "ʿudhran, kayfa adhhab ilā l-hadīqa?",
          "translation": "Disculpe, ¿cómo llego al parque?"
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "اذهبي مستقيمًا. البنك قريب.",
          "reading": "idhhabī mustaqīman. al-bank qarīb.",
          "translation": "Siga recto. El banco está cerca."
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "بعد البنك، الحديقة على اليمين.",
          "reading": "baʿd al-bank, al-hadīqa ʿala l-yamīn.",
          "translation": "Pasando el banco, el parque está a la derecha."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "على اليمين أو على اليسار؟",
          "reading": "ʿala l-yamīn aw ʿala l-yasār?",
          "translation": "¿A la derecha o a la izquierda?"
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "على اليمين، ليس على اليسار.",
          "reading": "ʿala l-yamīn, laysa ʿala l-yasār.",
          "translation": "A la derecha, no a la izquierda."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا!",
          "reading": "shukran!",
          "translation": "¡Gracias!"
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "إلى اللقاء!",
          "reading": "ilā l-liqā'!",
          "translation": "¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "كيف أذهب إلى الحديقة؟",
          "es": "«¿Cómo voy a…?»: la forma más sencilla de pedir indicaciones. كيف = «cómo»."
        },
        {
          "ko": "اذهبي",
          "es": "El vendedor le habla a Ana, así que usa el imperativo femenino اذهبي (idhhabī), no اذهب."
        },
        {
          "ko": "اليمين",
          "es": "يمين = derecha, يسار = izquierda. يمين también significa «juramento»: se juraba levantando la mano derecha."
        },
        {
          "ko": "البنك قريب",
          "es": "بنك es masculino: قريب sin ة. Compáralo con الحديقة قريبة."
        }
      ],
      "newItems": [
        "يسار",
        "يمين",
        "البنك قريب.",
        "كيف أذهب إلى الحديقة؟"
      ]
    }
  ]
}
