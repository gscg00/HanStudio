{
  "unitId": "a1-1-food",
  "stories": [
    {
      "lessonId": "arabic-a11-food-01",
      "title": "Hambre y sed",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أمي، أنا جائع!",
          "reading": "ummī, ana jā'iʿ!",
          "translation": "¡Mamá, tengo hambre!"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "هناك خبز على الطاولة.",
          "reading": "hunāka khubz ʿala t-tāwila.",
          "translation": "Hay pan en la mesa."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "شكرًا! وأنا عطشان. أين الماء؟",
          "reading": "shukran! wa-ana ʿatshān. ayna l-mā'?",
          "translation": "¡Gracias! Y tengo sed. ¿Dónde está el agua?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "الماء هنا.",
          "reading": "al-mā' hunā.",
          "translation": "El agua está aquí."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "وأنا جائعة!",
          "reading": "wa-ana jā'iʿa!",
          "translation": "¡Yo también tengo hambre!"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "هذا خبز لك، آنا.",
          "reading": "hādhā khubz laki, Ānā.",
          "translation": "Aquí tienes pan, Ana."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا! وماء، من فضلك.",
          "reading": "shukran! wa-mā', min fadliki.",
          "translation": "¡Gracias! Y agua, por favor."
        }
      ],
      "notes": [
        {
          "ko": "جائعة",
          "es": "En árabe no se «tiene» hambre: se «está hambriento». Omar dice جائع; Ana, por ser mujer, جائعة."
        },
        {
          "ko": "أنا عطشان",
          "es": "«Estoy sediento». El femenino en árabe estándar es عطشى (ʿatshā); en el habla se oye mucho عطشانة."
        },
        {
          "ko": "الماء",
          "es": "م es letra lunar: al-mā'. La palabra termina en hamza (ء), un pequeño corte de voz."
        },
        {
          "ko": "خبز",
          "es": "khubz: la خ suena como la «j» española de «jamón»."
        }
      ],
      "newItems": [
        "ماء",
        "خبز",
        "أنا جائع.",
        "أنا عطشان."
      ]
    },
    {
      "lessonId": "arabic-a11-food-02",
      "title": "Cena en el restaurante",
      "scene": "restaurant",
      "lines": [
        {
          "speaker": "النادل",
          "speakerEs": "El mesero",
          "gender": "m",
          "text": "مساء الخير! ماذا تريدون؟",
          "reading": "masā' al-khayr! mādhā turīdūn?",
          "translation": "¡Buenas noches! ¿Qué desean?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أريد هذا.",
          "reading": "urīd hādhā.",
          "translation": "Quiero esto."
        },
        {
          "speaker": "النادل",
          "speakerEs": "El mesero",
          "gender": "m",
          "text": "سمك مع أرز؟",
          "reading": "samak maʿa aruzz?",
          "translation": "¿Pescado con arroz?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، سمك مع أرز، من فضلك.",
          "reading": "naʿam, samak maʿa aruzz, min fadlik.",
          "translation": "Sí, pescado con arroz, por favor."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وأنا أريد قهوة، من فضلك.",
          "reading": "wa-ana urīd qahwa, min fadlik.",
          "translation": "Y yo quiero un café, por favor."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "الحساب من فضلك.",
          "reading": "al-hisāb min fadlik.",
          "translation": "La cuenta, por favor."
        },
        {
          "speaker": "النادل",
          "speakerEs": "El mesero",
          "gender": "m",
          "text": "شكرًا!",
          "reading": "shukran!",
          "translation": "¡Gracias!"
        }
      ],
      "notes": [
        {
          "ko": "أريد هذا",
          "es": "أريد = «quiero» (yo). Señalar y decir أريد هذا funciona en cualquier restaurante o tienda."
        },
        {
          "ko": "ماذا تريدون؟",
          "es": "El mesero habla a los dos en plural (tú + tú = ustedes): ـون al final del verbo."
        },
        {
          "ko": "الحساب",
          "es": "حساب = «cuenta, cálculo». ح es lunar: al-hisāb. La ح es una h fuerte y áspera, sin raspar como la خ."
        },
        {
          "ko": "أرز",
          "es": "Se lee aruzz (con z doble). De esta palabra árabe viene el español «arroz»."
        }
      ],
      "newItems": [
        "أرز",
        "قهوة",
        "أريد هذا.",
        "الحساب من فضلك."
      ]
    },
    {
      "lessonId": "arabic-a11-food-03",
      "title": "Arroz en el desayuno",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "صباح الخير، آنا! قهوة أو شاي؟",
          "reading": "sabāh al-khayr, Ānā! qahwa aw shāy?",
          "translation": "¡Buenos días, Ana! ¿Café o té?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شاي، من فضلك. أشرب الشاي في الصباح.",
          "reading": "shāy, min fadliki. ashrab ash-shāy fi s-sabāh.",
          "translation": "Té, por favor. Por la mañana tomo té."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "وتفاحة؟",
          "reading": "wa-tuffāha?",
          "translation": "¿Y una manzana?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، شكرًا.",
          "reading": "naʿam, shukran.",
          "translation": "Sí, gracias."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أمي، أريد قليلًا من الأرز.",
          "reading": "ummī, urīd qalīlan min al-aruzz.",
          "translation": "Mamá, quiero un poco de arroz."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "أرز في الصباح؟!",
          "reading": "aruzz fi s-sabāh?!",
          "translation": "¿¡Arroz por la mañana!?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "نعم! أنا جائع!",
          "reading": "naʿam! ana jā'iʿ!",
          "translation": "¡Sí! ¡Tengo hambre!"
        }
      ],
      "notes": [
        {
          "ko": "تفاحة",
          "es": "تفاح es «manzanas» en general; con ة se refiere a una sola: تفاحة = «una manzana»."
        },
        {
          "ko": "قليلًا من الأرز",
          "es": "«Un poco de arroz». قليلًا se lee qalīlan; من aquí significa «de»."
        },
        {
          "ko": "في الصباح",
          "es": "ص es letra solar: fi s-sabāh. La ص es una «s» enfática, más grave que la س."
        },
        {
          "ko": "من فضلك. أشرب",
          "es": "Ana le habla a la madre de Omar, una mujer: min fadliki."
        }
      ],
      "newItems": [
        "شاي",
        "تفاحة",
        "أشرب الشاي في الصباح.",
        "أريد قليلًا من الأرز."
      ]
    },
    {
      "lessonId": "arabic-a11-food-04",
      "title": "No como carne",
      "scene": "home",
      "lines": [
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "آنا، هذا لحم وأرز.",
          "reading": "Ānā, hādhā lahm wa-aruzz.",
          "translation": "Ana, aquí hay carne con arroz."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا، لكن لا آكل اللحم.",
          "reading": "shukran, lākin lā ākul al-lahm.",
          "translation": "Gracias, pero no como carne."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "لا تأكلين اللحم؟",
          "reading": "lā ta'kulīn al-lahm?",
          "translation": "¿No comes carne?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا. آكل الخضروات.",
          "reading": "lā. ākul al-khadrawāt.",
          "translation": "No. Como verduras."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "عندنا خضروات كثيرة!",
          "reading": "ʿindanā khadrawāt kathīra!",
          "translation": "¡Tenemos muchas verduras!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وتفاحة من السوق، آنا؟",
          "reading": "wa-tuffāha min as-sūq, Ānā?",
          "translation": "¿Y una manzana del mercado, Ana?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا! هذه التفاحة لذيذة!",
          "reading": "shukran! hādhihi t-tuffāha ladhīdha!",
          "translation": "¡Gracias! ¡Esta manzana está deliciosa!"
        }
      ],
      "notes": [
        {
          "ko": "لا آكل اللحم",
          "es": "آكل (ākul) = «yo como»: la madda (آ) une la a del prefijo «yo» con la hamza de la raíz. لا delante lo niega."
        },
        {
          "ko": "اللحم",
          "es": "ل es letra solar: al-lahm, con l doble. La ح es una h fuerte, no una «j»."
        },
        {
          "ko": "خضروات كثيرة",
          "es": "Los plurales de cosas concuerdan en femenino singular: خضروات → كثيرة."
        },
        {
          "ko": "هذه التفاحة لذيذة",
          "es": "Demostrativo + sustantivo con artículo = «esta manzana». لذيذة va en femenino porque تفاحة es femenino."
        }
      ],
      "newItems": [
        "لحم",
        "خضروات",
        "هذه التفاحة لذيذة.",
        "لا آكل اللحم."
      ]
    }
  ]
}
