{
  "unitId": "a1-1-home",
  "stories": [
    {
      "lessonId": "arabic-a11-home-01",
      "title": "Bienvenida a casa",
      "scene": "home",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، هذا بيتنا.",
          "reading": "Ānā, hādhā baytunā.",
          "translation": "Ana, esta es nuestra casa."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "البيت كبير وجميل!",
          "reading": "al-bayt kabīr wa-jamīl!",
          "translation": "¡La casa es grande y bonita!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وهذه غرفتك.",
          "reading": "wa-hādhihi ghurfatuki.",
          "translation": "Y esta es tu habitación."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "غرفة جميلة! شكرًا، عمر.",
          "reading": "ghurfa jamīla! shukran, ʿUmar.",
          "translation": "¡Qué habitación tan bonita! Gracias, Omar."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، هاتفي... أين هو؟",
          "reading": "ʿUmar, hātifī... ayna huwa?",
          "translation": "Omar, mi teléfono… ¿dónde está?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "هاتفك؟ في الحقيبة؟",
          "reading": "hātifuki? fi l-haqība?",
          "translation": "¿Tu teléfono? ¿En la bolsa?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا... آه! إنه هنا.",
          "reading": "lā... āh! innahu hunā.",
          "translation": "No… ¡Ah! Aquí está."
        }
      ],
      "notes": [
        {
          "ko": "أين هو؟",
          "es": "El árabe no tiene «ello»: todo objeto es masculino o femenino. هاتف es masculino, así que se pregunta «¿dónde está él?»."
        },
        {
          "ko": "إنه هنا",
          "es": "إنّ + ـه («él»): forma enfática para «está aquí». Para algo femenino se dice إنها هنا."
        },
        {
          "ko": "بيتنا",
          "es": "بيت + نا («nuestro»). Los posesivos se pegan al final del sustantivo."
        },
        {
          "ko": "غرفتك",
          "es": "غرفة es femenina, por eso هذه. A Ana se le dice ghurfatuki («tu habitación», a una mujer)."
        }
      ],
      "newItems": [
        "بيت",
        "غرفة",
        "إنه هنا.",
        "أين هو؟"
      ]
    },
    {
      "lessonId": "arabic-a11-home-02",
      "title": "¿Dónde está mi taza?",
      "scene": "kitchen",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "هذا المطبخ، وهناك الحمّام.",
          "reading": "hādhā l-matbakh, wa-hunāka l-hammām.",
          "translation": "Esta es la cocina, y allí está el baño."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا. عمر، أين كوبي؟",
          "reading": "shukran. ʿUmar, ayna kūbī?",
          "translation": "Gracias. Omar, ¿dónde está mi taza?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "كوبك؟ ليس هنا.",
          "reading": "kūbuki? laysa hunā.",
          "translation": "¿Tu taza? Aquí no está."
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "هذا الكوب الأحمر؟",
          "reading": "hādhā l-kūb al-ahmar?",
          "translation": "¿Esta taza roja?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم! إنه لي.",
          "reading": "naʿam! innahu lī.",
          "translation": "¡Sí! Es mía."
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "كان في الحمّام!",
          "reading": "kāna fi l-hammām!",
          "translation": "¡Estaba en el baño!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "في الحمّام؟ لماذا؟",
          "reading": "fi l-hammām? limādhā?",
          "translation": "¿En el baño? ¿Por qué?"
        }
      ],
      "notes": [
        {
          "ko": "ليس هنا",
          "es": "ليس niega las frases sin verbo: هو هنا «está aquí» → ليس هنا «no está aquí»."
        },
        {
          "ko": "إنه لي",
          "es": "لي = لـ («para, de») + ي («mí»): «es mío». كوب es masculino en árabe, aunque «taza» sea femenino en español."
        },
        {
          "ko": "الحمّام",
          "es": "La ّ (shadda) duplica la consonante: hammām. Sin ella, حمام (hamām) significa «palomas»."
        },
        {
          "ko": "المطبخ",
          "es": "م es letra lunar: al-matbakh, con la l del artículo bien pronunciada."
        }
      ],
      "newItems": [
        "مطبخ",
        "حمّام",
        "إنه لي.",
        "ليس هنا."
      ]
    },
    {
      "lessonId": "arabic-a11-home-03",
      "title": "Una habitación pequeña",
      "scene": "bedroom",
      "lines": [
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "آنا، غرفتك جميلة؟",
          "reading": "Ānā, ghurfatuki jamīla?",
          "translation": "Ana, ¿te gusta tu habitación?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، شكرًا. غرفتي صغيرة، لكن مريحة.",
          "reading": "naʿam, shukran. ghurfatī saghīra, lākin murīha.",
          "translation": "Sí, gracias. Mi habitación es pequeña, pero cómoda."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "هناك سرير، وطاولة، وكرسي.",
          "reading": "hunāka sarīr, wa-tāwila, wa-kursī.",
          "translation": "Hay una cama, una mesa y una silla."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "وهذا الكرسي جديد.",
          "reading": "wa-hādhā l-kursī jadīd.",
          "translation": "Y esta silla es nueva."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا! وأين مفتاح الغرفة؟",
          "reading": "shukran! wa-ayna miftāh al-ghurfa?",
          "translation": "¡Gracias! ¿Y dónde está la llave del cuarto?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "المفتاح على الطاولة.",
          "reading": "al-miftāh ʿala t-tāwila.",
          "translation": "La llave está sobre la mesa."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "آه، نعم! شكرًا.",
          "reading": "āh, naʿam! shukran.",
          "translation": "¡Ah, sí! Gracias."
        }
      ],
      "notes": [
        {
          "ko": "غرفتي صغيرة",
          "es": "El adjetivo concuerda con el sustantivo: غرفة es femenino, así que صغير → صغيرة y مريح → مريحة."
        },
        {
          "ko": "على الطاولة",
          "es": "على = «sobre, encima de». ط es letra solar: ʿala t-tāwila."
        },
        {
          "ko": "هذا الكرسي جديد",
          "es": "كرسي es masculino (هذا, جديد), aunque «silla» sea femenino en español."
        },
        {
          "ko": "مفتاح الغرفة",
          "es": "«La llave de la habitación»: se ponen los dos sustantivos juntos y solo el segundo lleva artículo. No hace falta «de»."
        }
      ],
      "newItems": [
        "طاولة",
        "كرسي",
        "المفتاح على الطاولة.",
        "غرفتي صغيرة."
      ]
    },
    {
      "lessonId": "arabic-a11-home-04",
      "title": "¡La puerta está abierta!",
      "scene": "home",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر! الباب مفتوح!",
          "reading": "ʿUmar! al-bāb maftūh!",
          "translation": "¡Omar! ¡La puerta está abierta!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "مفتوح؟ وأين المفتاح؟",
          "reading": "maftūh? wa-ayna l-miftāh?",
          "translation": "¿Abierta? ¿Y dónde está la llave?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "المفتاح معي.",
          "reading": "al-miftāh maʿī.",
          "translation": "La llave la tengo yo."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "من في البيت؟",
          "reading": "man fi l-bayt?",
          "translation": "¿Quién está en casa?"
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "أنا! أنا في المطبخ.",
          "reading": "ana! ana fi l-matbakh.",
          "translation": "¡Yo! Estoy en la cocina."
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "هناك كرسيان هنا، وعندي شاي!",
          "reading": "hunāka kursiyyān hunā, wa-ʿindī shāy!",
          "translation": "Aquí hay dos sillas, ¡y tengo té!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا، ليلى!",
          "reading": "shukran, Laylā!",
          "translation": "¡Gracias, Layla!"
        }
      ],
      "notes": [
        {
          "ko": "الباب مفتوح",
          "es": "مفتوح = «abierto» (de فتح, «abrir»). باب es masculino, por eso no lleva ة."
        },
        {
          "ko": "هناك كرسيان",
          "es": "هناك significa «allí», pero al principio de la frase equivale a «hay». كرسيان es el dual de كرسي: «dos sillas»."
        },
        {
          "ko": "المفتاح معي",
          "es": "مع («con») + ي = «conmigo». Es la forma natural de decir «la llevo yo»."
        },
        {
          "ko": "من في البيت؟",
          "es": "مَن = «quién». Sin verbo: «¿quién en la casa?» = «¿quién está en casa?»."
        }
      ],
      "newItems": [
        "باب",
        "مفتاح",
        "هناك كرسيان.",
        "الباب مفتوح."
      ]
    }
  ]
}
