{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "arabic-survival-01",
      "title": "Buenos días en casa de Omar",
      "scene": "home",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "صباح الخير، آنا!",
          "reading": "sabāh al-khayr, Ānā!",
          "translation": "¡Buenos días, Ana!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "مرحبًا، عمر!",
          "reading": "marhaban, ʿUmar!",
          "translation": "¡Hola, Omar!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أهلًا وسهلًا!",
          "reading": "ahlan wa-sahlan!",
          "translation": "¡Bienvenida!"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "السلام عليكم.",
          "reading": "as-salāmu ʿalaykum.",
          "translation": "Hola."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "وعليكم السلام.",
          "reading": "wa-ʿalaykumu s-salām.",
          "translation": "Hola."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "أهلًا وسهلًا، آنا!",
          "reading": "ahlan wa-sahlan, Ānā!",
          "translation": "¡Bienvenida, Ana!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا!",
          "reading": "shukran!",
          "translation": "¡Gracias!"
        }
      ],
      "notes": [
        {
          "ko": "صباح الخير",
          "es": "Literalmente «mañana del bien». La respuesta típica es صباح النور (sabāh an-nūr, «mañana de luz»), aunque repetir صباح الخير también vale."
        },
        {
          "ko": "السلام عليكم",
          "es": "«La paz sea con ustedes». Termina en plural (ʿalaykum) aunque se lo digas a una sola persona. Se contesta invirtiendo el orden: وعليكم السلام, «y con ustedes la paz»."
        },
        {
          "ko": "أهلًا وسهلًا",
          "es": "Sirve para dar la bienvenida a alguien que llega a tu casa o a tu país. La traducción depende de a quién se le dice: aquí es «bienvenida» porque se lo dicen a Ana."
        },
        {
          "ko": "مرحبًا",
          "es": "«Hola», neutro y útil con cualquiera. La ـًا final se lee -an: marhaban."
        }
      ],
      "newItems": [
        "صباح الخير",
        "مرحبًا",
        "أهلًا وسهلًا",
        "السلام عليكم",
        "وعليكم السلام"
      ]
    },
    {
      "lessonId": "arabic-survival-02",
      "title": "Un libro en el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، السوق!",
          "reading": "Ānā, as-sūq!",
          "translation": "¡Ana, el mercado!"
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "مرحبًا! كتاب؟",
          "reading": "marhaban! kitāb?",
          "translation": "¡Hola! ¿Un libro?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا، شكرًا.",
          "reading": "lā, shukran.",
          "translation": "No, gracias."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، كتاب بالعربية!",
          "reading": "Ānā, kitāb bi-l-ʿarabiyya!",
          "translation": "¡Ana, un libro en árabe!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "بالعربية؟ نعم، من فضلك!",
          "reading": "bi-l-ʿarabiyya? naʿam, min fadlik!",
          "translation": "¿En árabe? ¡Sí, por favor!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا!",
          "reading": "shukran!",
          "translation": "¡Gracias!"
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "عفوًا.",
          "reading": "ʿafwan.",
          "translation": "De nada."
        }
      ],
      "notes": [
        {
          "ko": "من فضلك",
          "es": "«Por favor», literalmente «por tu bondad». Sin vocales se escribe igual, pero se pronuncia min fadlika a un hombre y min fadliki a una mujer. Ana le habla al vendedor, así que dice min fadlika (en el habla rápida, min fadlik)."
        },
        {
          "ko": "عفوًا",
          "es": "Es la respuesta normal a شكرًا: «de nada». También sirve para pedir perdón o disculpa, como «perdón» en español."
        },
        {
          "ko": "لا، شكرًا",
          "es": "«No, gracias»: la forma amable de rechazar algo en el mercado. لا es «no» y نعم es «sí»."
        },
        {
          "ko": "بالعربية",
          "es": "بـ (bi-, «en / con») se pega a la palabra siguiente: بالعربية = «en árabe»."
        }
      ],
      "newItems": [
        "لا",
        "شكرًا.",
        "نعم",
        "من فضلك.",
        "عفوًا"
      ]
    },
    {
      "lessonId": "arabic-survival-03",
      "title": "¿Cómo estás, Ana?",
      "scene": "street",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آسف، آنا!",
          "reading": "āsif, Ānā!",
          "translation": "¡Ay, perdón, Ana!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر! مرحبًا!",
          "reading": "ʿUmar! marhaban!",
          "translation": "¡Omar! ¡Hola!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "مرحبًا! كيف حالك؟",
          "reading": "marhaban! kayfa hāluki?",
          "translation": "¡Hola! ¿Cómo estás?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أنا بخير، الحمد لله. كيف حالك؟",
          "reading": "ana bi-khayr, al-hamdu li-llāh. kayfa hāluka?",
          "translation": "Estoy bien, gracias a Dios. ¿Y tú, cómo estás?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أنا بخير، الحمد لله. السوق الآن؟",
          "reading": "ana bi-khayr, al-hamdu li-llāh. as-sūq al-ān?",
          "translation": "Bien, gracias a Dios. ¿Vamos al mercado ahora?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا أفهم.",
          "reading": "lā afham.",
          "translation": "No entiendo."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آسف. السوق... الآن؟",
          "reading": "āsif. as-sūq... al-ān?",
          "translation": "Perdón. ¿Al mercado... ahora?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا، شكرًا. مع السلامة، عمر!",
          "reading": "lā, shukran. maʿa s-salāma, ʿUmar!",
          "translation": "No, gracias. ¡Adiós, Omar!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "مع السلامة!",
          "reading": "maʿa s-salāma!",
          "translation": "¡Adiós!"
        }
      ],
      "notes": [
        {
          "ko": "كيف حالك؟",
          "es": "«¿Cómo estás?». Sin vocales es igual (كيف حالك), pero Omar le dice kayfa hāluki a Ana y ella le contesta kayfa hāluka a él."
        },
        {
          "ko": "الحمد لله",
          "es": "«Gracias a Dios». Es la respuesta más común a «¿cómo estás?», la diga una persona creyente o no; funciona casi como un «muy bien»."
        },
        {
          "ko": "آسف",
          "es": "«Lo siento / perdón», pero en masculino: lo dice Omar. Ana diría آسفة (āsifa)."
        },
        {
          "ko": "مع السلامة",
          "es": "«Adiós», literalmente «con la seguridad», o sea «que te vaya bien». Lo dicen tanto quien se va como quien se queda."
        }
      ],
      "newItems": [
        "آسف",
        "كيف حالك؟",
        "أنا بخير، الحمد لله.",
        "لا أفهم.",
        "مع السلامة"
      ]
    }
  ]
}
