{
  "unitId": "a1-1-people",
  "stories": [
    {
      "lessonId": "arabic-a11-people-01",
      "title": "La foto de la familia",
      "scene": "home",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، هذه عائلتي.",
          "reading": "ʿUmar, hādhihi ʿā'ilatī.",
          "translation": "Omar, esta es mi familia."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "جميلة! هذه أمك؟",
          "reading": "jamīla! hādhihi ummuki?",
          "translation": "¡Qué bonita! ¿Esta es tu mamá?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، هذه أمي، وهذا أبي.",
          "reading": "naʿam, hādhihi ummī, wa-hādhā abī.",
          "translation": "Sí, esta es mi mamá y este es mi papá."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وهذا؟",
          "reading": "wa-hādhā?",
          "translation": "¿Y este?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "هو صديقي خوسيه.",
          "reading": "huwa sadīqī Khosé.",
          "translation": "Es mi amigo José."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "أمك وأبوك في المكسيك؟",
          "reading": "ummuki wa-abūki fi l-Maksīk?",
          "translation": "¿Tu mamá y tu papá están en México?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، في مدينة صغيرة.",
          "reading": "naʿam, fī madīna saghīra.",
          "translation": "Sí, en una ciudad pequeña."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "وأنا أم عمر!",
          "reading": "wa-ana umm ʿUmar!",
          "translation": "¡Y yo soy la mamá de Omar!"
        }
      ],
      "notes": [
        {
          "ko": "هذه عائلتي",
          "es": "عائلة («familia») termina en ة; al añadir ي («mi») la ة se convierte en ت: عائلتي (ʿā'ilatī)."
        },
        {
          "ko": "هذه أمي، وهذا أبي",
          "es": "هذه para femenino (madre) y هذا para masculino (padre). En español «esta/este» funciona igual."
        },
        {
          "ko": "أبوك",
          "es": "أب es una palabra especial: con posesivos se alarga. «Tu papá» (sujeto) es أبوكِ (abūki), pero «mi papá» es simplemente أبي (abī)."
        },
        {
          "ko": "هو صديقي",
          "es": "صديق («amigo») + ي = صديقي. Para una amiga se dice صديقة."
        }
      ],
      "newItems": [
        "أم",
        "أب",
        "هذه عائلتي.",
        "هو صديقي."
      ]
    },
    {
      "lessonId": "arabic-a11-people-02",
      "title": "La hermana de Omar",
      "scene": "park",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، هذه ليلى. هي أختي.",
          "reading": "Ānā, hādhihi Laylā. hiya ukhtī.",
          "translation": "Ana, ella es Layla. Es mi hermana."
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "مرحبًا، آنا! تشرّفت بلقائك.",
          "reading": "marhaban, Ānā! tasharraftu bi-liqā'iki.",
          "translation": "¡Hola, Ana! Mucho gusto."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "تشرّفت بلقائك، ليلى.",
          "reading": "tasharraftu bi-liqā'iki, Laylā.",
          "translation": "Mucho gusto, Layla."
        },
        {
          "speaker": "ليلى",
          "speakerEs": "Layla",
          "gender": "f",
          "text": "عندك أخ أو أخت؟",
          "reading": "ʿindaki akh aw ukht?",
          "translation": "¿Tienes hermanos o hermanas?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لديّ أخوان.",
          "reading": "ladayya akhawān.",
          "translation": "Tengo dos hermanos."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "وعندي أخت، اسمها صوفيا.",
          "reading": "wa-ʿindī ukht, ismuhā Sūfiyā.",
          "translation": "Y una hermana, se llama Sofía."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وأنا عندي أخت واحدة: ليلى!",
          "reading": "wa-ana ʿindī ukht wāhida: Laylā!",
          "translation": "Y yo tengo una sola hermana: ¡Layla!"
        }
      ],
      "notes": [
        {
          "ko": "أخ أو أخت",
          "es": "أخ = hermano, أخت = hermana, أو = «o». أختي = «mi hermana»."
        },
        {
          "ko": "لديّ أخوان",
          "es": "لديّ (ladayya) significa lo mismo que عندي: «tengo». أخوان es el dual de أخ: la terminación ـان (-ān) significa «dos», así que no hace falta el número."
        },
        {
          "ko": "اسمها",
          "es": "اسم + ها («de ella») = «su nombre». Igual que اسمي («mi nombre»)."
        },
        {
          "ko": "أخت واحدة",
          "es": "واحدة va en femenino porque concuerda con أخت. Detrás del sustantivo subraya «una sola»."
        }
      ],
      "newItems": [
        "أخت",
        "أخ",
        "هي أختي.",
        "لديّ أخوان."
      ]
    },
    {
      "lessonId": "arabic-a11-people-03",
      "title": "¿Cuántos años tienes?",
      "scene": "park",
      "lines": [
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، من هذا؟",
          "reading": "ʿUmar, man hādhā?",
          "translation": "Omar, ¿quién es?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "هذا كريم. هو صديق قديم.",
          "reading": "hādhā Karīm. huwa sadīq qadīm.",
          "translation": "Es Karim. Es un viejo amigo."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "والطفل؟",
          "reading": "wa-t-tifl?",
          "translation": "¿Y el niño?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "الطفل ابن كريم.",
          "reading": "at-tifl ibn Karīm.",
          "translation": "El niño es el hijo de Karim."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "مرحبًا! كم عمرك؟",
          "reading": "marhaban! kam ʿumruka?",
          "translation": "¡Hola! ¿Cuántos años tienes?"
        },
        {
          "speaker": "الطفل",
          "speakerEs": "El niño",
          "gender": "m",
          "text": "عمري خمس سنوات. وأنتِ؟ كم عمرك؟",
          "reading": "ʿumrī khams sanawāt. wa-anti? kam ʿumruki?",
          "translation": "Tengo cinco años. ¿Y tú? ¿Cuántos años tienes?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أنا؟ أنا كبيرة!",
          "reading": "ana? ana kabīra!",
          "translation": "¿Yo? ¡Yo ya soy grande!"
        }
      ],
      "notes": [
        {
          "ko": "كم عمرك؟",
          "es": "Literalmente «¿cuánta (es) tu edad?». عُمْر (ʿumr) = edad; se escribe igual que el nombre عُمَر (ʿUmar), solo cambian las vocales."
        },
        {
          "ko": "من هذا؟",
          "es": "مَن (man) = «quién». Para preguntar por una mujer se dice من هذه؟."
        },
        {
          "ko": "الطفل",
          "es": "ط es letra solar: at-tifl, sin la l del artículo."
        },
        {
          "ko": "أنا كبيرة",
          "es": "Ana es mujer, así que el adjetivo كبير toma la ة femenina: كبيرة."
        }
      ],
      "newItems": [
        "صديق",
        "طفل",
        "من هذا؟",
        "كم عمرك؟"
      ]
    },
    {
      "lessonId": "arabic-a11-people-04",
      "title": "Donde trabaja la mamá de Omar",
      "scene": "shop",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، هذا متجر صغير. أمي تعمل هنا.",
          "reading": "Ānā, hādhā matjar saghīr. ummī taʿmal hunā.",
          "translation": "Ana, esta es una tienda pequeña. Mi mamá trabaja aquí."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "هنا؟ ومن هذه المرأة؟",
          "reading": "hunā? wa-man hādhihi l-mar'a?",
          "translation": "¿Aquí? ¿Y quién es esa mujer?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "هي امرأة من هنا، صديقة أمي.",
          "reading": "hiya imra'a min hunā, sadīqat ummī.",
          "translation": "Es una mujer de aquí, amiga de mi mamá."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "والرجل؟",
          "reading": "wa-r-rajul?",
          "translation": "¿Y el hombre?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "الرجل هو المدير.",
          "reading": "ar-rajul huwa l-mudīr.",
          "translation": "El hombre es el jefe."
        },
        {
          "speaker": "الرجل",
          "speakerEs": "El hombre",
          "gender": "m",
          "text": "من هذه؟",
          "reading": "man hādhihi?",
          "translation": "¿Quién es ella?"
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "هي آنا، من المكسيك. نحن نعيش معًا.",
          "reading": "hiya Ānā, min al-Maksīk. nahnu naʿīsh maʿan.",
          "translation": "Es Ana, de México. Vivimos juntos."
        },
        {
          "speaker": "الرجل",
          "speakerEs": "El hombre",
          "gender": "m",
          "text": "مرحبًا، آنا!",
          "reading": "marhaban, Ānā!",
          "translation": "¡Hola, Ana!"
        }
      ],
      "notes": [
        {
          "ko": "أمي تعمل هنا",
          "es": "تعمل: el prefijo تـ indica «ella». «Él trabaja» sería يعمل."
        },
        {
          "ko": "المرأة",
          "es": "Sola es امرأة (imra'a); con artículo pierde la alif inicial: المرأة (al-mar'a). Es una de las pocas palabras que cambian así."
        },
        {
          "ko": "الرجل",
          "es": "ر es letra solar: ar-rajul. Sin artículo: رجل (rajul), «un hombre»."
        },
        {
          "ko": "نحن نعيش معًا",
          "es": "«Vivimos juntos». نعيش lleva el prefijo نـ de «nosotros». معًا se lee maʿan."
        }
      ],
      "newItems": [
        "امرأة",
        "رجل",
        "أمي تعمل هنا.",
        "نحن نعيش معًا."
      ]
    }
  ]
}
