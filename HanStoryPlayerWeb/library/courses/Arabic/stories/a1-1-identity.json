{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "arabic-a11-identity-01",
      "title": "Buenos días en casa de Omar",
      "scene": "home",
      "lines": [
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "صباح الخير، آنا!",
          "reading": "sabāh al-khayr, Ānā!",
          "translation": "¡Buenos días, Ana!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "صباح الخير، عمر!",
          "reading": "sabāh al-khayr, ʿUmar!",
          "translation": "¡Buenos días, Omar!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "آنا، هي أمي.",
          "reading": "Ānā, hiya ummī.",
          "translation": "Ana, ella es mi mamá."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "مرحبًا! أنتِ آنا؟",
          "reading": "marhaban! anti Ānā?",
          "translation": "¡Hola! ¿Tú eres Ana?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "مرحبًا! نعم، اسمي آنا.",
          "reading": "marhaban! naʿam, ismī Ānā.",
          "translation": "¡Hola! Sí, me llamo Ana."
        },
        {
          "speaker": "أم عمر",
          "speakerEs": "Mamá de Omar",
          "gender": "f",
          "text": "تشرّفت بلقائك، آنا.",
          "reading": "tasharraftu bi-liqā'iki, Ānā.",
          "translation": "Mucho gusto, Ana."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "تشرّفت بلقائك.",
          "reading": "tasharraftu bi-liqā'iki.",
          "translation": "Mucho gusto."
        }
      ],
      "notes": [
        {
          "ko": "صباح الخير",
          "es": "Literalmente «mañana del bien». Lo habitual es responder صباح النور (sabāh an-nūr, «mañana de la luz»), aunque repetir صباح الخير también es correcto."
        },
        {
          "ko": "مرحبًا",
          "es": "La terminación ـًا (dos trazos sobre la alif) se lee -an: marhaban. La alif final no se pronuncia como vocal larga."
        },
        {
          "ko": "تشرّفت بلقائك",
          "es": "«Me sentí honrado/a de conocerte». Sin vocales se escribe igual para hombre o mujer; a una mujer se le dice bi-liqā'iki y a un hombre bi-liqā'ika."
        },
        {
          "ko": "هي أمي",
          "es": "أم («madre») + ي («mi») = أمي. Otra vez sin verbo «ser»: «ella mi-madre»."
        }
      ],
      "newItems": [
        "مرحبًا",
        "صباح الخير",
        "اسمي آنا.",
        "تشرّفت بلقائك."
      ]
    },
    {
      "lessonId": "arabic-a11-identity-02",
      "title": "Una noche en el café",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "النادل",
          "speakerEs": "El mesero",
          "gender": "m",
          "text": "مساء الخير!",
          "reading": "masā' al-khayr!",
          "translation": "¡Buenas noches!"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "مساء الخير. قهوة، من فضلك.",
          "reading": "masā' al-khayr. qahwa, min fadlik.",
          "translation": "Buenas noches. Un café, por favor."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "وشاي، من فضلك.",
          "reading": "wa-shāy, min fadlik.",
          "translation": "Y un té, por favor."
        },
        {
          "speaker": "النادل",
          "speakerEs": "El mesero",
          "gender": "m",
          "text": "هذه القهوة، وهذا الشاي.",
          "reading": "hādhihi l-qahwa, wa-hādha sh-shāy.",
          "translation": "Aquí tienen el café y el té."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "شكرًا.",
          "reading": "shukran.",
          "translation": "Gracias."
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "شكرًا.",
          "reading": "shukran.",
          "translation": "Gracias."
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "عمر، أنا أذهب الآن. إلى اللقاء!",
          "reading": "ʿUmar, ana adhhab al-ān. ilā l-liqā'!",
          "translation": "Omar, ya me voy. ¡Adiós!"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "إلى اللقاء، آنا!",
          "reading": "ilā l-liqā', Ānā!",
          "translation": "¡Adiós, Ana!"
        }
      ],
      "notes": [
        {
          "ko": "مساء الخير",
          "es": "Saludo para la tarde y la noche, al llegar. Para despedirse de noche se usa otra fórmula: تصبح على خير («que amanezcas bien»)."
        },
        {
          "ko": "من فضلك",
          "es": "«Por favor». Ana se lo dice a un hombre: min fadlika. A una mujer se le diría min fadliki; sin vocales se escribe igual."
        },
        {
          "ko": "إلى اللقاء",
          "es": "Literalmente «hasta el encuentro»: el equivalente exacto de «hasta la vista». ل es letra solar: ilā l-liqā'."
        },
        {
          "ko": "هذه القهوة، وهذا الشاي",
          "es": "قهوة es femenino (termina en ة), por eso هذه; شاي es masculino, por eso هذا. Del árabe qahwa viene, vía el turco, la palabra «café»."
        }
      ],
      "newItems": [
        "مساء الخير",
        "إلى اللقاء",
        "شكرًا.",
        "من فضلك."
      ]
    },
    {
      "lessonId": "arabic-a11-identity-03",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "المعلمة",
          "speakerEs": "La maestra",
          "gender": "f",
          "text": "مرحبًا! ما اسمك؟",
          "reading": "marhaban! mā smuki?",
          "translation": "¡Hola! ¿Cómo te llamas?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "اسمي آنا.",
          "reading": "ismī Ānā.",
          "translation": "Me llamo Ana."
        },
        {
          "speaker": "المعلمة",
          "speakerEs": "La maestra",
          "gender": "f",
          "text": "آنا؟ اسم جميل! من أين أنتِ؟",
          "reading": "Ānā? ism jamīl! min ayna anti?",
          "translation": "¿Ana? ¡Qué nombre tan bonito! ¿De dónde eres?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أنا من المكسيك.",
          "reading": "ana min al-Maksīk.",
          "translation": "Soy de México."
        },
        {
          "speaker": "المعلمة",
          "speakerEs": "La maestra",
          "gender": "f",
          "text": "المكسيك بلد كبير وجميل.",
          "reading": "al-Maksīk balad kabīr wa-jamīl.",
          "translation": "México es un país grande y bonito."
        },
        {
          "speaker": "المعلمة",
          "speakerEs": "La maestra",
          "gender": "f",
          "text": "وأنتَ؟ ما اسمك؟",
          "reading": "wa-anta? mā smuka?",
          "translation": "¿Y tú? ¿Cómo te llamas?"
        },
        {
          "speaker": "عمر",
          "speakerEs": "Omar",
          "gender": "m",
          "text": "اسمي عمر. أنا من هنا.",
          "reading": "ismī ʿUmar. ana min hunā.",
          "translation": "Me llamo Omar. Soy de aquí."
        }
      ],
      "notes": [
        {
          "ko": "ما اسمك؟",
          "es": "Literalmente «¿qué (es) tu nombre?». A Ana se le dice mā smuki y a Omar mā smuka: la vocal final marca el género aunque no se escriba."
        },
        {
          "ko": "من أين",
          "es": "مِن (min) significa «de, desde»; no lo confundas con مَن (man, «quién»): se escriben igual. من أين = «¿de dónde?»."
        },
        {
          "ko": "المكسيك",
          "es": "Muchos nombres de países llevan artículo en árabe: المكسيك (al-Maksīk), como en español decimos «el Perú»."
        },
        {
          "ko": "بلد كبير وجميل",
          "es": "بلد es masculino, así que los adjetivos van en masculino y detrás del sustantivo: «país grande y bonito»."
        }
      ],
      "newItems": [
        "اسم",
        "بلد",
        "ما اسمك؟",
        "أنا من المكسيك."
      ]
    },
    {
      "lessonId": "arabic-a11-identity-04",
      "title": "Un poco de árabe",
      "scene": "shop",
      "lines": [
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "مساء الخير! ماذا تريدين؟",
          "reading": "masā' al-khayr! mādhā turīdīn?",
          "translation": "¡Buenas tardes! ¿Qué desea?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لا أفهم.",
          "reading": "lā afham.",
          "translation": "No entiendo."
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "أنتِ تتكلمين العربية؟",
          "reading": "anti tatakallamīn al-ʿarabiyya?",
          "translation": "¿Habla usted árabe?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "أتكلم العربية قليلًا.",
          "reading": "atakallam al-ʿarabiyya qalīlan.",
          "translation": "Hablo un poco de árabe."
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "وما لغتك؟",
          "reading": "wa-mā lughatuki?",
          "translation": "¿Y cuál es su idioma?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "لغتي الإسبانية. أنا من المكسيك.",
          "reading": "lughatī l-isbāniyya. ana min al-Maksīk.",
          "translation": "Mi idioma es el español. Soy de México."
        },
        {
          "speaker": "البائع",
          "speakerEs": "El vendedor",
          "gender": "m",
          "text": "في المكسيك، كل شخص يتكلم الإسبانية؟",
          "reading": "fi l-Maksīk, kull shakhs yatakallam al-isbāniyya?",
          "translation": "¿En México todo el mundo habla español?"
        },
        {
          "speaker": "آنا",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "نعم، الإسبانية لغة المكسيك.",
          "reading": "naʿam, al-isbāniyya lughat al-Maksīk.",
          "translation": "Sí, el español es el idioma de México."
        }
      ],
      "notes": [
        {
          "ko": "لا أفهم",
          "es": "لا delante de un verbo en presente lo niega: أفهم «entiendo» → لا أفهم «no entiendo»."
        },
        {
          "ko": "تتكلمين",
          "es": "El prefijo cambia con la persona: أَ- «yo» (atakallam), تَـ...ين «tú, mujer» (tatakallamīn). El vendedor usa la forma femenina porque habla con Ana."
        },
        {
          "ko": "العربية",
          "es": "ع es letra lunar: la ل del artículo sí suena: al-ʿarabiyya. Compáralo con الشاي (ash-shāy), donde no suena."
        },
        {
          "ko": "كل شخص",
          "es": "«Cada persona», es decir, «todo el mundo». شخص vale para hombres y mujeres."
        }
      ],
      "newItems": [
        "لغة",
        "شخص",
        "أتكلم العربية قليلًا.",
        "لا أفهم."
      ]
    }
  ]
}
