{
  "unitId": "survival",
  "stories": [
    {
      "lessonId": "chinese-survival-01",
      "title": "Llegada a Pekín",
      "scene": "airport",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜！你好！",
          "reading": "Ānnà! Nǐ hǎo!",
          "translation": "¡Ana! ¡Hola!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你好，小明！",
          "reading": "Nǐ hǎo, Xiǎomíng!",
          "translation": "¡Hola, Xiaoming!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "小明，洗手间在哪里？",
          "reading": "Xiǎomíng, xǐshǒujiān zài nǎlǐ?",
          "translation": "Xiaoming, ¿dónde está el baño?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "洗手间在那边，出口旁边。",
          "reading": "Xǐshǒujiān zài nàbiān, chūkǒu pángbiān.",
          "translation": "Está por allá, junto a la salida."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我听不懂。请再说一遍。",
          "reading": "Wǒ tīng bù dǒng. Qǐng zài shuō yí biàn.",
          "translation": "No te entiendo. ¿Me lo repites, por favor?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "那边！那边！",
          "reading": "Nàbiān! Nàbiān!",
          "translation": "¡Allá! ¡Allá!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "啊，那边！谢谢！",
          "reading": "À, nàbiān! Xièxie!",
          "translation": "¡Ah, allá! ¡Gracias!"
        }
      ],
      "notes": [
        {
          "ko": "你好",
          "es": "Saludo universal. Ojo al tono: dos terceros tonos seguidos (nǐ + hǎo) hacen que el primero suene como segundo tono: «ní hǎo»."
        },
        {
          "ko": "我听不懂",
          "es": "听 = escuchar; 不懂 = no entender. «Lo oigo, pero no lo entiendo». Útil cuando alguien habla rápido."
        },
        {
          "ko": "请再说一遍",
          "es": "请 = por favor; 再 = otra vez; 说 = decir; 一遍 = una vez (de principio a fin). 一 se pronuncia yí delante de un cuarto tono."
        },
        {
          "ko": "谢谢",
          "es": "La segunda sílaba va en tono neutro: xièxie, corta y ligera."
        }
      ],
      "newItems": [
        "你好！",
        "谢谢！",
        "我听不懂。",
        "请再说一遍。",
        "洗手间在哪里？"
      ]
    },
    {
      "lessonId": "chinese-survival-02",
      "title": "Regateo en el mercado",
      "scene": "market",
      "lines": [
        {
          "speaker": "老板",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "你好！要什么？",
          "reading": "Nǐ hǎo! Yào shénme?",
          "translation": "¡Hola! ¿Qué va a llevar?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你好！多少钱？",
          "reading": "Nǐ hǎo! Duōshao qián?",
          "translation": "¡Hola! ¿Cuánto cuesta?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "五块钱一斤，很甜的，你尝尝！",
          "reading": "Wǔ kuài qián yì jīn, hěn tián de, nǐ chángchang!",
          "translation": "Cinco yuanes el medio kilo, ¡están dulcísimas, pruebe!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "请说慢一点。你会说英语吗？",
          "reading": "Qǐng shuō màn yìdiǎn. Nǐ huì shuō Yīngyǔ ma?",
          "translation": "Más despacio, por favor. ¿Habla inglés?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "不会。五——块——钱。",
          "reading": "Bú huì. Wǔ — kuài — qián.",
          "translation": "No. Cin-co yua-nes."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "谢谢！我叫安娜。你叫什么名字？",
          "reading": "Xièxie! Wǒ jiào Ānnà. Nǐ jiào shénme míngzi?",
          "translation": "¡Gracias! Me llamo Ana. ¿Y usted cómo se llama?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedora",
          "gender": "f",
          "text": "我叫王丽。安娜，你好！",
          "reading": "Wǒ jiào Wáng Lì. Ānnà, nǐ hǎo!",
          "translation": "Me llamo Wang Li. ¡Hola, Ana!"
        }
      ],
      "notes": [
        {
          "ko": "多少钱",
          "es": "Literalmente «¿cuánto dinero?». 少 va en tono neutro: duōshao."
        },
        {
          "ko": "一斤",
          "es": "斤 es una unidad de peso de 500 g. En los mercados chinos los precios casi siempre se dan por 斤."
        },
        {
          "ko": "你会说英语吗",
          "es": "会 = saber hacer algo aprendido (idiomas, nadar, manejar). 吗 al final convierte la frase en pregunta de sí/no."
        },
        {
          "ko": "你叫什么名字",
          "es": "La pregunta conserva el orden de la respuesta: 我叫安娜 → 你叫什么名字. 什么 ocupa el lugar del dato que falta."
        }
      ],
      "newItems": [
        "请说慢一点。",
        "你会说英语吗？",
        "多少钱？",
        "我叫安娜。",
        "你叫什么名字？"
      ]
    },
    {
      "lessonId": "chinese-survival-03",
      "title": "Inscripción en la escuela",
      "scene": "school",
      "lines": [
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "你好！你叫什么名字？",
          "reading": "Nǐ hǎo! Nǐ jiào shénme míngzi?",
          "translation": "¡Hola! ¿Cómo te llamas?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你好！我叫安娜。我来自墨西哥。",
          "reading": "Nǐ hǎo! Wǒ jiào Ānnà. Wǒ láizì Mòxīgē.",
          "translation": "¡Hola! Me llamo Ana. Soy de México."
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "你的电话号码是多少？",
          "reading": "Nǐ de diànhuà hàomǎ shì duōshao?",
          "translation": "¿Cuál es tu número de teléfono?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "一三零，二三零一，三二一零。",
          "reading": "Yāo sān líng, èr sān líng yāo, sān èr yāo líng.",
          "translation": "Uno tres cero, dos tres cero uno, tres dos uno cero."
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "一三零，二三零一……后面呢？",
          "reading": "Yāo sān líng, èr sān líng yāo… hòumiàn ne?",
          "translation": "Uno tres cero, dos tres cero uno… ¿y lo demás?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "三二一零。",
          "reading": "Sān èr yāo líng.",
          "translation": "Tres dos uno cero."
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "好，谢谢！你在三班。",
          "reading": "Hǎo, xièxie! Nǐ zài sān bān.",
          "translation": "Bien, ¡gracias! Estás en el grupo tres."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "三班！谢谢老师！",
          "reading": "Sān bān! Xièxie lǎoshī!",
          "translation": "¡Grupo tres! ¡Gracias, maestra!"
        }
      ],
      "notes": [
        {
          "ko": "我来自墨西哥",
          "es": "来自 = «venir de». Es algo formal; en la conversación diaria también se oye 我是墨西哥人."
        },
        {
          "ko": "一三零",
          "es": "En números de teléfono, habitaciones o autobuses, 一 suele leerse yāo para no confundirlo con 七 (qī)."
        },
        {
          "ko": "零",
          "es": "líng = cero. Se dice siempre, también en medio de un número: 二三零一."
        },
        {
          "ko": "三班",
          "es": "班 = grupo o clase escolar. 老师 (maestro/a) sirve también como forma de tratamiento: 谢谢老师."
        }
      ],
      "newItems": [
        "我来自墨西哥。",
        "零",
        "一",
        "二",
        "三"
      ]
    },
    {
      "lessonId": "chinese-survival-04",
      "title": "Intercambio de números",
      "scene": "cafe",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，你的电话号码是多少？",
          "reading": "Ānnà, nǐ de diànhuà hàomǎ shì duōshao?",
          "translation": "Ana, ¿cuál es tu número de teléfono?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "一三零，四五六七，八八四五。",
          "reading": "Yāo sān líng, sì wǔ liù qī, bā bā sì wǔ.",
          "translation": "Uno tres cero, cuatro cinco seis siete, ocho ocho cuatro cinco."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "一三零，四五六……请说慢一点。",
          "reading": "Yāo sān líng, sì wǔ liù… qǐng shuō màn yìdiǎn.",
          "translation": "Uno tres cero, cuatro cinco seis… más despacio, por favor."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "一三零，四五六七，八——八——四——五。",
          "reading": "Yāo sān líng, sì wǔ liù qī, bā — bā — sì — wǔ.",
          "translation": "Uno tres cero, cuatro cinco seis siete, o-cho, o-cho, cua-tro, cin-co."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "好，我打给你。",
          "reading": "Hǎo, wǒ dǎ gěi nǐ.",
          "translation": "Va, te marco."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "喂，你好？",
          "reading": "Wéi, nǐ hǎo?",
          "translation": "¿Bueno? ¿Hola?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "你好！我叫小明！",
          "reading": "Nǐ hǎo! Wǒ jiào Xiǎomíng!",
          "translation": "¡Hola! ¡Me llamo Xiaoming!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "哈哈，谢谢，小明！",
          "reading": "Hāha, xièxie, Xiǎomíng!",
          "translation": "¡Jaja, gracias, Xiaoming!"
        }
      ],
      "notes": [
        {
          "ko": "四",
          "es": "sì (cuatro) y shí (diez) se parecen para el oído hispano: en sì la lengua va adelante; en shí se curva hacia atrás."
        },
        {
          "ko": "七",
          "es": "q en pinyin suena como una «ch» con mucho aire: qī. Nada que ver con la q española."
        },
        {
          "ko": "八八",
          "es": "El 8 (bā) es el número de la suerte: suena parecido a 发 (fā, prosperar). Un número con muchos 8 es un buen número."
        },
        {
          "ko": "喂",
          "es": "Así se contesta el teléfono: wéi (a veces wèi). Equivale a nuestro «¿bueno?» o «¿diga?»."
        }
      ],
      "newItems": [
        "四",
        "五",
        "六",
        "七",
        "八"
      ]
    },
    {
      "lessonId": "chinese-survival-05",
      "title": "Piso trece",
      "scene": "home",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，我家在十三楼。",
          "reading": "Ānnà, wǒ jiā zài shísān lóu.",
          "translation": "Ana, mi casa está en el piso trece."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "十三楼？好高啊！",
          "reading": "Shísān lóu? Hǎo gāo a!",
          "translation": "¿En el trece? ¡Qué alto!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "九、十、十一、十二……",
          "reading": "Jiǔ, shí, shíyī, shí'èr…",
          "translation": "Nueve, diez, once, doce…"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "十三！到了！",
          "reading": "Shísān! Dào le!",
          "translation": "¡Trece! ¡Llegamos!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你家是几号？",
          "reading": "Nǐ jiā shì jǐ hào?",
          "translation": "¿Qué número es tu departamento?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "一三零九。",
          "reading": "Yāo sān líng jiǔ.",
          "translation": "El 1309."
        },
        {
          "speaker": "小明妈妈",
          "speakerEs": "Mamá de Xiaoming",
          "gender": "f",
          "text": "你好！你是安娜吧？",
          "reading": "Nǐ hǎo! Nǐ shì Ānnà ba?",
          "translation": "¡Hola! Tú eres Ana, ¿verdad?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨好！我是安娜。",
          "reading": "Āyí hǎo! Wǒ shì Ānnà.",
          "translation": "¡Buenas, señora! Soy Ana."
        }
      ],
      "notes": [
        {
          "ko": "十三",
          "es": "Los números del 11 al 19 se forman sumando: 十 (diez) + 三 (tres) = trece. Muy regular."
        },
        {
          "ko": "楼",
          "es": "lóu = piso, planta de un edificio. El número va delante: 十三楼 = piso 13."
        },
        {
          "ko": "一三零九",
          "es": "Los números de departamento se leen cifra por cifra, y el 1 como yāo."
        },
        {
          "ko": "阿姨好",
          "es": "A la madre de un amigo se le llama 阿姨 (āyí, «tía»). Título + 好 es un saludo respetuoso."
        }
      ],
      "newItems": [
        "九",
        "十",
        "十一",
        "十二",
        "十三"
      ]
    },
    {
      "lessonId": "chinese-survival-06",
      "title": "Un sombrero a buen precio",
      "scene": "market",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你好！多少钱？",
          "reading": "Nǐ hǎo! Duōshao qián?",
          "translation": "¡Hola! ¿Cuánto cuesta?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "十八块。",
          "reading": "Shíbā kuài.",
          "translation": "Dieciocho yuanes."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "十八块？十五块，可以吗？",
          "reading": "Shíbā kuài? Shíwǔ kuài, kěyǐ ma?",
          "translation": "¿Dieciocho? ¿Lo deja en quince?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "十七块。",
          "reading": "Shíqī kuài.",
          "translation": "Diecisiete."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "十六块？",
          "reading": "Shíliù kuài?",
          "translation": "¿Dieciséis?"
        },
        {
          "speaker": "老板",
          "speakerEs": "Vendedor",
          "gender": "m",
          "text": "好吧，十六块。",
          "reading": "Hǎo ba, shíliù kuài.",
          "translation": "Bueno, va: dieciséis."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，我的帽子十四块！",
          "reading": "Ānnà, wǒ de màozi shísì kuài!",
          "translation": "¡Ana, el mío me costó catorce!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "啊？！",
          "reading": "Á?!",
          "translation": "¡¿Qué?!"
        }
      ],
      "notes": [
        {
          "ko": "块",
          "es": "En la calle se dice 块 (kuài) en vez de 元 (yuán), el nombre oficial del yuan."
        },
        {
          "ko": "可以吗",
          "es": "«¿Se puede?». Forma educada de proponer algo, perfecta para regatear."
        },
        {
          "ko": "好吧",
          "es": "吧 da un matiz de resignación o acuerdo: «bueno, está bien»."
        },
        {
          "ko": "十四",
          "es": "Cuidado: shísì (14) y sìshí (40) llevan las mismas sílabas en orden inverso."
        }
      ],
      "newItems": [
        "十四",
        "十五",
        "十六",
        "十七",
        "十八"
      ]
    },
    {
      "lessonId": "chinese-survival-07",
      "title": "¿A qué hora es la clase?",
      "scene": "school",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "小明，现在几点？",
          "reading": "Xiǎomíng, xiànzài jǐ diǎn?",
          "translation": "Xiaoming, ¿qué hora es?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "两点。",
          "reading": "Liǎng diǎn.",
          "translation": "Las dos."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我们的中文课几点？",
          "reading": "Wǒmen de Zhōngwén kè jǐ diǎn?",
          "translation": "¿A qué hora es nuestra clase de chino?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "三点。星期一，三点。",
          "reading": "Sān diǎn. Xīngqīyī, sān diǎn.",
          "translation": "A las tres. Los lunes, a las tres."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "教室是几号？",
          "reading": "Jiàoshì shì jǐ hào?",
          "translation": "¿Qué número de salón es?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "二十号。不对，十九号！",
          "reading": "Èrshí hào. Bú duì, shíjiǔ hào!",
          "translation": "El veinte. No, ¡el diecinueve!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "十九号还是二十号？",
          "reading": "Shíjiǔ hào háishi èrshí hào?",
          "translation": "¿El diecinueve o el veinte?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "十九号！三点。",
          "reading": "Shíjiǔ hào! Sān diǎn.",
          "translation": "¡El diecinueve! A las tres."
