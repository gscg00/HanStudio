        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "是，是我。五岁的我。",
          "reading": "Shì, shì wǒ. Wǔ suì de wǒ.",
          "translation": "Sí, soy yo. Yo a los cinco años."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "这是你妈妈吗？",
          "reading": "Zhè shì nǐ māma ma?",
          "translation": "¿Y ésta es tu mamá?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "不是，这是我姐姐。",
          "reading": "Bú shì, zhè shì wǒ jiějie.",
          "translation": "No, es mi hermana mayor."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你姐姐在北京吗？",
          "reading": "Nǐ jiějie zài Běijīng ma?",
          "translation": "¿Tu hermana vive en Pekín?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "不在，她在上海。星期日她可能来。",
          "reading": "Bú zài, tā zài Shànghǎi. Xīngqīrì tā kěnéng lái.",
          "translation": "No, está en Shanghái. Quizá venga el domingo."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "星期日？太好了！",
          "reading": "Xīngqīrì? Tài hǎo le!",
          "translation": "¿El domingo? ¡Qué bien!"
        }
      ],
      "notes": [
        {
          "ko": "是",
          "es": "El chino no tiene un «sí» universal: se responde repitiendo el verbo. A 这是你吗？ se contesta 是; a 在吗？, 在."
        },
        {
          "ko": "不是",
          "es": "不 cambia a segundo tono delante de un cuarto tono: bú shì."
        },
        {
          "ko": "可能",
          "es": "可能 = quizá, a lo mejor. Va delante del verbo: 她可能来."
        },
        {
          "ko": "星期日",
          "es": "En la conversación diaria es más común 星期天; 星期日 es un poco más formal o escrito."
        }
