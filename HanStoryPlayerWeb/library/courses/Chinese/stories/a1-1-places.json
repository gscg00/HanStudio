{
  "unitId": "a1-1-places",
  "stories": [
    {
      "lessonId": "chinese-a11-places-01",
      "title": "Buscando la estación",
      "scene": "street",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "你好！请问，车站在哪里？",
          "reading": "Nǐ hǎo! Qǐngwèn, chēzhàn zài nǎlǐ?",
          "translation": "¡Hola! Disculpe, ¿dónde está la estación?"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "m",
          "text": "地铁站吗？就在附近。",
          "reading": "Dìtiě zhàn ma? Jiù zài fùjìn.",
          "translation": "¿La del metro? Está aquí cerca."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "远不远？",
          "reading": "Yuǎn bu yuǎn?",
          "translation": "¿Está lejos?"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "m",
          "text": "不远，走路五分钟。",
          "reading": "Bù yuǎn, zǒulù wǔ fēnzhōng.",
          "translation": "No, a cinco minutos caminando."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "附近有银行吗？",
          "reading": "Fùjìn yǒu yínháng ma?",
          "translation": "¿Hay algún banco por aquí?"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "m",
          "text": "有，车站旁边就是银行。",
          "reading": "Yǒu, chēzhàn pángbiān jiù shì yínháng.",
          "translation": "Sí, justo al lado de la estación hay un banco."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "太好了！谢谢！",
          "reading": "Tài hǎo le! Xièxie!",
          "translation": "¡Perfecto! ¡Gracias!"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "m",
          "text": "不客气！",
          "reading": "Bú kèqi!",
          "translation": "¡De nada!"
        }
      ],
      "notes": [
        {
          "ko": "请问",
          "es": "«Permítame preguntar». La forma cortés de empezar una pregunta a un desconocido."
        },
        {
          "ko": "就在附近",
          "es": "附近 = cerca, alrededores. 就 añade énfasis: «justo aquí cerca»."
        },
        {
          "ko": "远不远",
          "es": "Pregunta afirmativo + negativo: 远不远？ = ¿está lejos o no? Equivale a 远吗？"
        },
        {
          "ko": "不客气",
          "es": "Respuesta a 谢谢: «de nada», literalmente «no hace falta tanta cortesía»."
        }
      ],
      "newItems": [
        "车站",
        "银行",
        "车站在哪里？",
        "就在附近。"
      ]
    },
    {
      "lessonId": "chinese-a11-places-02",
      "title": "Camino al hospital",
      "scene": "street",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "不好意思，医院在哪里？",
          "reading": "Bù hǎoyìsi, yīyuàn zài nǎlǐ?",
          "translation": "Disculpe, ¿dónde está el hospital?"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "f",
          "text": "医院？一直往前走。",
          "reading": "Yīyuàn? Yìzhí wǎng qián zǒu.",
          "translation": "¿El hospital? Siga todo recto."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "一直往前走……很远吗？",
          "reading": "Yìzhí wǎng qián zǒu… hěn yuǎn ma?",
          "translation": "Todo recto… ¿está muy lejos?"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "f",
          "text": "不远。你看，那个商店？医院就在商店后面。",
          "reading": "Bù yuǎn. Nǐ kàn, nàge shāngdiàn? Yīyuàn jiù zài shāngdiàn hòumiàn.",
          "translation": "No. ¿Ve aquella tienda? El hospital está justo detrás."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "好，谢谢！",
          "reading": "Hǎo, xièxie!",
          "translation": "¡Bien, gracias!"
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "f",
          "text": "不客气。你不舒服吗？",
          "reading": "Bú kèqi. Nǐ bù shūfu ma?",
          "translation": "De nada. ¿Se siente mal?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "不是，我朋友的妈妈在医院工作。",
          "reading": "Bú shì, wǒ péngyou de māma zài yīyuàn gōngzuò.",
          "translation": "No, la mamá de un amigo trabaja en el hospital."
        },
        {
          "speaker": "路人",
          "speakerEs": "Transeúnte",
          "gender": "f",
          "text": "哦，那就好！",
          "reading": "Ò, nà jiù hǎo!",
          "translation": "¡Ah, menos mal!"
        }
      ],
      "notes": [
        {
          "ko": "不好意思",
          "es": "Comodín: «disculpe» para llamar la atención y también «perdón, qué pena» por una pequeña molestia."
        },
        {
          "ko": "一直往前走",
          "es": "一直 = todo el tiempo, sin desviarse; 往前 = hacia adelante; 走 = caminar."
        },
        {
          "ko": "后面",
          "es": "后面 = detrás. Va después del lugar de referencia: 商店后面 = detrás de la tienda."
        },
        {
          "ko": "不舒服",
          "es": "«No estar cómodo», es decir, sentirse mal."
        }
      ],
      "newItems": [
        "商店",
        "医院",
        "一直往前走。",
        "不好意思。"
      ]
    },
    {
      "lessonId": "chinese-a11-places-03",
      "title": "Cada uno a lo suyo",
      "scene": "street",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，早！你去哪里？",
          "reading": "Ānnà, zǎo! Nǐ qù nǎlǐ?",
          "translation": "¡Buenos días, Ana! ¿A dónde vas?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我去学校。你呢？",
          "reading": "Wǒ qù xuéxiào. Nǐ ne?",
          "translation": "Voy a la escuela. ¿Y tú?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "我去公园跑步。",
          "reading": "Wǒ qù gōngyuán pǎobù.",
          "translation": "Voy al parque a correr."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "公园在哪里？",
          "reading": "Gōngyuán zài nǎlǐ?",
          "translation": "¿Dónde está el parque?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "在学校旁边。你看，车站在左边，公园在右边。",
          "reading": "Zài xuéxiào pángbiān. Nǐ kàn, chēzhàn zài zuǒbiān, gōngyuán zài yòubiān.",
          "translation": "Junto a la escuela. Mira: la estación está a la izquierda y el parque a la derecha."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "那我们一起走吧！",
          "reading": "Nà wǒmen yìqǐ zǒu ba!",
          "translation": "¡Entonces vamos juntos!"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "好！走吧！",
          "reading": "Hǎo! Zǒu ba!",
          "translation": "¡Va! ¡Vámonos!"
        }
      ],
      "notes": [
        {
          "ko": "我去学校",
          "es": "去 + lugar, sin preposición: 去学校 = ir a la escuela."
        },
        {
          "ko": "早",
          "es": "Forma corta y amistosa de 早上好."
        },
        {
          "ko": "车站在左边",
          "es": "Cosa + 在 + 左边/右边 = estar a la izquierda / derecha."
        },
        {
          "ko": "去公园跑步",
          "es": "Se puede encadenar: 去 + lugar + acción = ir a un lugar a hacer algo."
        }
      ],
      "newItems": [
        "学校",
        "公园",
        "车站在左边。",
        "我去学校。"
      ]
    },
    {
      "lessonId": "chinese-a11-places-04",
      "title": "Indicaciones por teléfono",
      "scene": "street",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "喂，小明！怎么去公园？",
          "reading": "Wéi, Xiǎomíng! Zěnme qù gōngyuán?",
          "translation": "¿Bueno? ¡Xiaoming! ¿Cómo llego al parque?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "你现在在哪里？",
          "reading": "Nǐ xiànzài zài nǎlǐ?",
          "translation": "¿Dónde estás ahora?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我在中国银行门口。",
          "reading": "Wǒ zài Zhōngguó Yínháng ménkǒu.",
          "translation": "En la entrada del Banco de China."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "好，银行就在附近，我知道。你往右边走。",
          "reading": "Hǎo, yínháng jiù zài fùjìn, wǒ zhīdào. Nǐ wǎng yòubiān zǒu.",
          "translation": "Ah, el banco está aquí cerca, ya sé cuál. Camina hacia la derecha."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "右边……有一个医院。",
          "reading": "Yòubiān… yǒu yí ge yīyuàn.",
          "translation": "A la derecha… hay un hospital."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "对！到了医院，往左边走，就是公园。",
          "reading": "Duì! Dàole yīyuàn, wǎng zuǒbiān zǒu, jiù shì gōngyuán.",
          "translation": "¡Eso! Al llegar al hospital, gira a la izquierda y ahí está el parque."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "左边……啊，我看见你了！",
          "reading": "Zuǒbiān… à, wǒ kànjiàn nǐ le!",
          "translation": "A la izquierda… ¡ah, ya te vi!"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "我也看见你了！",
          "reading": "Wǒ yě kànjiàn nǐ le!",
          "translation": "¡Yo también te veo!"
        }
      ],
      "notes": [
        {
          "ko": "怎么去",
          "es": "怎么 + verbo = ¿cómo se hace?: 怎么去公园？ = ¿cómo se va al parque?"
        },
        {
          "ko": "往右边走",
          "es": "往 = hacia. 往右边走 = camina hacia la derecha."
        },
        {
          "ko": "就是",
          "es": "«Justo ahí es». 就 da énfasis: «y ahí mismo está el parque»."
        },
        {
          "ko": "看见",
          "es": "看 = mirar; 看见 = ver (lograr ver). 了 indica que ya pasó."
        }
      ],
      "newItems": [
        "左边",
        "右边",
        "银行就在附近。",
        "怎么去公园？"
      ]
    }
  ]
}
