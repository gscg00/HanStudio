{
  "unitId": "a1-1-identity",
  "stories": [
    {
      "lessonId": "chinese-a11-identity-01",
      "title": "Primer día de clase",
      "scene": "classroom",
      "lines": [
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "早上好！",
          "reading": "Zǎoshang hǎo!",
          "translation": "¡Buenos días!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "早上好，老师！",
          "reading": "Zǎoshang hǎo, lǎoshī!",
          "translation": "¡Buenos días, maestra!"
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "你是新同学吧？你叫什么名字？",
          "reading": "Nǐ shì xīn tóngxué ba? Nǐ jiào shénme míngzi?",
          "translation": "Eres alumna nueva, ¿verdad? ¿Cómo te llamas?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我叫安娜。",
          "reading": "Wǒ jiào Ānnà.",
          "translation": "Me llamo Ana."
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "安娜，你好！我姓李。",
          "reading": "Ānnà, nǐ hǎo! Wǒ xìng Lǐ.",
          "translation": "¡Hola, Ana! Me apellido Li."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "李老师，很高兴认识你。",
          "reading": "Lǐ lǎoshī, hěn gāoxìng rènshi nǐ.",
          "translation": "Maestra Li, mucho gusto."
        },
        {
          "speaker": "李老师",
          "speakerEs": "Profesora Li",
          "gender": "f",
          "text": "我也很高兴认识你。请坐！",
          "reading": "Wǒ yě hěn gāoxìng rènshi nǐ. Qǐng zuò!",
          "translation": "Igualmente. ¡Siéntate, por favor!"
        }
      ],
      "notes": [
        {
          "ko": "早上好",
          "es": "Sólo por la mañana. 你好 sirve a cualquier hora."
        },
        {
          "ko": "我姓李",
          "es": "姓 = apellidarse. Al maestro se le llama por el apellido + 老师: 李老师."
        },
        {
          "ko": "很高兴认识你",
          "es": "Literalmente «muy contento de conocerte». Se responde con 我也很高兴认识你 (yo también)."
        }
      ],
      "newItems": [
        "你好",
        "早上好",
        "我叫安娜。",
        "很高兴认识你。"
      ]
    },
    {
      "lessonId": "chinese-a11-identity-02",
      "title": "Cena en casa de Xiaoming",
      "scene": "home",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨，晚上好！",
          "reading": "Āyí, wǎnshang hǎo!",
          "translation": "¡Buenas noches, señora!"
        },
        {
          "speaker": "小明妈妈",
          "speakerEs": "Mamá de Xiaoming",
          "gender": "f",
          "text": "安娜，晚上好！请进，请进！",
          "reading": "Ānnà, wǎnshang hǎo! Qǐng jìn, qǐng jìn!",
          "translation": "¡Buenas noches, Ana! ¡Pasa, pasa!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨，请。",
          "reading": "Āyí, qǐng.",
          "translation": "Usted primero, señora."
        },
        {
          "speaker": "小明妈妈",
          "speakerEs": "Mamá de Xiaoming",
          "gender": "f",
          "text": "谢谢。来，喝茶。",
          "reading": "Xièxie. Lái, hē chá.",
          "translation": "Gracias. Ven, toma un té."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "谢谢。",
          "reading": "Xièxie.",
          "translation": "Gracias."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨，很晚了。我回家了。",
          "reading": "Āyí, hěn wǎn le. Wǒ huí jiā le.",
          "translation": "Señora, ya es tarde. Me voy a casa."
        },
        {
          "speaker": "小明妈妈",
          "speakerEs": "Mamá de Xiaoming",
          "gender": "f",
          "text": "好，再来玩儿啊！",
          "reading": "Hǎo, zài lái wánr a!",
          "translation": "¡Bueno, vuelve pronto!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "谢谢阿姨！再见！",
          "reading": "Xièxie āyí! Zàijiàn!",
          "translation": "¡Gracias, señora! ¡Adiós!"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "再见，安娜！",
          "reading": "Zàijiàn, Ānnà!",
          "translation": "¡Adiós, Ana!"
        }
      ],
      "notes": [
        {
          "ko": "晚上好",
          "es": "Se usa al llegar, como saludo. Para despedirse de noche no sirve: se dice 再见 o 晚安 (buenas noches, al irse a dormir)."
        },
        {
          "ko": "请",
          "es": "Solo, con un gesto, significa «pase usted / usted primero». Muy cortés."
        },
        {
          "ko": "再来玩儿啊",
          "es": "«Vuelve a visitarnos». 玩儿 (wánr) con la -r final es típico del acento de Pekín."
        },
        {
          "ko": "再见",
          "es": "再 = otra vez; 见 = ver. «Hasta la vista»."
        }
      ],
      "newItems": [
        "晚上好",
        "再见",
        "谢谢。",
        "请。"
      ]
    },
    {
      "lessonId": "chinese-a11-identity-03",
      "title": "En la oficina de registro",
      "scene": "office",
      "lines": [
        {
          "speaker": "工作人员",
          "speakerEs": "Empleada",
          "gender": "f",
          "text": "你好！你叫什么名字？",
          "reading": "Nǐ hǎo! Nǐ jiào shénme míngzi?",
          "translation": "¡Hola! ¿Cómo te llamas?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我叫安娜·洛佩斯。",
          "reading": "Wǒ jiào Ānnà Luòpèisī.",
          "translation": "Me llamo Ana López."
        },
        {
          "speaker": "工作人员",
          "speakerEs": "Empleada",
          "gender": "f",
          "text": "名字是\"安娜\"，对吗？",
          "reading": "Míngzi shì \"Ānnà\", duì ma?",
          "translation": "El nombre es «Ana», ¿verdad?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "对。",
          "reading": "Duì.",
          "translation": "Sí."
        },
        {
          "speaker": "工作人员",
          "speakerEs": "Empleada",
          "gender": "f",
          "text": "你是哪个国家的人？",
          "reading": "Nǐ shì nǎge guójiā de rén?",
          "translation": "¿De qué país eres?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我来自墨西哥。",
          "reading": "Wǒ láizì Mòxīgē.",
          "translation": "Soy de México."
        },
        {
          "speaker": "工作人员",
          "speakerEs": "Empleada",
          "gender": "f",
          "text": "墨西哥！很远啊。国家写这里。",
          "reading": "Mòxīgē! Hěn yuǎn a. Guójiā xiě zhèlǐ.",
          "translation": "¡México! Qué lejos. El país, escríbelo aquí."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "好的，谢谢。",
          "reading": "Hǎo de, xièxie.",
          "translation": "Muy bien, gracias."
        }
      ],
      "notes": [
        {
          "ko": "名字",
          "es": "En chino el apellido va primero y el nombre después. Los nombres extranjeros se transcriben por sonido: 洛佩斯 = López."
        },
        {
          "ko": "哪个国家的人",
          "es": "«¿Persona de qué país?». 哪个 = cuál; 国家 = país."
        },
        {
          "ko": "对",
          "es": "Para confirmar algo, 对 (correcto) es más natural que 是."
        }
      ],
      "newItems": [
        "名字",
        "国家",
        "你叫什么名字？",
        "我来自墨西哥。"
      ]
    },
    {
      "lessonId": "chinese-a11-identity-04",
      "title": "Charla en el taxi",
      "scene": "street",
      "lines": [
        {
          "speaker": "司机",
          "speakerEs": "Taxista",
          "gender": "m",
          "text": "你好！你是哪国人？",
          "reading": "Nǐ hǎo! Nǐ shì nǎ guó rén?",
          "translation": "¡Hola! ¿De dónde eres?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我是墨西哥人。",
          "reading": "Wǒ shì Mòxīgē rén.",
          "translation": "Soy mexicana."
        },
        {
          "speaker": "司机",
          "speakerEs": "Taxista",
          "gender": "m",
          "text": "你会说中文吗？",
          "reading": "Nǐ huì shuō Zhōngwén ma?",
          "translation": "¿Hablas chino?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我会说一点汉语。",
          "reading": "Wǒ huì shuō yìdiǎn Hànyǔ.",
          "translation": "Hablo un poco de chino."
        },
        {
          "speaker": "司机",
          "speakerEs": "Taxista",
          "gender": "m",
          "text": "墨西哥人说什么语言？西班牙语吧？",
          "reading": "Mòxīgē rén shuō shénme yǔyán? Xībānyáyǔ ba?",
          "translation": "¿Qué idioma hablan en México? Español, ¿no?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "对，西班牙语。",
          "reading": "Duì, Xībānyáyǔ.",
          "translation": "Sí, español."
        },
        {
          "speaker": "司机",
          "speakerEs": "Taxista",
          "gender": "m",
          "text": "西班牙语难不难？我觉得汉语最难了！",
          "reading": "Xībānyáyǔ nán bu nán? Wǒ juéde Hànyǔ zuì nán le!",
          "translation": "¿Es difícil el español? ¡Yo creo que el chino es lo más difícil!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "对不起，我不明白。",
          "reading": "Duìbuqǐ, wǒ bù míngbai.",
          "translation": "Perdón, no entiendo."
        },
        {
          "speaker": "司机",
          "speakerEs": "Taxista",
          "gender": "m",
          "text": "哈哈，没关系！",
          "reading": "Hāha, méi guānxi!",
          "translation": "¡Jaja, no pasa nada!"
        }
      ],
      "notes": [
        {
          "ko": "汉语",
          "es": "汉语 y 中文 significan «chino»; 汉语 es más de manual, 中文 más cotidiano. 普通话 es el mandarín estándar."
        },
        {
          "ko": "一点",
          "es": "一点 delante del sustantivo = «un poco de»: 一点汉语."
        },
        {
          "ko": "我不明白",
          "es": "不明白 = no capto el sentido. 听不懂 = no entiendo lo que oigo (por velocidad o acento)."
        },
        {
          "ko": "墨西哥人",
          "es": "人 detrás del país forma el gentilicio, igual para hombre o mujer."
        }
      ],
      "newItems": [
        "语言",
        "人",
        "我会说一点汉语。",
        "我不明白。"
      ]
    }
  ]
}
