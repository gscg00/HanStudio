{
  "unitId": "a1-1-home",
  "stories": [
    {
      "lessonId": "chinese-a11-home-01",
      "title": "Mi nuevo departamento",
      "scene": "home",
      "lines": [
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "安娜，这是你的家。请进！",
          "reading": "Ānnà, zhè shì nǐ de jiā. Qǐng jìn!",
          "translation": "Ana, ésta es tu casa. ¡Pasa!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "谢谢！我的房间在哪里？",
          "reading": "Xièxie! Wǒ de fángjiān zài nǎlǐ?",
          "translation": "¡Gracias! ¿Dónde está mi cuarto?"
        },
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "在这里。",
          "reading": "Zài zhèlǐ.",
          "translation": "Aquí está."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "哇，很好！洗手间在哪里？",
          "reading": "Wa, hěn hǎo! Xǐshǒujiān zài nǎlǐ?",
          "translation": "¡Qué bonito! ¿Y el baño?"
        },
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "洗手间在那里。",
          "reading": "Xǐshǒujiān zài nàlǐ.",
          "translation": "El baño está allí."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨，Wi-Fi密码在哪里？",
          "reading": "Āyí, Wi-Fi mìmǎ zài nǎlǐ?",
          "translation": "Señora, ¿dónde está la contraseña del wifi?"
        },
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "在这里，你看！",
          "reading": "Zài zhèlǐ, nǐ kàn!",
          "translation": "Aquí, ¡mira!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "太好了！谢谢阿姨！",
          "reading": "Tài hǎo le! Xièxie āyí!",
          "translation": "¡Perfecto! ¡Gracias, señora!"
        }
      ],
      "notes": [
        {
          "ko": "在哪里",
          "es": "在 aquí es un verbo: «estar (en un lugar)». X在哪里？ = ¿dónde está X?"
        },
        {
          "ko": "在这里",
          "es": "Se puede omitir el sujeto si ya se sabe de qué se habla: 在这里 = (está) aquí."
        },
        {
          "ko": "阿姨",
          "es": "A la casera (房东, la persona que renta el departamento) se le suele llamar 阿姨 si es una señora mayor."
        },
        {
          "ko": "家",
          "es": "家 es a la vez «casa» y «hogar, familia»."
        }
      ],
      "newItems": [
        "家",
        "房间",
        "在这里。",
        "在哪里？"
      ]
    },
    {
      "lessonId": "chinese-a11-home-02",
      "title": "¿Dónde está el celular?",
      "scene": "home",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，我的手机在哪里？",
          "reading": "Ānnà, wǒ de shǒujī zài nǎlǐ?",
          "translation": "Ana, ¿dónde está mi celular?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "在厨房吗？",
          "reading": "Zài chúfáng ma?",
          "translation": "¿En la cocina?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "不在这里。",
          "reading": "Bú zài zhèlǐ.",
          "translation": "Aquí no está."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "在洗手间吗？",
          "reading": "Zài xǐshǒujiān ma?",
          "translation": "¿En el baño?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "也不在这里……",
          "reading": "Yě bú zài zhèlǐ…",
          "translation": "Aquí tampoco…"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "啊，这个手机呢？",
          "reading": "À, zhège shǒujī ne?",
          "translation": "Ah, ¿y este celular?"
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "对！是我的。谢谢！",
          "reading": "Duì! Shì wǒ de. Xièxie!",
          "translation": "¡Sí! Es mío. ¡Gracias!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "那……我的手机在哪里？",
          "reading": "Nà… wǒ de shǒujī zài nǎlǐ?",
          "translation": "Entonces… ¿dónde está el mío?"
        }
      ],
      "notes": [
        {
          "ko": "不在这里",
          "es": "在 se niega con 不: 不在 = no está. 不 cambia a bú delante del cuarto tono de 在."
        },
        {
          "ko": "也不",
          "es": "也 (también) va siempre delante del verbo; con negación: 也不在 = tampoco está."
        },
        {
          "ko": "是我的",
          "es": "的 puede sustituir al sustantivo: 我的 = el mío / la mía."
        }
      ],
      "newItems": [
        "厨房",
        "洗手间",
        "是我的。",
        "不在这里。"
      ]
    },
    {
      "lessonId": "chinese-a11-home-03",
      "title": "Las llaves perdidas",
      "scene": "bedroom",
      "lines": [
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "安娜，你的房间怎么样？",
          "reading": "Ānnà, nǐ de fángjiān zěnmeyàng?",
          "translation": "Ana, ¿qué tal tu cuarto?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我的房间很小，可是很好。",
          "reading": "Wǒ de fángjiān hěn xiǎo, kěshì hěn hǎo.",
          "translation": "Mi cuarto es pequeño, pero está bien."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "有桌子吗？",
          "reading": "Yǒu zhuōzi ma?",
          "translation": "¿Tiene mesa?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "有桌子，也有椅子。",
          "reading": "Yǒu zhuōzi, yě yǒu yǐzi.",
          "translation": "Tiene mesa y también silla."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "我们走吧！你的钥匙呢？",
          "reading": "Wǒmen zǒu ba! Nǐ de yàoshi ne?",
          "translation": "¡Vámonos! ¿Y tus llaves?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "嗯……我不知道。",
          "reading": "Ńg… wǒ bù zhīdào.",
          "translation": "Mmm… no sé."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "你看，钥匙在桌子上。",
          "reading": "Nǐ kàn, yàoshi zài zhuōzi shang.",
          "translation": "Mira, la llave está sobre la mesa."
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "啊，对！谢谢！",
          "reading": "À, duì! Xièxie!",
          "translation": "¡Ah, es cierto! ¡Gracias!"
        }
      ],
      "notes": [
        {
          "ko": "很小",
          "es": "Adjetivo sin 是: 我的房间很小. Decir 我的房间是小 sería incorrecto."
        },
        {
          "ko": "桌子上",
          "es": "上 detrás del sustantivo = «encima de»: 桌子上 = sobre la mesa."
        },
        {
          "ko": "有",
          "es": "有 = hay / tener. Sin sujeto, 有桌子吗？ = ¿hay mesa?"
        },
        {
          "ko": "怎么样",
          "es": "«¿Qué tal?». Sirve para pedir una opinión sobre cualquier cosa."
        }
      ],
      "newItems": [
        "桌子",
        "椅子",
        "钥匙在桌子上。",
        "我的房间很小。"
      ]
    },
    {
      "lessonId": "chinese-a11-home-04",
      "title": "La puerta abierta",
      "scene": "home",
      "lines": [
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "小明，你看！门开着。",
          "reading": "Xiǎomíng, nǐ kàn! Mén kāizhe.",
          "translation": "¡Xiaoming, mira! La puerta está abierta."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "什么？你没关门吗？",
          "reading": "Shénme? Nǐ méi guān mén ma?",
          "translation": "¿Qué? ¿No cerraste la puerta?"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "我关了！钥匙在这里。",
          "reading": "Wǒ guān le! Yàoshi zài zhèlǐ.",
          "translation": "¡Sí la cerré! La llave la tengo aquí."
        },
        {
          "speaker": "小明",
          "speakerEs": "Xiaoming",
          "gender": "m",
          "text": "我们进去看看。",
          "reading": "Wǒmen jìnqu kànkan.",
          "translation": "Entremos a ver."
        },
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "安娜，你回来了！",
          "reading": "Ānnà, nǐ huílai le!",
          "translation": "¡Ana, ya volviste!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "阿姨！您在这里？",
          "reading": "Āyí! Nín zài zhèlǐ?",
          "translation": "¡Señora! ¿Usted aquí?"
        },
        {
          "speaker": "房东",
          "speakerEs": "Casera",
          "gender": "f",
          "text": "你的房间只有一把椅子。现在有两把椅子了！",
          "reading": "Nǐ de fángjiān zhǐ yǒu yì bǎ yǐzi. Xiànzài yǒu liǎng bǎ yǐzi le!",
          "translation": "Tu cuarto sólo tenía una silla. ¡Ahora hay dos sillas!"
        },
        {
          "speaker": "安娜",
          "speakerEs": "Ana",
          "gender": "f",
          "text": "啊，谢谢阿姨！",
          "reading": "À, xièxie āyí!",
          "translation": "¡Ay, gracias, señora!"
        }
      ],
      "notes": [
        {
          "ko": "门开着",
          "es": "着 (zhe) indica un estado que dura: 开着 = está abierta (y sigue así)."
        },
        {
          "ko": "两把椅子",
          "es": "把 es el clasificador de objetos que se agarran por un mango o respaldo: sillas, llaves, paraguas."
        },
        {
          "ko": "您",
          "es": "Forma respetuosa de 你. Ana la usa con la casera, que es mayor que ella."
        },
        {
          "ko": "有两把椅子了",
          "es": "了 al final marca un cambio: antes había una, ahora ya hay dos."
        }
      ],
      "newItems": [
        "门",
        "钥匙",
        "有两把椅子。",
        "门开着。"
      ]
    }
  ]
}
